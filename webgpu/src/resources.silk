pub struct ComputePassEncoder<'a> { handle: sys.WGPUComputePassEncoder, lease: HandleLease }

impl<'a> ComputePassEncoder<'a> {
  // `handle` must own one live reference from this encoder.
  pub unsafe fn adopt(handle: sys.WGPUComputePassEncoder, encoder: &'a mut CommandEncoder) -> Self { return Self { handle: handle, lease: HandleLease.untracked() } }
  // Transfers one native reference and records it in this device's observer.
  pub unsafe fn adoptTracked(handle: sys.WGPUComputePassEncoder, encoder: &'a mut CommandEncoder, observer: &Diagnostics) -> Self {
    return Self { handle: handle, lease: HandleLease.track(observer) }
  }
  // The caller must not release this borrowed handle or outlive its owner.
  pub unsafe fn raw(self: &Self) -> sys.WGPUComputePassEncoder { return self.handle }
  pub fn dup(self: &Self) -> Self {
    unsafe sys.wgpuComputePassEncoderAddRef(self.handle)
    return Self { handle: self.handle, lease: self.lease.dup() }
  }
  pub fn insertDebugMarker(self: &mut Self, markerLabel: &[u8]) -> () {
    unsafe sys.wgpuComputePassEncoderInsertDebugMarker(self.handle, desc.stringView(markerLabel))
  }
  pub fn popDebugGroup(self: &mut Self) -> () {
    unsafe sys.wgpuComputePassEncoderPopDebugGroup(self.handle)
  }
  pub fn pushDebugGroup(self: &mut Self, groupLabel: &[u8]) -> () {
    unsafe sys.wgpuComputePassEncoderPushDebugGroup(self.handle, desc.stringView(groupLabel))
  }
  pub fn setPipeline(self: &mut Self, pipeline: &ComputePipeline) -> () {
    unsafe sys.wgpuComputePassEncoderSetPipeline(self.handle, pipeline.handle)
  }
  pub fn setBindGroup(self: &mut Self, groupIndex: u32, group: &BindGroup, dynamicOffsets: &[u32]) -> () {
    unsafe sys.wgpuComputePassEncoderSetBindGroup(self.handle, groupIndex, group.handle, dynamicOffsets.length, Pointer.fromSlice<u32>(dynamicOffsets))
  }
  pub fn setImmediates(self: &mut Self, offset: u32, data: &[u8]) -> () {
    unsafe sys.wgpuComputePassEncoderSetImmediates(self.handle, offset, Pointer.fromSlice<u8>(data), data.length)
  }
  pub fn dispatchWorkgroups(self: &mut Self, workgroupCountX: u32, workgroupCountY: u32, workgroupCountZ: u32) -> () {
    unsafe sys.wgpuComputePassEncoderDispatchWorkgroups(self.handle, workgroupCountX, workgroupCountY, workgroupCountZ)
  }
  pub fn dispatchWorkgroupsIndirect(self: &mut Self, indirectBuffer: &Buffer, indirectOffset: u64) -> () {
    unsafe sys.wgpuComputePassEncoderDispatchWorkgroupsIndirect(self.handle, indirectBuffer.handle, indirectOffset)
  }
  pub fn end(self: Self) -> () {
    unsafe sys.wgpuComputePassEncoderEnd(self.handle)
  }
  pub fn setLabel(self: &mut Self, label: &[u8]) -> () {
    unsafe sys.wgpuComputePassEncoderSetLabel(self.handle, desc.stringView(label))
  }
  pub fn clearBindGroup(self: &mut Self, groupIndex: u32) -> () {
    unsafe sys.wgpuComputePassEncoderSetBindGroup(self.handle, groupIndex, Pointer.null<u8>(), 0, unsafe Intrinsic.pointerRequalify<?*mut u32, ?[*]const u32>(Pointer.null<u32>()))
  }
}
impl<'a> Drop for ComputePassEncoder<'a> {
  fn drop(self: &mut Self) -> () { unsafe sys.wgpuComputePassEncoderRelease(self.handle) }
}

