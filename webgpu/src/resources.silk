pub struct CommandEncoder { handle: sys.WGPUCommandEncoder, lease: HandleLease }

impl CommandEncoder {
  // `handle` must be non-null and transfer one owned native reference.
  pub unsafe fn adopt(handle: sys.WGPUCommandEncoder) -> Self { return Self { handle: handle, lease: HandleLease.untracked() } }
  // Transfers one native reference and records it in this device's observer.
  pub unsafe fn adoptTracked(handle: sys.WGPUCommandEncoder, observer: &Diagnostics) -> Self {
    return Self { handle: handle, lease: HandleLease.track(observer) }
  }
  // The caller must not release this borrowed handle or outlive its owner.
  pub unsafe fn raw(self: &Self) -> sys.WGPUCommandEncoder { return self.handle }
  pub fn dup(self: &Self) -> Self {
    unsafe sys.wgpuCommandEncoderAddRef(self.handle)
    return Self { handle: self.handle, lease: self.lease.dup() }
  }
  pub fn reference<'b>(self: &'b Self) -> CommandEncoderRef<'b> { return CommandEncoderRef<'b> { handle: self.handle } }
  pub effect fn beginComputePass<'encoder>(self: &'encoder mut Self, descriptor: &desc.ComputePassDescriptor) -> ComputePassEncoder<'encoder> ! GpuError {
    let handle = unsafe sys.wgpuCommandEncoderBeginComputePass(self.handle, unsafe descriptor.rawPointer())
    if Pointer.isNull(handle) { fail GpuError.status(sys.WGPUStatus_Error) }
    return ComputePassEncoder<'encoder> { handle: handle, lease: self.lease.dup() }
  }
  pub effect fn beginRenderPass<'encoder>(self: &'encoder mut Self, descriptor: &desc.RenderPassDescriptor) -> RenderPassEncoder<'encoder> ! GpuError {
    let handle = unsafe sys.wgpuCommandEncoderBeginRenderPass(self.handle, unsafe descriptor.rawPointer())
    if Pointer.isNull(handle) { fail GpuError.status(sys.WGPUStatus_Error) }
    return RenderPassEncoder<'encoder> { handle: handle, lease: self.lease.dup() }
  }
  pub fn copyBufferToBuffer(self: &mut Self, source: &Buffer, sourceOffset: u64, destination: &Buffer, destinationOffset: u64, size: u64) -> () {
    unsafe sys.wgpuCommandEncoderCopyBufferToBuffer(self.handle, source.handle, sourceOffset, destination.handle, destinationOffset, size)
  }
  pub fn copyBufferToTexture(self: &mut Self, source: &desc.TexelCopyBufferInfo, destination: &desc.TexelCopyTextureInfo, copySize: &desc.Extent3D) -> () {
    unsafe sys.wgpuCommandEncoderCopyBufferToTexture(self.handle, unsafe source.rawPointer(), unsafe destination.rawPointer(), unsafe copySize.rawPointer())
  }
  pub fn copyTextureToBuffer(self: &mut Self, source: &desc.TexelCopyTextureInfo, destination: &desc.TexelCopyBufferInfo, copySize: &desc.Extent3D) -> () {
    unsafe sys.wgpuCommandEncoderCopyTextureToBuffer(self.handle, unsafe source.rawPointer(), unsafe destination.rawPointer(), unsafe copySize.rawPointer())
  }
  pub fn copyTextureToTexture(self: &mut Self, source: &desc.TexelCopyTextureInfo, destination: &desc.TexelCopyTextureInfo, copySize: &desc.Extent3D) -> () {
    unsafe sys.wgpuCommandEncoderCopyTextureToTexture(self.handle, unsafe source.rawPointer(), unsafe destination.rawPointer(), unsafe copySize.rawPointer())
  }
  pub fn clearBuffer(self: &mut Self, buffer: &Buffer, offset: u64, size: u64) -> () {
    unsafe sys.wgpuCommandEncoderClearBuffer(self.handle, buffer.handle, offset, size)
  }
  pub fn insertDebugMarker(self: &mut Self, markerLabel: &[u8]) -> () {
    unsafe sys.wgpuCommandEncoderInsertDebugMarker(self.handle, desc.stringView(markerLabel))
  }
  pub fn popDebugGroup(self: &mut Self) -> () {
    unsafe sys.wgpuCommandEncoderPopDebugGroup(self.handle)
  }
  pub fn pushDebugGroup(self: &mut Self, groupLabel: &[u8]) -> () {
    unsafe sys.wgpuCommandEncoderPushDebugGroup(self.handle, desc.stringView(groupLabel))
  }
  pub fn resolveQuerySet(self: &mut Self, querySet: &QuerySet, firstQuery: u32, queryCount: u32, destination: &Buffer, destinationOffset: u64) -> () {
    unsafe sys.wgpuCommandEncoderResolveQuerySet(self.handle, querySet.handle, firstQuery, queryCount, destination.handle, destinationOffset)
  }
  pub fn writeTimestamp(self: &mut Self, querySet: &QuerySet, queryIndex: u32) -> () {
    unsafe sys.wgpuCommandEncoderWriteTimestamp(self.handle, querySet.handle, queryIndex)
  }
  pub fn setLabel(self: &mut Self, label: &[u8]) -> () {
    unsafe sys.wgpuCommandEncoderSetLabel(self.handle, desc.stringView(label))
  }
  pub effect fn finish(self: Self, label: &[u8]) -> CommandBuffer ! GpuError {
    let mut descriptor = WGPUCommandBufferDescriptor.default()
    descriptor.label = desc.stringView(label)
    let handle = unsafe sys.wgpuCommandEncoderFinish(self.handle, Pointer.fromRef(&descriptor))
    if Pointer.isNull(handle) { fail GpuError.status(sys.WGPUStatus_Error) }
    return CommandBuffer { handle: handle, lease: self.lease.dup() }
  }
}
impl Drop for CommandEncoder {
  fn drop(self: &mut Self) -> () { unsafe sys.wgpuCommandEncoderRelease(self.handle) }
}

