pub struct Buffer { handle: sys.WGPUBuffer, lease: HandleLease }

impl Buffer {
  // `handle` must be non-null and transfer one owned native reference.
  pub unsafe fn adopt(handle: sys.WGPUBuffer) -> Self { return Self { handle: handle, lease: HandleLease.untracked() } }
  // Transfers one native reference and records it in this device's observer.
  pub unsafe fn adoptTracked(handle: sys.WGPUBuffer, observer: &Diagnostics) -> Self {
    return Self { handle: handle, lease: HandleLease.track(observer) }
  }
  // The caller must not release this borrowed handle or outlive its owner.
  pub unsafe fn raw(self: &Self) -> sys.WGPUBuffer { return self.handle }
  pub fn dup(self: &Self) -> Self {
    unsafe sys.wgpuBufferAddRef(self.handle)
    return Self { handle: self.handle, lease: self.lease.dup() }
  }
  pub fn reference<'b>(self: &'b Self) -> BufferRef<'b> { return BufferRef<'b> { handle: self.handle } }
  pub effect fn readMapped(self: &Self, offset: usize, data: &mut [u8]) -> () ! GpuError {
    let status = unsafe sys.wgpuBufferReadMappedRange(self.handle, offset, Pointer.fromMutSlice<u8>(&mut data), data.length)
    if status != sys.WGPUStatus_Success { fail GpuError.status(status) }
  }
  pub effect fn writeMapped(self: &Self, offset: usize, data: &[u8]) -> () ! GpuError {
    let status = unsafe sys.wgpuBufferWriteMappedRange(self.handle, offset, Pointer.fromSlice<u8>(data), data.length)
    if status != sys.WGPUStatus_Success { fail GpuError.status(status) }
  }
  pub fn setLabel(self: &Self, label: &[u8]) -> () {
    unsafe sys.wgpuBufferSetLabel(self.handle, desc.stringView(label))
  }
  pub fn getUsage(self: &Self) -> sys.WGPUBufferUsage {
    return unsafe sys.wgpuBufferGetUsage(self.handle)
  }
  pub fn getSize(self: &Self) -> u64 {
    return unsafe sys.wgpuBufferGetSize(self.handle)
  }
  pub fn getMapState(self: &Self) -> sys.WGPUBufferMapState {
    return unsafe sys.wgpuBufferGetMapState(self.handle)
  }
  pub fn unmap(self: &Self) -> () {
    unsafe sys.wgpuBufferUnmap(self.handle)
  }
  pub fn destroy(self: &Self) -> () {
    unsafe sys.wgpuBufferDestroy(self.handle)
  }
}
impl Drop for Buffer {
  fn drop(self: &mut Self) -> () { unsafe sys.wgpuBufferRelease(self.handle) }
}

