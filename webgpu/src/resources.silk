//! Owned WebGPU resources and allocation-free recording operations.
//! Each handle owns one native reference. `dup` acquires another; Drop releases
//! exactly one. Pass lifetimes are tied to an exclusive borrow of their encoder.
//! Mapping only copies through WebGPU's checked range-copy operations: no view
//! into mapped storage escapes, including when another Buffer handle is duplicated.
//! Debug leases count owned wrapper references, including derived handles and dup.
//! Native Drop runs before field cleanup releases the associated diagnostic lease.
import webgpu_sys.generated_webgpu as sys
import descriptors as desc
import runtime { Device, GpuError }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy, Drop }
import webgpu_sys.generated_webgpu { WGPUCommandBufferDescriptor, WGPUCommandEncoderDescriptor, WGPURenderBundleDescriptor, WGPUShaderModuleDescriptor, WGPUShaderSourceWGSL }
import webgpu_sys.generated_webgpu { WGPUShaderSourceSPIRV }
import silk.num.usize
import diagnostics { Diagnostics, HandleLease }

static if Intrinsic.targetArchitecture() != "wasm32" {
  unsafe extern "C" fn createShaderModuleStrictNative(
    device: sys.WGPUDevice,
    descriptor: *const sys.WGPUShaderModuleDescriptor,
  ) -> sys.WGPUShaderModule as "silkWebgpuCreateShaderModuleStrict"
}

/// Dawn's native device feature for per-module compilation options; request it explicitly
/// through `DeviceDescriptor.withRequiredFeatures` before using [`createShaderModuleStrict`].
pub const SHADER_MODULE_COMPILATION_OPTIONS: u32 = 0x0005002e

/// Strict shader math was requested on the web or without its enabled native device feature.
pub const STRICT_MATH_UNAVAILABLE: u32 = 0xfffffffb

pub struct BindGroup {
  handle: sys.WGPUBindGroup,
  lease: HandleLease
}

impl BindGroup {
  // `handle` must be non-null and transfer one owned native reference.
  pub unsafe fn adopt(handle: sys.WGPUBindGroup) -> Self { return Self { handle: handle, lease: HandleLease.untracked() } }
  // Transfers one native reference and records it in this device's observer.
  pub unsafe fn adoptTracked(handle: sys.WGPUBindGroup, observer: &Diagnostics) -> Self {
    return Self { handle: handle, lease: HandleLease.track(observer) }
  }
  // The caller must not release this borrowed handle or outlive its owner.
  pub unsafe fn raw(self: &Self) -> sys.WGPUBindGroup { return self.handle }
  pub fn dup(self: &Self) -> Self {
    unsafe sys.wgpuBindGroupAddRef(self.handle)
    return Self { handle: self.handle, lease: self.lease.dup() }
  }
  pub fn reference<'b>(self: &'b Self) -> BindGroupRef<'b> { return BindGroupRef<'b> { handle: self.handle } }
  pub fn setLabel(self: &Self, label: &[u8]) -> () {
    unsafe sys.wgpuBindGroupSetLabel(self.handle, desc.stringView(label))
  }
}
impl Drop for BindGroup {
  fn drop(self: &mut Self) -> () { unsafe sys.wgpuBindGroupRelease(self.handle) }
}

// Borrowed one-word array entry, layout-compatible with the C handle.
pub struct BindGroupRef<'a> { handle: sys.WGPUBindGroup }
impl<'a> Copy for BindGroupRef<'a> {}

