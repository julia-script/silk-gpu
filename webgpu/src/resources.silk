pub struct RenderBundle { handle: sys.WGPURenderBundle, lease: HandleLease }

impl RenderBundle {
  // `handle` must be non-null and transfer one owned native reference.
  pub unsafe fn adopt(handle: sys.WGPURenderBundle) -> Self { return Self { handle: handle, lease: HandleLease.untracked() } }
