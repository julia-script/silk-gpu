  return unsafe CommandEncoder.adoptTracked(handle, &observer)
}

pub effect fn createShaderModule(device: &Device, label: &[u8], code: &[u8]) -> ShaderModule ! GpuError {
  let mut source = WGPUShaderSourceWGSL.default()
  source.code = desc.stringView(code)
  let mut descriptor = WGPUShaderModuleDescriptor.default()
  descriptor.label = desc.stringView(label)
  descriptor.nextInChain = Pointer.fromMutRef(&mut source.chain)
  let handle = unsafe sys.wgpuDeviceCreateShaderModule(unsafe device.raw(), Pointer.fromRef(&descriptor))
  if Pointer.isNull(handle) { fail GpuError.status(sys.WGPUStatus_Error) }
  let observer = device.diagnostics()
  return unsafe ShaderModule.adoptTracked(handle, &observer)
}

/// Creates a native Dawn WGSL module with strict floating-point math. Ordinary shader creation
/// is unchanged. Fails with [`STRICT_MATH_UNAVAILABLE`] on the web or when the device was not
/// created with [`SHADER_MODULE_COMPILATION_OPTIONS`]; never silently uses relaxed arithmetic.
pub effect fn createShaderModuleStrict(device: &Device, label: &[u8], code: &[u8]) -> ShaderModule
  ! GpuError {
  static if Intrinsic.targetArchitecture() == "wasm32" {
    fail GpuError.status(STRICT_MATH_UNAVAILABLE)
  } else {
    if !device.hasFeature(SHADER_MODULE_COMPILATION_OPTIONS) {
      fail GpuError.status(STRICT_MATH_UNAVAILABLE)
    }
    let mut source = WGPUShaderSourceWGSL.default()
    source.code = desc.stringView(code)
    let mut descriptor = WGPUShaderModuleDescriptor.default()
    descriptor.label = desc.stringView(label)
    descriptor.nextInChain = Pointer.fromMutRef(&mut source.chain)
    let handle = unsafe createShaderModuleStrictNative(
      unsafe device.raw(),
      Pointer.fromRef(&descriptor),
    )
    if Pointer.isNull(handle) {
      fail GpuError.status(sys.WGPUStatus_Error)
    }
    let observer = device.diagnostics()
    return unsafe ShaderModule.adoptTracked(handle, &observer)
  }
}

pub effect fn createShaderModuleFromDescriptor(
  device: &Device,
  descriptor: &desc.ShaderModuleDescriptor,
) -> ShaderModule
  ! GpuError {
  let handle = unsafe sys.wgpuDeviceCreateShaderModule(
    unsafe device.raw(),
    unsafe descriptor.rawPointer(),
  )
  if Pointer.isNull(handle) {
    fail GpuError.status(sys.WGPUStatus_Error)
  }
  let observer = device.diagnostics()
  return unsafe ShaderModule.adoptTracked(handle, &observer)
}

pub effect fn createShaderModuleSpirV(device: &Device, label: &[u8], code: &[u32]) -> ShaderModule ! GpuError {
  if code.length > 4294967295 { fail GpuError.status(sys.WGPUStatus_Error) }
  let mut source = WGPUShaderSourceSPIRV.default()
  source.codeSize = usize.toU32(code.length)
  source.code = unsafe Intrinsic.pointerRequalify<?[*]const u32, ?*const u32>(Pointer.fromSlice<u32>(code))
  let mut descriptor = WGPUShaderModuleDescriptor.default()
  descriptor.label = desc.stringView(label)
  descriptor.nextInChain = Pointer.fromMutRef(&mut source.chain)
  let handle = unsafe sys.wgpuDeviceCreateShaderModule(unsafe device.raw(), Pointer.fromRef(&descriptor))
  if Pointer.isNull(handle) { fail GpuError.status(sys.WGPUStatus_Error) }
  let observer = device.diagnostics()
  return unsafe ShaderModule.adoptTracked(handle, &observer)
}
