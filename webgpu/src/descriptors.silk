  WGPUBlendComponent,
  WGPUBlendState,
  WGPUBufferBindingLayout,
  WGPUBufferDescriptor,
  WGPUColor,
  WGPUColorTargetState,
  WGPUCommandBufferDescriptor,
  WGPUCommandEncoderDescriptor,
  WGPUCompatibilityModeLimits,
  WGPUComputePassDescriptor,
  WGPUComputePipelineDescriptor,
  WGPUComputeState,
  WGPUConstantEntry,
  WGPUDepthStencilState,
  WGPUDeviceDescriptor,
  WGPUExtent3D,
  WGPUExternalTextureBindingEntry,
  WGPUExternalTextureBindingLayout,
  WGPUFragmentState,
  WGPULimits,
  WGPUMultisampleState,
  WGPUOrigin3D,
  WGPUPassTimestampWrites,
  WGPUPipelineLayoutDescriptor,
  WGPUPrimitiveState,
  WGPUQuerySetDescriptor,
  WGPUQueueDescriptor,
  WGPURenderBundleDescriptor,
  WGPURenderBundleEncoderDescriptor,
  WGPURenderPassColorAttachment,
  WGPURenderPassDepthStencilAttachment,
  WGPURenderPassDescriptor,
  WGPURenderPassMaxDrawCount,
  WGPURenderPipelineDescriptor,
  WGPUSamplerBindingLayout,
  WGPUSamplerDescriptor,
  WGPUShaderModuleDescriptor,
  WGPUShaderSourceWGSL,
  WGPUStencilFaceState,
  WGPUStorageTextureBindingLayout,
  WGPUTexelCopyBufferInfo,
  WGPUTexelCopyBufferLayout,
  WGPUTexelCopyTextureInfo,
  WGPUTextureBindingLayout,
  WGPUTextureBindingViewDimension,
  WGPUTextureComponentSwizzle,
  WGPUTextureComponentSwizzleDescriptor,
  WGPUTextureDescriptor,
  WGPUTextureViewDescriptor,
  WGPUVertexAttribute,
  WGPUVertexBufferLayout,
  WGPUVertexState,
}
import silk.mem.layout { Layout }

const EMPTY_FEATURES: [u32; 0] = []

// LIMITATION-2: dev.27 rejects lifetime parameters on extern C records (SEM0205).
// Every caller supplies a wrapper with exactly one stored U field. Equal byte
// size proves that field starts at offset zero (otherwise it would not fit),
// and equal alignment and stride prove that a wrapper slice is a C U array.
// These are compiler-layout invariants, not restrictions on caller input.
// The caller must additionally retain all pointer targets for the native call.
pub unsafe fn rawEntries<T, U>(values: &[T]) -> ?[*]const U {
  let wrapper = Layout.of<T>()
  let raw = Layout.of<U>()
  if wrapper.bytes != raw.bytes || wrapper.alignment != raw.alignment {
    Intrinsic.trap("WebGPU single-field descriptor layout changed")
  }
  return unsafe Intrinsic.pointerReinterpret<?[*]const T, ?[*]const U>(Pointer.fromSlice<T>(values))
}

pub fn stringView(bytes: &[u8]) -> sys.WGPUStringView {
  return sys.WGPUStringView { data: Pointer.fromSlice<u8>(bytes), length: bytes.length }
}

pub struct BindGroupDescriptor<'a> { value: sys.WGPUBindGroupDescriptor }
impl<'a> Copy for BindGroupDescriptor<'a> {}

impl<'a> BindGroupDescriptor<'a> {
  pub fn default() -> Self { return Self { value: WGPUBindGroupDescriptor.default() } }
  // The caller must keep all borrows alive while using the returned C record.
  pub unsafe fn raw(self: &Self) -> sys.WGPUBindGroupDescriptor { return self.value }
  pub unsafe fn rawPointer(self: &Self) -> *const sys.WGPUBindGroupDescriptor { return Pointer.fromRef(&self.value) }
  pub fn withLabel(self: Self, value: &'a [u8]) -> Self {
    let mut result = self
    result.value.label = stringView(value)
    return result
  }
  pub fn withLayout(self: Self, value: &'a resource.BindGroupLayout) -> Self {
    let mut result = self
    result.value.layout = unsafe value.raw()
    return result
  }
  pub fn withEntries<'entry>(self: Self, value: &'a [BindGroupEntry<'entry>]) -> Self {
    let mut result = self
    result.value.entries = unsafe rawEntries<BindGroupEntry<'entry>, sys.WGPUBindGroupEntry>(value)
    result.value.entryCount = value.length
    return result
  }
}

