//! Borrowed WebGPU descriptors with checked zero-copy array conversion.
//! Private raw fields and lifetime-bound builders keep labels, entry slices and resource
//! references live until the descriptor's last use. Entry arrays are passed directly,
//! without heap allocation, fixed implementation limits, or variable stack allocation.
//! Borrowing fields use consuming withX builders so a default's static lifetime
//! can safely shorten to the intersection of all resources already borrowed.
//! Nested entry lifetimes are independent of their outer slice/reference borrow;
//! the reference contract proves entries outlive the descriptor without forcing
//! a local array to inherit a longer resource lifetime.
import webgpu_sys.generated_webgpu as sys
import resources as resource
import silk.mem.pointer { Pointer }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import webgpu_sys.generated_webgpu {
  WGPUBindGroupDescriptor,
  WGPUBindGroupEntry,
  WGPUBindGroupLayoutDescriptor,
