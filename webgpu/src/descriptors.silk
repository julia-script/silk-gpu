    self.value.format = value
  }
  pub fn format(self: &Self) -> sys.WGPUVertexFormat { return self.value.format }
  pub fn setOffset(self: &mut Self, value: u64) -> () {
    self.value.offset = value
  }
  pub fn offset(self: &Self) -> u64 { return self.value.offset }
  pub fn setShaderLocation(self: &mut Self, value: u32) -> () {
    self.value.shaderLocation = value
  }
  pub fn shaderLocation(self: &Self) -> u32 { return self.value.shaderLocation }
}

pub struct VertexBufferLayout<'a> { value: sys.WGPUVertexBufferLayout }
impl<'a> Copy for VertexBufferLayout<'a> {}

impl<'a> VertexBufferLayout<'a> {
  pub fn default() -> Self { return Self { value: WGPUVertexBufferLayout.default() } }
  // The caller must keep all borrows alive while using the returned C record.
  pub unsafe fn raw(self: &Self) -> sys.WGPUVertexBufferLayout { return self.value }
  pub unsafe fn rawPointer(self: &Self) -> *const sys.WGPUVertexBufferLayout { return Pointer.fromRef(&self.value) }
  pub fn setStepMode(self: &mut Self, value: sys.WGPUVertexStepMode) -> () {
    self.value.stepMode = value
  }
  pub fn stepMode(self: &Self) -> sys.WGPUVertexStepMode { return self.value.stepMode }
  pub fn setArrayStride(self: &mut Self, value: u64) -> () {
    self.value.arrayStride = value
  }
  pub fn arrayStride(self: &Self) -> u64 { return self.value.arrayStride }
  pub fn withAttributes(self: Self, value: &'a [VertexAttribute]) -> Self {
    let mut result = self
    result.value.attributes = unsafe rawEntries<VertexAttribute, sys.WGPUVertexAttribute>(value)
    result.value.attributeCount = value.length
    return result
  }
}

pub struct VertexState<'a> { value: sys.WGPUVertexState }
impl<'a> Copy for VertexState<'a> {}

impl<'a> VertexState<'a> {
  pub fn default() -> Self { return Self { value: WGPUVertexState.default() } }
  // The caller must keep all borrows alive while using the returned C record.
  pub unsafe fn raw(self: &Self) -> sys.WGPUVertexState { return self.value }
  pub unsafe fn rawPointer(self: &Self) -> *const sys.WGPUVertexState { return Pointer.fromRef(&self.value) }
  pub fn withModule(self: Self, value: &'a resource.ShaderModule) -> Self {
    let mut result = self
    result.value.module = unsafe value.raw()
    return result
  }
  pub fn withEntryPoint(self: Self, value: &'a [u8]) -> Self {
    let mut result = self
    result.value.entryPoint = stringView(value)
    return result
  }
  pub fn withConstants<'entry>(self: Self, value: &'a [ConstantEntry<'entry>]) -> Self {
    let mut result = self
    result.value.constants = unsafe rawEntries<ConstantEntry<'entry>, sys.WGPUConstantEntry>(value)
    result.value.constantCount = value.length
    return result
  }
  pub fn withBuffers<'entry>(self: Self, value: &'a [VertexBufferLayout<'entry>]) -> Self {
    let mut result = self
    result.value.buffers = unsafe rawEntries<VertexBufferLayout<'entry>, sys.WGPUVertexBufferLayout>(value)
    result.value.bufferCount = value.length
    return result
  }
}

impl<'a> BufferDescriptor<'a> {
  pub fn make(label: &'a [u8], size: u64, usage: sys.WGPUBufferUsage, mappedAtCreation: bool) -> Self {
    let mut descriptor = BufferDescriptor<'a>.default().withLabel(label)
    descriptor.setSize(size)
    descriptor.setUsage(usage)
    descriptor.setMappedAtCreation(mappedAtCreation)
    return descriptor
  }
}

// Runtime supplies callback infos; this descriptor never accepts raw callbacks.
pub struct DeviceDescriptor<'a> {
  pub label: &'a [u8],
  pub requiredFeatures: &'a [sys.WGPUFeatureName],
  pub requiredLimits: Option<&'a Limits<'a>>,
  pub defaultQueue: QueueDescriptor<'a>,
}
impl<'a> Copy for DeviceDescriptor<'a> {}
impl<'a> DeviceDescriptor<'a> {
  pub fn default() -> Self {
    return Self { label: b"", requiredFeatures: &EMPTY_FEATURES, requiredLimits: Option<&'a Limits<'a>>.none(), defaultQueue: QueueDescriptor.default() }
  }
  pub unsafe fn raw(self: &Self, lost: sys.WGPUDeviceLostCallbackInfo, error: sys.WGPUUncapturedErrorCallbackInfo) -> sys.WGPUDeviceDescriptor {
    let mut result = WGPUDeviceDescriptor.default(lost, error)
    result.label = stringView(self.label)
    result.requiredFeatureCount = self.requiredFeatures.length
    result.requiredFeatures = Pointer.fromSlice(self.requiredFeatures)
    result.requiredLimits = match self.requiredLimits {
      Option<&'a Limits<'a>>.Some { value } => unsafe value.rawPointer()
      Option<&'a Limits<'a>>.None => Pointer.null<sys.WGPULimits>()
    }
    result.defaultQueue = self.defaultQueue.value
    return result
  }
}

impl<'a> Limits<'a> {
  // Returned limits contain only scalar values; discard any foreign chain.
  pub fn fromRaw(value: sys.WGPULimits) -> Self {
    let mut clean = value
    clean.nextInChain = Pointer.null<sys.WGPUChainedStruct>()
    return Self { value: clean }
  }
  pub fn withCompatibilityModeLimits(self: Self, extension: &'a mut CompatibilityModeLimits) -> Self {
    let mut result = self
    result.value.nextInChain = Pointer.fromMutRef(&mut extension.value.chain)
    return result
  }
}

impl<'a> ShaderModuleDescriptor<'a> {
  pub fn withSourceWGSL<'entry>(self: Self, source: &'a mut ShaderSourceWGSL<'entry>) -> Self {
    let mut result = self
    result.value.nextInChain = Pointer.fromMutRef(&mut source.value.chain)
    return result
  }
}

impl<'a> RenderPassDescriptor<'a> {
  pub fn withMaxDrawCount(self: Self, extension: &'a mut RenderPassMaxDrawCount) -> Self {
    let mut result = self
    result.value.nextInChain = Pointer.fromMutRef(&mut extension.value.chain)
    return result
  }
}

impl<'a> TextureDescriptor<'a> {
  pub fn withBindingViewDimension(self: Self, extension: &'a mut TextureBindingViewDimension) -> Self {
    let mut result = self
    result.value.nextInChain = Pointer.fromMutRef(&mut extension.value.chain)
    return result
  }
}

impl<'a> TextureViewDescriptor<'a> {
  pub fn withComponentSwizzle(self: Self, extension: &'a mut TextureComponentSwizzleDescriptor) -> Self {
    let mut result = self
    result.value.nextInChain = Pointer.fromMutRef(&mut extension.value.chain)
    return result
  }
}

impl<'a> BindGroupEntry<'a> {
  pub fn withExternalTexture<'entry>(self: Self, extension: &'a mut ExternalTextureBindingEntry<'entry>) -> Self {
    let mut result = self
    result.value.nextInChain = Pointer.fromMutRef(&mut extension.value.chain)
    return result
  }
}

impl<'a> BindGroupLayoutEntry<'a> {
  pub fn withExternalTexture(self: Self, extension: &'a mut ExternalTextureBindingLayout) -> Self {
    let mut result = self
    result.value.nextInChain = Pointer.fromMutRef(&mut extension.value.chain)
    return result
  }
}

impl<'a> DeviceDescriptor<'a> {
  pub fn withLabel(self: Self, label: &'a [u8]) -> Self {
    let mut result = self
    result.label = label
    return result
  }
  pub fn withRequiredFeatures(self: Self, features: &'a [sys.WGPUFeatureName]) -> Self {
    let mut result = self
    result.requiredFeatures = features
    return result
  }
  pub fn withRequiredLimits<'entry>(self: Self, limits: &'a Limits<'entry>) -> Self {
    let mut result = self
    result.requiredLimits = Option<&'a Limits<'a>>.some(limits)
    return result
  }
  pub fn withDefaultQueue(self: Self, queue: QueueDescriptor<'a>) -> Self {
    let mut result = self
    result.defaultQueue = queue
    return result
  }
}
