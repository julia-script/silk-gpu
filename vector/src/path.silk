//! Path storage: one verb byte per command and the points it consumes.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import geometry { Point, Rect }

pub const MOVE: u8 = 0
pub const LINE: u8 = 1
pub const QUAD: u8 = 2
pub const CUBIC: u8 = 3
pub const CLOSE: u8 = 4

/// Verbs consume points in order: MOVE and LINE one, QUAD two, CUBIC three, CLOSE none.
pub struct Path {
  verbs: List<u8>,
  points: List<Point>,
}
impl Path {
  pub fn make() -> Path { return Path { verbs: List<u8>.make(), points: List<Point>.make() } }
  pub fn verbList(self: &Self) -> &[u8] { return self.verbs.asSlice() }
  pub fn pointList(self: &Self) -> &[Point] { return self.points.asSlice() }
  pub fn isEmpty(self: &Self) -> bool { return self.verbs.length() == 0 }
  pub fn clear(self: &mut Self) -> () {
    self.verbs.clear()
    self.points.clear()
  }
  pub effect fn moveTo(self: &mut Self, x: f64, y: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.verbs.append(MOVE)
    run self.points.append(Point { x: x, y: y })
  }
  pub effect fn lineTo(self: &mut Self, x: f64, y: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.verbs.append(LINE)
    run self.points.append(Point { x: x, y: y })
  }
  pub effect fn quadTo(self: &mut Self, x1: f64, y1: f64, x: f64, y: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.verbs.append(QUAD)
    run self.points.append(Point { x: x1, y: y1 })
    run self.points.append(Point { x: x, y: y })
  }
  pub effect fn cubicTo(self: &mut Self, x1: f64, y1: f64, x2: f64, y2: f64, x: f64, y: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.verbs.append(CUBIC)
    run self.points.append(Point { x: x1, y: y1 })
    run self.points.append(Point { x: x2, y: y2 })
    run self.points.append(Point { x: x, y: y })
  }
  pub effect fn close(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.verbs.append(CLOSE)
  }
  pub effect fn rect(self: &mut Self, rect: Rect) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.moveTo(rect.x0, rect.y0)
    run self.lineTo(rect.x1, rect.y0)
    run self.lineTo(rect.x1, rect.y1)
    run self.lineTo(rect.x0, rect.y1)
    run self.close()
  }
  /// A circle from four cubics with the usual 0.5522847498 handle ratio.
  pub effect fn circle(self: &mut Self, cx: f64, cy: f64, r: f64) -> () ! OutOfMemoryError ? &mut Allocator {
    let k = r * 0.5522847498307936
    run self.moveTo(cx + r, cy)
    run self.cubicTo(cx + r, cy + k, cx + k, cy + r, cx, cy + r)
    run self.cubicTo(cx - k, cy + r, cx - r, cy + k, cx - r, cy)
    run self.cubicTo(cx - r, cy - k, cx - k, cy - r, cx, cy - r)
    run self.cubicTo(cx + k, cy - r, cx + r, cy - k, cx + r, cy)
    run self.close()
  }
}
