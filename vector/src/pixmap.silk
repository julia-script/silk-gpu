//! The CPU reference target: premultiplied RGBA8, row major, composited with exact integer math.
//!
//! Every blend divides by 255 with [`div255`], which is exact for products of two bytes, so the
//! GPU renderer can be held to the same bytes.
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.num.i64
import silk.simd.simd
import silk.simd.u8x16
import silk.simd.u16x16
import silk.simd.u32x4
import strips { Coverage, BAND, minU32 }

/// A straight (not premultiplied) 8-bit color.
pub struct Rgba8 {
  pub r: u8,
  pub g: u8,
  pub b: u8,
  pub a: u8,
}
impl Copy for Rgba8 {}
impl Rgba8 {
  pub fn make(r: u8, g: u8, b: u8, a: u8) -> Rgba8 { return Rgba8 { r: r, g: g, b: b, a: a } }
  pub fn premultiply(self: &Self) -> Rgba8 {
    let a = u8.toU32(self.a)
    return Rgba8 {
      r: u32.toU8(div255(u8.toU32(self.r) * a)), g: u32.toU8(div255(u8.toU32(self.g) * a)),
      b: u32.toU8(div255(u8.toU32(self.b) * a)), a: self.a,
    }
  }
}

/// `round(x / 255)` for `x` in `0 ..= 255 * 255`.
pub fn div255(x: u32) -> u32
with Intrinsic.inlineAlways() {
  let t = x + 128
  return u32.shiftRight(t + u32.shiftRight(t, 8), 8)
}

pub struct Pixmap {
  pixelWidth: u32,
  pixelHeight: u32,
  bytes: List<u8>,
}
impl Pixmap {
  /// A transparent `width` x `height` pixmap.
  pub effect fn make(width: u32, height: u32) -> Pixmap ! OutOfMemoryError ? &mut Allocator {
    let mut bytes = List<u8>.make()
    run bytes.appendRepeated(0, u32.toUsize(width) * u32.toUsize(height) * 4)
    return Pixmap { pixelWidth: width, pixelHeight: height, bytes: move bytes }
  }
  pub fn width(self: &Self) -> u32 { return self.pixelWidth }
  pub fn height(self: &Self) -> u32 { return self.pixelHeight }
  /// Premultiplied RGBA8 bytes, row major with no padding.
  pub fn data(self: &Self) -> &[u8] { return self.bytes.asSlice() }
  pub fn dataMut(self: &mut Self) -> &mut [u8] { return self.bytes.asMutSlice() }
  /// Wraps premultiplied RGBA8 `bytes` (row major, `width * height * 4` long) as a pixmap.
  pub fn fromBytes(width: u32, height: u32, bytes: List<u8>) -> Pixmap {
    return Pixmap { pixelWidth: width, pixelHeight: height, bytes: move bytes }
  }
  /// The premultiplied pixel at `(x, y)`.
  pub fn pixel(self: &Self, x: u32, y: u32) -> Rgba8 {
    let i = (u32.toUsize(y) * u32.toUsize(self.pixelWidth) + u32.toUsize(x)) * 4
    let d = self.bytes.asSlice()
    return Rgba8 { r: d[i], g: d[i + 1], b: d[i + 2], a: d[i + 3] }
  }
  /// Sets every pixel to the premultiplied form of `color`.
  pub fn clear(self: &mut Self, color: Rgba8) -> () {
    let p = color.premultiply()
    let d = self.bytes.asMutSlice()
    let mut i: usize = 0
    if p.r == p.a && p.g == p.a && p.b == p.a {
      // Transparent, opaque white and other gray-equal colors are one repeated byte (a memset).
      while i < d.length {
        d[i] = p.a
        i = i + 1
      }
      return
    }
    while i + 3 < d.length {
      d[i] = p.r
      d[i + 1] = p.g
      d[i + 2] = p.b
      d[i + 3] = p.a
      i = i + 4
    }
  }
  /// Composites `color` (straight alpha) source-over through `coverage`.
  pub fn fillCoverage(self: &mut Self, coverage: &Coverage, color: Rgba8) -> () {
    let source = color.premultiply()
    let width = minU32(self.pixelWidth, coverage.width())
    let height = minU32(self.pixelHeight, coverage.height())
    let stride = u32.toUsize(self.pixelWidth) * 4
    let d = self.bytes.asMutSlice()
    let fills = coverage.fills()
    let mut f: usize = 0
    while f < fills.length {
      let fill = fills[f]
      let mut y = fill.y
      while y < fill.y + BAND && y < height {
        let mut x = fill.x
        let end = fill.x + fill.width
        while x < end && x < width {
          over(&mut d, u32.toUsize(y) * stride + u32.toUsize(x) * 4, source)
          x = x + 1
        }
        y = y + 1
      }
      f = f + 1
    }
    let alphas = coverage.alphas()
    let strips = coverage.strips()
    let mut s: usize = 0
    while s < strips.length {
      let strip = strips[s]
      let mut column: u32 = 0
      while column < strip.width && strip.x + column < width {
        let base = u32.toUsize(strip.alphaOffset + column * BAND)
        let mut row: u32 = 0
        while row < BAND && strip.y + row < height {
          let mask = u8.toU32(alphas[base + u32.toUsize(row)])
          if mask != 0 {
            let masked = Rgba8 {
              r: u32.toU8(div255(u8.toU32(source.r) * mask)), g: u32.toU8(div255(u8.toU32(source.g) * mask)),
              b: u32.toU8(div255(u8.toU32(source.b) * mask)), a: u32.toU8(div255(u8.toU32(source.a) * mask)),
            }
            over(&mut d, u32.toUsize(strip.y + row) * stride + u32.toUsize(strip.x + column) * 4, masked)
          }
          row = row + 1
        }
        column = column + 1
      }
      s = s + 1
    }
  }
}

/// Premultiplied source-over of `source` onto the pixel at byte offset `i`.
pub fn over(d: &mut [u8], i: usize, source: Rgba8) -> () { overPacked(&mut d, i, pack(source)) }

/// `color` as one word: `r | g << 8 | b << 16 | a << 24`.
pub fn pack(color: Rgba8) -> u32
with Intrinsic.inlineAlways() {
  return u8.toU32(color.r) | u32.shiftLeft(u8.toU32(color.g), 8) | u32.shiftLeft(u8.toU32(color.b), 16) | u32.shiftLeft(u8.toU32(color.a), 24)
}

pub fn unpack(word: u32) -> Rgba8 {
  return Rgba8 {
    r: u32.toU8(word & 255), g: u32.toU8(u32.shiftRight(word, 8) & 255),
    b: u32.toU8(u32.shiftRight(word, 16) & 255), a: u32.toU8(u32.shiftRight(word, 24)),
  }
}

const LANES: u32 = 0x00ff00ff

/// [`div255`] on the two 16-bit lanes of `x` (each at most `255 * 255`).
fn div255Lanes(x: u32) -> u32
with Intrinsic.inlineAlways() {
  let t = x + 0x00800080
  return u32.shiftRight(t + (u32.shiftRight(t, 8) & LANES), 8) & LANES
}

/// Every channel of the packed color `word` times `scale / 255`, rounded like [`div255`].
pub fn scalePacked(word: u32, scale: u32) -> u32
with Intrinsic.inlineAlways() {
  let rb = div255Lanes((word & LANES) * scale)
  let ag = div255Lanes((u32.shiftRight(word, 8) & LANES) * scale)
  return rb | u32.shiftLeft(ag, 8)
}

/// [`overPacked`] for `count` packed premultiplied sources into consecutive pixels from byte
/// `at`, four pixels per step with the same arithmetic.
pub fn overSpan(d: &mut [u8], at: usize, colors: &[u32], count: usize) -> () {
  let target = Slice.viewMut(&mut d, at, count * 4)
  let full = u16x16.splat(255)
  let half = u16x16.splat(128)
  let eight = u16x16.splat(8)
  let mut i: usize = 0
  while i + 4 <= count {
    let source = u8x16.toU16x16(u32x4.bitcastToU8x16(u32x4.load(colors, i)))
    let below = u8x16.toU16x16(u8x16.load(&target, i * 4))
    let alpha = u16x16.shuffle(source, source, [3, 3, 3, 3, 7, 7, 7, 7, 11, 11, 11, 11, 15, 15, 15, 15])
    // div255 as in `scalePacked`: t = x + 128, (t + (t >> 8)) >> 8, all within u16.
    let t = u16x16.wrappingAdd(u16x16.wrappingMultiply(below, u16x16.wrappingSubtract(full, alpha)), half)
    let scaled = u16x16.shiftRight(u16x16.wrappingAdd(t, u16x16.shiftRight(t, eight)), eight)
    u8x16.store(&mut target, i * 4, u16x16.toU8x16(u16x16.wrappingAdd(scaled, source)))
    i = i + 4
  }
  while i < count {
    overPacked(&mut target, i * 4, colors[i])
    i = i + 1
  }
}

/// `color` (four packed premultiplied pixels widened to u16 lanes) scaled per pixel by `masks`
/// (0..=255, repeated over each pixel's four lanes), then composited source-over into the four
/// pixels from byte `at`: [`overPacked`] of [`scalePacked`] per pixel, with the same rounding.
pub fn overMaskedFour(d: &mut [u8], at: usize, color: simd<u16, 16>, masks: simd<u16, 16>) -> ()
with Intrinsic.inlineAlways() {
  let target = Slice.viewMut(&mut d, at, 16)
  let full = u16x16.splat(255)
  let half = u16x16.splat(128)
  let eight = u16x16.splat(8)
  let m = u16x16.wrappingAdd(u16x16.wrappingMultiply(color, masks), half)
  let source = u16x16.shiftRight(u16x16.wrappingAdd(m, u16x16.shiftRight(m, eight)), eight)
  let below = u8x16.toU16x16(u8x16.load(&target, 0))
  let alpha = u16x16.shuffle(source, source, [3, 3, 3, 3, 7, 7, 7, 7, 11, 11, 11, 11, 15, 15, 15, 15])
  let t = u16x16.wrappingAdd(u16x16.wrappingMultiply(below, u16x16.wrappingSubtract(full, alpha)), half)
  let scaled = u16x16.shiftRight(u16x16.wrappingAdd(t, u16x16.shiftRight(t, eight)), eight)
  u8x16.store(&mut target, 0, u16x16.toU8x16(u16x16.wrappingAdd(scaled, source)))
}

/// [`over`] with a packed premultiplied source.
pub fn overPacked(d: &mut [u8], i: usize, source: u32) -> ()
with Intrinsic.inlineAlways() {
  let alpha = u32.shiftRight(source, 24)
  if alpha == 255 {
    storePacked(&mut d, i, source)
    return
  }
  if source == 0 { return }
  // One range check for the pixel; the byte offsets below are then constant.
  let pixel = Slice.viewMut(&mut d, i, 4)
  let below = u8.toU32(pixel[0]) | u32.shiftLeft(u8.toU32(pixel[1]), 8) | u32.shiftLeft(u8.toU32(pixel[2]), 16) | u32.shiftLeft(u8.toU32(pixel[3]), 24)
  // Premultiplied channels never exceed alpha, so no lane carries into the next.
  let word = u32.wrappingAdd(source, scalePacked(below, 255 - alpha))
  pixel[0] = u32.wrappingToU8(word)
  pixel[1] = u32.wrappingToU8(u32.shiftRight(word, 8))
  pixel[2] = u32.wrappingToU8(u32.shiftRight(word, 16))
  pixel[3] = u32.wrappingToU8(u32.shiftRight(word, 24))
}

pub fn storePacked(d: &mut [u8], i: usize, word: u32) -> ()
with Intrinsic.inlineAlways() {
  let pixel = Slice.viewMut(&mut d, i, 4)
  pixel[0] = u32.wrappingToU8(word)
  pixel[1] = u32.wrappingToU8(u32.shiftRight(word, 8))
  pixel[2] = u32.wrappingToU8(u32.shiftRight(word, 16))
  pixel[3] = u32.wrappingToU8(u32.shiftRight(word, 24))
}

