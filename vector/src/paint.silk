//! Paints: solid colors, linear and radial gradients, and image patterns.
//!
//! A paint is a [`Shader`]: it returns the premultiplied color at a device pixel center. Gradient
//! and image paints carry the transform from their own space to device space (the caller folds in
//! `gradientTransform`, `patternTransform`, `objectBoundingBox` units and the CTM) and sample at
//! `(x + 0.5, y + 0.5)` mapped back through its inverse.
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.num.i64
import silk.option { Option }
import strips { Coverage, BAND, minU32 }
import geometry { Affine, Point }
import pixmap { Pixmap, Rgba8, div255, over, overPacked, pack, scalePacked, storePacked }

pub interface Shader {
  /// The premultiplied color at the center of device pixel `(x, y)`.
  fn shade(self: &Self, x: u32, y: u32) -> Rgba8
  /// Packed premultiplied colors (see [`pack`]) of pixels `x .. x + count` on row `y` into
  /// `out[0 .. count]`.
  fn shadeSpan(self: &Self, x: u32, y: u32, count: usize, out: &mut [u32]) -> ()
}

/// One premultiplied color everywhere.
pub struct Solid {
  pub color: Rgba8,
}
impl Copy for Solid {}
impl Solid {
  /// A solid paint from a straight-alpha color.
  pub fn make(color: Rgba8) -> Solid { return Solid { color: color.premultiply() } }
}
impl Shader for Solid {
  fn shade(self: &Self, x: u32, y: u32) -> Rgba8 { return self.color }
  fn shadeSpan(self: &Self, x: u32, y: u32, count: usize, out: &mut [u32]) -> () {
    let word = pack(self.color)
    let mut i: usize = 0
    while i < count {
      out[i] = word
      i = i + 1
    }
  }
}

pub const SPREAD_PAD: u8 = 0
pub const SPREAD_REFLECT: u8 = 1
pub const SPREAD_REPEAT: u8 = 2

const LINEAR: u8 = 0
const RADIAL: u8 = 1
/// Gradient colors are tabulated at this many evenly spaced offsets.
pub const RAMP_SIZE: usize = 1024

/// A gradient stop with a straight-alpha color (stop-color with stop-opacity folded in).
pub struct Stop {
  pub offset: f64,
  pub color: Rgba8,
}
impl Copy for Stop {}

/// A linear or two-point conical radial gradient (SVG 2 §14.3).
pub struct Gradient {
  kind: u8,
  x0: f64,
  y0: f64,
  r0: f64,
  x1: f64,
  y1: f64,
  r1: f64,
  spread: u8,
  inverse: Affine,
  valid: bool,
  /// True when the paint is the last stop color everywhere (a degenerate vector or radius).
  single: bool,
  premultipliedInterpolation: bool,
  ramp: List<u8>,
}

fn clamp01(value: f64) -> f64 { return f64.min(f64.max(value, 0.0), 1.0) }

impl Gradient {
  fn make(kind: u8, x0: f64, y0: f64, r0: f64, x1: f64, y1: f64, r1: f64, spread: u8, transform: &Affine) -> Gradient {
    let mut inverse = Affine.identity()
    let mut valid = false
    if let Option<Affine>.Some { value: found } = transform.invert() {
      inverse = found
      valid = true
    }
    return Gradient {
      kind: kind, x0: x0, y0: y0, r0: r0, x1: x1, y1: y1, r1: r1, spread: spread, inverse: inverse,
      valid: valid, single: false, premultipliedInterpolation: false, ramp: List<u8>.make(),
    }
  }
  /// A linear gradient from `(x1, y1)` to `(x2, y2)` in gradient space; `transform` maps gradient
  /// space to device space.
  pub fn linear(x1: f64, y1: f64, x2: f64, y2: f64, spread: u8, transform: &Affine) -> Gradient {
    let mut g = Gradient.make(LINEAR, x1, y1, 0.0, x2, y2, 0.0, spread, transform)
    g.single = x1 == x2 && y1 == y2
    return move g
  }
  /// A radial gradient from the focal circle `(fx, fy, fr)` to the end circle `(cx, cy, r)`, the
  /// SVG 2 two-point conical form: a focal circle outside the end circle makes a cone, and points
  /// outside it stay transparent. SVG 1.1's focal-point clamping is the caller's choice.
  pub fn radial(cx: f64, cy: f64, r: f64, fx: f64, fy: f64, fr: f64, spread: u8, transform: &Affine) -> Gradient {
    let mut g = Gradient.make(RADIAL, fx, fy, fr, cx, cy, r, spread, transform)
    g.single = !(r > 0.0)
    return move g
  }
  /// Interpolate premultiplied colors (CSS Images 3) instead of straight colors (resvg, Skia's
  /// SVG default). Call before [`setStops`].
  pub fn setPremultipliedInterpolation(self: &mut Self, premultiplied: bool) -> () {
    self.premultipliedInterpolation = premultiplied
  }
  pub fn isRadial(self: &Self) -> bool { return self.kind == RADIAL }
  /// True when the gradient paints its last stop everywhere.
  pub fn isSingle(self: &Self) -> bool { return self.single }
  pub fn spreadMode(self: &Self) -> u8 { return self.spread }
  /// The device-to-gradient-space transform.
  pub fn inverseTransform(self: &Self) -> Affine { return self.inverse }
  /// Linear: `x1 y1 0 x2 y2 0`. Radial: `fx fy fr cx cy r`.
  pub fn geometry(self: &Self) -> [f64; 6] { return [self.x0, self.y0, self.r0, self.x1, self.y1, self.r1] }
  /// The premultiplied RGBA8 ramp, [`RAMP_SIZE`] entries (empty before [`setStops`]).
  pub fn rampBytes(self: &Self) -> &[u8] { return self.ramp.asSlice() }
  /// True once stops are set and the transform is invertible.
  pub fn isPaintable(self: &Self) -> bool { return self.valid && self.ramp.length() > 0 }

  /// Tabulates `stops`. Offsets are clamped to `0..=1` and made non-decreasing (SVG 2 §14.4);
  /// equal offsets make a hard edge. No stops leaves the gradient unpaintable (paint `none`); one
  /// stop paints its color everywhere.
  pub effect fn setStops(self: &mut Self, stops: &[Stop]) -> () ! OutOfMemoryError ? &mut Allocator {
    self.ramp.clear()
    if stops.length == 0 { return }
    run self.ramp.appendRepeated(0, RAMP_SIZE * 4)
    let ramp = self.ramp.asMutSlice()
    let first = pack(stops[0].color.premultiply())
    let last = pack(stops[stops.length - 1].color.premultiply())
    let step = 1.0 / usize.toF64(RAMP_SIZE - 1)
    // `segment` is the first stop whose fixed-up offset `hi` exceeds t; `lo` is the one before it.
    let mut segment: usize = 0
    let mut lo = clamp01(stops[0].offset)
    let mut hi = lo
    let mut i: usize = 0
    while i < RAMP_SIZE {
      let t = usize.toF64(i) * step
      while segment < stops.length && hi <= t {
        segment = segment + 1
        lo = hi
        if segment < stops.length { hi = f64.max(hi, clamp01(stops[segment].offset)) }
      }
      if self.single || segment == stops.length {
        storePacked(&mut ramp, i * 4, last)
        i = i + 1
      } else if segment == 0 {
        storePacked(&mut ramp, i * 4, first)
        i = i + 1
      } else {
        // Entries up to `hi` interpolate this segment; step the weight in 32-bit fixed point.
        // Here lo <= t < hi, so the span is positive.
        let left = stops[segment - 1].color
        let right = stops[segment].color
        let span = hi - lo
        let mut w = Intrinsic.f64ToU64((t - lo) / span * 4294967296.0)
        let dw = Intrinsic.f64ToU64(step / span * 4294967296.0)
        while i < RAMP_SIZE && usize.toF64(i) * step < hi {
          let rounded = u64.shiftRight(w + 32768, 16)
          let wb = if rounded < 65536 { u64.wrappingToU32(rounded) } else { 65536 }
          storePacked(&mut ramp, i * 4, pack(mix(left, right, wb, self.premultipliedInterpolation)))
          w = w + dw
          i = i + 1
        }
      }
    }
  }

  /// The gradient parameter at gradient-space point `p`, or [`NOTHING`] where nothing is painted.
  fn parameter(self: &Self, p: Point) -> f64
  with Intrinsic.inlineAlways() {
    if self.kind == LINEAR {
      let dx = self.x1 - self.x0
      let dy = self.y1 - self.y0
      return ((p.x - self.x0) * dx + (p.y - self.y0) * dy) / (dx * dx + dy * dy)
    }
    // Largest t with |p - c(t)| = r(t) and r(t) >= 0, where c and r interpolate the focal circle
    // (t = 0) to the end circle (t = 1): a t^2 - 2 b t + c = 0.
    let cdx = self.x1 - self.x0
    let cdy = self.y1 - self.y0
    let dr = self.r1 - self.r0
    let pdx = p.x - self.x0
    let pdy = p.y - self.y0
    let a = cdx * cdx + cdy * cdy - dr * dr
    let b = pdx * cdx + pdy * cdy + self.r0 * dr
    let c = pdx * pdx + pdy * pdy - self.r0 * self.r0
    if f64.abs(a) < 1.0e-12 {
      if b == 0.0 { return NOTHING }
      let t = c / (2.0 * b)
      return if self.r0 + t * dr >= 0.0 { t } else { NOTHING }
    }
    let disc = b * b - a * c
    if disc < 0.0 { return NOTHING }
    let root = f64.sqrt(disc)
    let t1 = f64.max((b + root) / a, (b - root) / a)
    let t2 = f64.min((b + root) / a, (b - root) / a)
    if self.r0 + t1 * dr >= 0.0 { return t1 }
    if self.r0 + t2 * dr >= 0.0 { return t2 }
    return NOTHING
  }
}

/// Encodes "nothing painted here" apart from every real parameter.
const NOTHING: f64 = -1.0e300

/// Interpolates stop colors `a` and `b` with weight `wb / 65536` on `b`, straight (then
/// premultiplied) or premultiplied.
fn mix(a: Rgba8, b: Rgba8, wb: u32, premultiplied: bool) -> Rgba8
with Intrinsic.inlineAlways() {
  let wa = 65536 - wb
  if premultiplied {
    let pa = a.premultiply()
    let pb = b.premultiply()
    return Rgba8 { r: lerpByte(pa.r, pb.r, wa, wb), g: lerpByte(pa.g, pb.g, wa, wb), b: lerpByte(pa.b, pb.b, wa, wb), a: lerpByte(pa.a, pb.a, wa, wb) }
  }
  let alpha = lerpByte(a.a, b.a, wa, wb)
  return Rgba8.make(lerpByte(a.r, b.r, wa, wb), lerpByte(a.g, b.g, wa, wb), lerpByte(a.b, b.b, wa, wb), alpha).premultiply()
}

fn lerpByte(a: u8, b: u8, wa: u32, wb: u32) -> u8
with Intrinsic.inlineAlways() {
  return u32.wrappingToU8(u32.shiftRight(u8.toU32(a) * wa + u8.toU32(b) * wb + 32768, 16))
}

fn spreadParameter(t: f64, spread: u8) -> f64
with Intrinsic.inlineAlways() {
  if spread == SPREAD_REPEAT { return t - f64.floor(t) }
  if spread == SPREAD_REFLECT {
    let m = t - 2.0 * f64.floor(t * 0.5)
    return if m > 1.0 { 2.0 - m } else { m }
  }
  return if t < 0.0 { 0.0 } else if t > 1.0 { 1.0 } else { t }
}

impl Shader for Gradient {
  fn shade(self: &Self, x: u32, y: u32) -> Rgba8 {
    if !self.isPaintable() { return Rgba8.make(0, 0, 0, 0) }
    let ramp = self.ramp.asSlice()
    let mut index = RAMP_SIZE - 1
    if !self.single {
      let p = self.inverse.apply(Point.make(u32.toF64(x) + 0.5, u32.toF64(y) + 0.5))
      let t = self.parameter(p)
      if t == NOTHING || !f64.isFinite(t) { return Rgba8.make(0, 0, 0, 0) }
      let s = spreadParameter(t, self.spread)
      index = f64.toUsize(f64.floor(s * usize.toF64(RAMP_SIZE - 1) + 0.5))
    }
    return Rgba8 { r: ramp[index * 4], g: ramp[index * 4 + 1], b: ramp[index * 4 + 2], a: ramp[index * 4 + 3] }
  }
  fn shadeSpan(self: &Self, x: u32, y: u32, count: usize, out: &mut [u32]) -> () {
    if !self.isPaintable() || self.single {
      let word = pack(self.shade(x, y))
      let mut i: usize = 0
      while i < count {
        out[i] = word
        i = i + 1
      }
      return
    }
    let ramp = self.ramp.asSlice()
    let scale = usize.toF64(RAMP_SIZE - 1)
    // Gradient-space position of the first pixel center and the step to the next one.
    let start = self.inverse.apply(Point.make(u32.toF64(x) + 0.5, u32.toF64(y) + 0.5))
    let mut i: usize = 0
    if self.kind == LINEAR {
      // The linear parameter is affine in device space: step it along the row.
      let t0 = self.parameter(start)
      let dt = self.parameter(Point.make(start.x + self.inverse.a, start.y + self.inverse.b)) - t0
      let finite = f64.isFinite(t0) && f64.isFinite(dt)
      while i < count {
        if finite {
          let index = Intrinsic.f64ToUsize(spreadParameter(t0 + usize.toF64(i) * dt, self.spread) * scale + 0.5)
          out[i] = rampWord(ramp, index)
        } else {
          out[i] = 0
        }
        i = i + 1
      }
      return
    }
    if self.r0 == 0.0 && self.x0 == self.x1 && self.y0 == self.y1 {
      // Focal point at the center: t is the distance to it over the radius.
      let inverseRadius = 1.0 / self.r1
      while i < count {
        let k = usize.toF64(i)
        let dx = start.x + k * self.inverse.a - self.x1
        let dy = start.y + k * self.inverse.b - self.y1
        let t = f64.sqrt(dx * dx + dy * dy) * inverseRadius
        out[i] = if f64.isFinite(t) { rampWord(ramp, Intrinsic.f64ToUsize(spreadParameter(t, self.spread) * scale + 0.5)) } else { 0 }
        i = i + 1
      }
      return
    }
    while i < count {
      let k = usize.toF64(i)
      let t = self.parameter(Point.make(start.x + k * self.inverse.a, start.y + k * self.inverse.b))
      if t == NOTHING || !f64.isFinite(t) {
        out[i] = 0
      } else {
        out[i] = rampWord(ramp, Intrinsic.f64ToUsize(spreadParameter(t, self.spread) * scale + 0.5))
      }
      i = i + 1
    }
  }
}

fn rampWord(ramp: &[u8], index: usize) -> u32
with Intrinsic.inlineAlways() {
  let entry = Slice.view(ramp, index * 4, 4)
  return u8.toU32(entry[0]) | u32.shiftLeft(u8.toU32(entry[1]), 8) | u32.shiftLeft(u8.toU32(entry[2]), 16) | u32.shiftLeft(u8.toU32(entry[3]), 24)
}

pub const SAMPLE_NEAREST: u8 = 0
pub const SAMPLE_BILINEAR: u8 = 1
pub const EXTEND_CLAMP: u8 = 0
pub const EXTEND_REPEAT: u8 = 1

/// A premultiplied image placed by `transform` (image pixel space to device space). `EXTEND_CLAMP`
/// suits `image` (clip with its rectangle); `EXTEND_REPEAT` suits pattern tiles.
pub struct ImagePattern<'a> {
  image: &'a Pixmap,
  inverse: Affine,
  valid: bool,
  sampling: u8,
  extend: u8,
}
impl<'a> ImagePattern<'a> {
  pub fn make(image: &'a Pixmap, transform: &Affine, sampling: u8, extend: u8) -> ImagePattern<'a> {
    let mut inverse = Affine.identity()
    let mut valid = image.width() > 0 && image.height() > 0
    if let Option<Affine>.Some { value: found } = transform.invert() { inverse = found } else { valid = false }
    return ImagePattern { image: image, inverse: inverse, valid: valid, sampling: sampling, extend: extend }
  }
  /// The premultiplied image being placed.
  pub fn pixmap(self: &Self) -> &'a Pixmap { return self.image }
  /// The device-to-image-pixel transform.
  pub fn inverseTransform(self: &Self) -> Affine { return self.inverse }
  pub fn samplingMode(self: &Self) -> u8 { return self.sampling }
  pub fn extendMode(self: &Self) -> u8 { return self.extend }
  /// False for an empty image or a non-invertible transform: the pattern paints nothing.
  pub fn isPaintable(self: &Self) -> bool { return self.valid }
  fn texel(self: &Self, x: i64, y: i64) -> Rgba8 {
    let w = u32.toI64(self.image.width())
    let h = u32.toI64(self.image.height())
    let mut tx = x
    let mut ty = y
    if self.extend == EXTEND_REPEAT {
      tx = ((x % w) + w) % w
      ty = ((y % h) + h) % h
    } else {
      tx = if x < 0 { 0 } else if x >= w { w - 1 } else { x }
      ty = if y < 0 { 0 } else if y >= h { h - 1 } else { y }
    }
    return self.image.pixel(i64.toU32(tx), i64.toU32(ty))
  }
}
impl<'a> Shader for ImagePattern<'a> {
  fn shade(self: &Self, x: u32, y: u32) -> Rgba8 {
    if !self.valid { return Rgba8.make(0, 0, 0, 0) }
    let p = self.inverse.apply(Point.make(u32.toF64(x) + 0.5, u32.toF64(y) + 0.5))
    if !p.isFinite() || f64.abs(p.x) > 1.0e15 || f64.abs(p.y) > 1.0e15 { return Rgba8.make(0, 0, 0, 0) }
    if self.sampling == SAMPLE_NEAREST {
      return self.texel(f64.toI64(f64.floor(p.x)), f64.toI64(f64.floor(p.y)))
    }
    let fx = p.x - 0.5
    let fy = p.y - 0.5
    let x0 = f64.floor(fx)
    let y0 = f64.floor(fy)
    let wx = fx - x0
    let wy = fy - y0
    let ix = f64.toI64(x0)
    let iy = f64.toI64(y0)
    let a = self.texel(ix, iy)
    let b = self.texel(ix + 1, iy)
    let c = self.texel(ix, iy + 1)
    let d = self.texel(ix + 1, iy + 1)
    return Rgba8 {
      r: bilerp(a.r, b.r, c.r, d.r, wx, wy), g: bilerp(a.g, b.g, c.g, d.g, wx, wy),
      b: bilerp(a.b, b.b, c.b, d.b, wx, wy), a: bilerp(a.a, b.a, c.a, d.a, wx, wy),
    }
  }
  fn shadeSpan(self: &Self, x: u32, y: u32, count: usize, out: &mut [u32]) -> () {
    let mut i: usize = 0
    while i < count {
      out[i] = pack(self.shade(x + usize.toU32(i), y))
      i = i + 1
    }
  }
}

fn bilerp(a: u8, b: u8, c: u8, d: u8, wx: f64, wy: f64) -> u8 {
  let top = u8.toF64(a) + (u8.toF64(b) - u8.toF64(a)) * wx
  let bottom = u8.toF64(c) + (u8.toF64(d) - u8.toF64(c)) * wx
  return f64.toU8(f64.floor(top + (bottom - top) * wy + 0.5))
}

/// Composites `shader` source-over into `target` through `coverage`, scaled by `opacity`
/// (0..=255, for `fill-opacity` and `stroke-opacity`).
pub fn fill<S: Shader>(target: &mut Pixmap, coverage: &Coverage, shader: &S, opacity: u8) -> () {
  if opacity == 0 { return }
  let width = minU32(target.width(), coverage.width())
  let height = minU32(target.height(), coverage.height())
  let stride = u32.toUsize(target.width()) * 4
  let fullMask = u8.toU32(opacity)
  let d = target.dataMut()
  let mut colors: [u32; SPAN] = [0; SPAN]
  let fills = coverage.fills()
  let mut f: usize = 0
  while f < fills.length {
    let span = fills[f]
    let right = minU32(span.x + span.width, width)
    let mut y = span.y
    while y < span.y + BAND && y < height {
      let row = u32.toUsize(y) * stride
      let mut x = span.x
      while x < right {
        let count = u32.toUsize(minU32(right - x, SPAN_U32))
        shader.shadeSpan(x, y, count, &mut colors)
        let mut i: usize = 0
        let mut at = row + u32.toUsize(x) * 4
        if fullMask == 255 {
          while i < count {
            overPacked(&mut d, at, colors[i])
            at = at + 4
            i = i + 1
          }
        } else {
          while i < count {
            overPacked(&mut d, at, scalePacked(colors[i], fullMask))
            at = at + 4
            i = i + 1
          }
        }
        x = x + usize.toU32(count)
      }
      y = y + 1
    }
    f = f + 1
  }
  // Strips hold column-major alphas; shade each strip row as a span.
  let alphas = coverage.alphas()
  let strips = coverage.strips()
  let mut s: usize = 0
  while s < strips.length {
    let strip = strips[s]
    let right = minU32(strip.x + strip.width, width)
    let mut row: u32 = 0
    while row < BAND && strip.y + row < height {
      let y = strip.y + row
      let line = u32.toUsize(y) * stride
      let mut x = strip.x
      while x < right {
        let count = u32.toUsize(minU32(right - x, SPAN_U32))
        shader.shadeSpan(x, y, count, &mut colors)
        let mut base = u32.toUsize(strip.alphaOffset + (x - strip.x) * BAND + row)
        let mut at = line + u32.toUsize(x) * 4
        let mut i: usize = 0
        while i < count {
          let alpha = u8.toU32(alphas[base])
          if alpha != 0 {
            let mask = if fullMask == 255 { alpha } else { div255(alpha * fullMask) }
            overPacked(&mut d, at, if mask == 255 { colors[i] } else { scalePacked(colors[i], mask) })
          }
          base = base + u32.toUsize(BAND)
          at = at + 4
          i = i + 1
        }
        x = x + usize.toU32(count)
      }
      row = row + 1
    }
    s = s + 1
  }
}

const SPAN: usize = 128
const SPAN_U32: u32 = 128

fn masked(color: Rgba8, mask: u32) -> Rgba8 {
  if mask == 255 { return color }
  return Rgba8 {
    r: u32.toU8(div255(u8.toU32(color.r) * mask)), g: u32.toU8(div255(u8.toU32(color.g) * mask)),
    b: u32.toU8(div255(u8.toU32(color.b) * mask)), a: u32.toU8(div255(u8.toU32(color.a) * mask)),
  }
}
