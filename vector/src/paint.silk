//! Paints: solid colors, linear and radial gradients, and image patterns.
//!
//! A paint is a [`Shader`]: it returns the premultiplied color at a device pixel center. Gradient
//! and image paints carry the transform from their own space to device space (the caller folds in
//! `gradientTransform`, `patternTransform`, `objectBoundingBox` units and the CTM) and sample at
//! `(x + 0.5, y + 0.5)` mapped back through its inverse.
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.num.i64
import silk.option { Option }
import strips { Coverage, BAND, minU32 }
import geometry { Affine, Point }
import pixmap { Pixmap, Rgba8, div255, over }

pub interface Shader {
  /// The premultiplied color at the center of device pixel `(x, y)`.
  fn shade(self: &Self, x: u32, y: u32) -> Rgba8
}

/// One premultiplied color everywhere.
pub struct Solid {
  pub color: Rgba8,
}
impl Copy for Solid {}
impl Solid {
  /// A solid paint from a straight-alpha color.
  pub fn make(color: Rgba8) -> Solid { return Solid { color: color.premultiply() } }
}
impl Shader for Solid {
  fn shade(self: &Self, x: u32, y: u32) -> Rgba8 { return self.color }
}

pub const SPREAD_PAD: u8 = 0
pub const SPREAD_REFLECT: u8 = 1
pub const SPREAD_REPEAT: u8 = 2

const LINEAR: u8 = 0
const RADIAL: u8 = 1
/// Gradient colors are tabulated at this many evenly spaced offsets.
pub const RAMP_SIZE: usize = 1024

/// A gradient stop with a straight-alpha color (stop-color with stop-opacity folded in).
pub struct Stop {
  pub offset: f64,
  pub color: Rgba8,
}
impl Copy for Stop {}

/// A linear or two-point conical radial gradient (SVG 2 §14.3).
pub struct Gradient {
  kind: u8,
  x0: f64,
  y0: f64,
  r0: f64,
  x1: f64,
  y1: f64,
  r1: f64,
  spread: u8,
  inverse: Affine,
  valid: bool,
  /// True when the paint is the last stop color everywhere (a degenerate vector or radius).
  single: bool,
  premultipliedInterpolation: bool,
  ramp: List<u8>,
}

fn clamp01(value: f64) -> f64 { return f64.min(f64.max(value, 0.0), 1.0) }
fn toByte(value: f64) -> u8 { return f64.toU8(f64.floor(clamp01(value) * 255.0 + 0.5)) }

impl Gradient {
  fn make(kind: u8, x0: f64, y0: f64, r0: f64, x1: f64, y1: f64, r1: f64, spread: u8, transform: &Affine) -> Gradient {
    let mut inverse = Affine.identity()
    let mut valid = false
    if let Option<Affine>.Some { value: found } = transform.invert() {
      inverse = found
      valid = true
    }
    return Gradient {
      kind: kind, x0: x0, y0: y0, r0: r0, x1: x1, y1: y1, r1: r1, spread: spread, inverse: inverse,
      valid: valid, single: false, premultipliedInterpolation: false, ramp: List<u8>.make(),
    }
  }
  /// A linear gradient from `(x1, y1)` to `(x2, y2)` in gradient space; `transform` maps gradient
  /// space to device space.
  pub fn linear(x1: f64, y1: f64, x2: f64, y2: f64, spread: u8, transform: &Affine) -> Gradient {
    let mut g = Gradient.make(LINEAR, x1, y1, 0.0, x2, y2, 0.0, spread, transform)
    g.single = x1 == x2 && y1 == y2
    return move g
  }
  /// A radial gradient from the focal circle `(fx, fy, fr)` to the end circle `(cx, cy, r)`, the
  /// SVG 2 two-point conical form: a focal circle outside the end circle makes a cone, and points
  /// outside it stay transparent. SVG 1.1's focal-point clamping is the caller's choice.
  pub fn radial(cx: f64, cy: f64, r: f64, fx: f64, fy: f64, fr: f64, spread: u8, transform: &Affine) -> Gradient {
    let mut g = Gradient.make(RADIAL, fx, fy, fr, cx, cy, r, spread, transform)
    g.single = !(r > 0.0)
    return move g
  }
  /// Interpolate premultiplied colors (CSS Images 3) instead of straight colors (resvg, Skia's
  /// SVG default). Call before [`setStops`].
  pub fn setPremultipliedInterpolation(self: &mut Self, premultiplied: bool) -> () {
    self.premultipliedInterpolation = premultiplied
  }
  /// True once stops are set and the transform is invertible.
  pub fn isPaintable(self: &Self) -> bool { return self.valid && self.ramp.length() > 0 }

  /// Tabulates `stops`. Offsets are clamped to `0..=1` and made non-decreasing (SVG 2 §14.4);
  /// equal offsets make a hard edge. No stops leaves the gradient unpaintable (paint `none`); one
  /// stop paints its color everywhere.
  pub effect fn setStops(self: &mut Self, stops: &[Stop]) -> () ! OutOfMemoryError ? &mut Allocator {
    self.ramp.clear()
    if stops.length == 0 { return }
    run self.ramp.appendRepeated(0, RAMP_SIZE * 4)
    let ramp = self.ramp.asMutSlice()
    let mut i: usize = 0
    let mut segment: usize = 0
    while i < RAMP_SIZE {
      let t = usize.toF64(i) / usize.toF64(RAMP_SIZE - 1)
      // Advance to the first stop whose (fixed-up) offset exceeds t.
      while segment < stops.length && fixedOffset(stops, segment) <= t { segment = segment + 1 }
      let mut color = Rgba8.make(0, 0, 0, 0)
      if segment == 0 {
        color = stops[0].color.premultiply()
      } else if segment == stops.length {
        color = stops[stops.length - 1].color.premultiply()
      } else {
        let left = stops[segment - 1]
        let right = stops[segment]
        let lo = fixedOffset(stops, segment - 1)
        let hi = fixedOffset(stops, segment)
        let w = if hi > lo { (t - lo) / (hi - lo) } else { 1.0 }
        color = mix(left.color, right.color, w, self.premultipliedInterpolation)
      }
      if self.single { color = stops[stops.length - 1].color.premultiply() }
      ramp[i * 4] = color.r
      ramp[i * 4 + 1] = color.g
      ramp[i * 4 + 2] = color.b
      ramp[i * 4 + 3] = color.a
      i = i + 1
    }
  }

  /// The gradient parameter at gradient-space point `p`, or [`NOTHING`] where nothing is painted.
  fn parameter(self: &Self, p: Point) -> f64 {
    if self.kind == LINEAR {
      let dx = self.x1 - self.x0
      let dy = self.y1 - self.y0
      return ((p.x - self.x0) * dx + (p.y - self.y0) * dy) / (dx * dx + dy * dy)
    }
    // Largest t with |p - c(t)| = r(t) and r(t) >= 0, where c and r interpolate the focal circle
    // (t = 0) to the end circle (t = 1): a t^2 - 2 b t + c = 0.
    let cdx = self.x1 - self.x0
    let cdy = self.y1 - self.y0
    let dr = self.r1 - self.r0
    let pdx = p.x - self.x0
    let pdy = p.y - self.y0
    let a = cdx * cdx + cdy * cdy - dr * dr
    let b = pdx * cdx + pdy * cdy + self.r0 * dr
    let c = pdx * pdx + pdy * pdy - self.r0 * self.r0
    if f64.abs(a) < 1.0e-12 {
      if b == 0.0 { return NOTHING }
      let t = c / (2.0 * b)
      return if self.r0 + t * dr >= 0.0 { t } else { NOTHING }
    }
    let disc = b * b - a * c
    if disc < 0.0 { return NOTHING }
    let root = f64.sqrt(disc)
    let t1 = f64.max((b + root) / a, (b - root) / a)
    let t2 = f64.min((b + root) / a, (b - root) / a)
    if self.r0 + t1 * dr >= 0.0 { return t1 }
    if self.r0 + t2 * dr >= 0.0 { return t2 }
    return NOTHING
  }
}

/// Encodes "nothing painted here" apart from every real parameter.
const NOTHING: f64 = -1.0e300

fn fixedOffset(stops: &[Stop], index: usize) -> f64 {
  let mut offset = clamp01(stops[0].offset)
  let mut i: usize = 1
  while i <= index {
    offset = f64.max(offset, clamp01(stops[i].offset))
    i = i + 1
  }
  return offset
}

fn mix(a: Rgba8, b: Rgba8, w: f64, premultiplied: bool) -> Rgba8 {
  let aa = u8.toF64(a.a) / 255.0
  let ba = u8.toF64(b.a) / 255.0
  let alpha = aa + (ba - aa) * w
  if premultiplied {
    let r = u8.toF64(a.r) * aa + (u8.toF64(b.r) * ba - u8.toF64(a.r) * aa) * w
    let g = u8.toF64(a.g) * aa + (u8.toF64(b.g) * ba - u8.toF64(a.g) * aa) * w
    let bl = u8.toF64(a.b) * aa + (u8.toF64(b.b) * ba - u8.toF64(a.b) * aa) * w
    return Rgba8 { r: toByte(r / 255.0), g: toByte(g / 255.0), b: toByte(bl / 255.0), a: toByte(alpha) }
  }
  let r = u8.toF64(a.r) + (u8.toF64(b.r) - u8.toF64(a.r)) * w
  let g = u8.toF64(a.g) + (u8.toF64(b.g) - u8.toF64(a.g)) * w
  let bl = u8.toF64(a.b) + (u8.toF64(b.b) - u8.toF64(a.b)) * w
  return Rgba8 { r: toByte(r * alpha / 255.0), g: toByte(g * alpha / 255.0), b: toByte(bl * alpha / 255.0), a: toByte(alpha) }
}

fn spreadParameter(t: f64, spread: u8) -> f64 {
  if spread == SPREAD_REPEAT { return t - f64.floor(t) }
  if spread == SPREAD_REFLECT {
    let m = t - 2.0 * f64.floor(t * 0.5)
    return if m > 1.0 { 2.0 - m } else { m }
  }
  return clamp01(t)
}

impl Shader for Gradient {
  fn shade(self: &Self, x: u32, y: u32) -> Rgba8 {
    if !self.isPaintable() { return Rgba8.make(0, 0, 0, 0) }
    let ramp = self.ramp.asSlice()
    let mut index = RAMP_SIZE - 1
    if !self.single {
      let p = self.inverse.apply(Point.make(u32.toF64(x) + 0.5, u32.toF64(y) + 0.5))
      let t = self.parameter(p)
      if t == NOTHING || !f64.isFinite(t) { return Rgba8.make(0, 0, 0, 0) }
      let s = spreadParameter(t, self.spread)
      index = f64.toUsize(f64.floor(s * usize.toF64(RAMP_SIZE - 1) + 0.5))
    }
    return Rgba8 { r: ramp[index * 4], g: ramp[index * 4 + 1], b: ramp[index * 4 + 2], a: ramp[index * 4 + 3] }
  }
}

pub const SAMPLE_NEAREST: u8 = 0
pub const SAMPLE_BILINEAR: u8 = 1
pub const EXTEND_CLAMP: u8 = 0
pub const EXTEND_REPEAT: u8 = 1

/// A premultiplied image placed by `transform` (image pixel space to device space). `EXTEND_CLAMP`
/// suits `image` (clip with its rectangle); `EXTEND_REPEAT` suits pattern tiles.
pub struct ImagePattern<'a> {
  image: &'a Pixmap,
  inverse: Affine,
  valid: bool,
  sampling: u8,
  extend: u8,
}
impl<'a> ImagePattern<'a> {
  pub fn make(image: &'a Pixmap, transform: &Affine, sampling: u8, extend: u8) -> ImagePattern<'a> {
    let mut inverse = Affine.identity()
    let mut valid = image.width() > 0 && image.height() > 0
    if let Option<Affine>.Some { value: found } = transform.invert() { inverse = found } else { valid = false }
    return ImagePattern { image: image, inverse: inverse, valid: valid, sampling: sampling, extend: extend }
  }
  fn texel(self: &Self, x: i64, y: i64) -> Rgba8 {
    let w = u32.toI64(self.image.width())
    let h = u32.toI64(self.image.height())
    let mut tx = x
    let mut ty = y
    if self.extend == EXTEND_REPEAT {
      tx = ((x % w) + w) % w
      ty = ((y % h) + h) % h
    } else {
      tx = if x < 0 { 0 } else if x >= w { w - 1 } else { x }
      ty = if y < 0 { 0 } else if y >= h { h - 1 } else { y }
    }
    return self.image.pixel(i64.toU32(tx), i64.toU32(ty))
  }
}
impl<'a> Shader for ImagePattern<'a> {
  fn shade(self: &Self, x: u32, y: u32) -> Rgba8 {
    if !self.valid { return Rgba8.make(0, 0, 0, 0) }
    let p = self.inverse.apply(Point.make(u32.toF64(x) + 0.5, u32.toF64(y) + 0.5))
    if !p.isFinite() || f64.abs(p.x) > 1.0e15 || f64.abs(p.y) > 1.0e15 { return Rgba8.make(0, 0, 0, 0) }
    if self.sampling == SAMPLE_NEAREST {
      return self.texel(f64.toI64(f64.floor(p.x)), f64.toI64(f64.floor(p.y)))
    }
    let fx = p.x - 0.5
    let fy = p.y - 0.5
    let x0 = f64.floor(fx)
    let y0 = f64.floor(fy)
    let wx = fx - x0
    let wy = fy - y0
    let ix = f64.toI64(x0)
    let iy = f64.toI64(y0)
    let a = self.texel(ix, iy)
    let b = self.texel(ix + 1, iy)
    let c = self.texel(ix, iy + 1)
    let d = self.texel(ix + 1, iy + 1)
    return Rgba8 {
      r: bilerp(a.r, b.r, c.r, d.r, wx, wy), g: bilerp(a.g, b.g, c.g, d.g, wx, wy),
      b: bilerp(a.b, b.b, c.b, d.b, wx, wy), a: bilerp(a.a, b.a, c.a, d.a, wx, wy),
    }
  }
}

fn bilerp(a: u8, b: u8, c: u8, d: u8, wx: f64, wy: f64) -> u8 {
  let top = u8.toF64(a) + (u8.toF64(b) - u8.toF64(a)) * wx
  let bottom = u8.toF64(c) + (u8.toF64(d) - u8.toF64(c)) * wx
  return f64.toU8(f64.floor(top + (bottom - top) * wy + 0.5))
}

/// Composites `shader` source-over into `target` through `coverage`, scaled by `opacity`
/// (0..=255, for `fill-opacity` and `stroke-opacity`).
pub fn fill<S: Shader>(target: &mut Pixmap, coverage: &Coverage, shader: &S, opacity: u8) -> () {
  if opacity == 0 { return }
  let width = minU32(target.width(), coverage.width())
  let height = minU32(target.height(), coverage.height())
  let stride = u32.toUsize(target.width()) * 4
  let fullMask = u8.toU32(opacity)
  let d = target.dataMut()
  let fills = coverage.fills()
  let mut f: usize = 0
  while f < fills.length {
    let span = fills[f]
    let mut y = span.y
    while y < span.y + BAND && y < height {
      let mut x = span.x
      while x < span.x + span.width && x < width {
        let source = masked(shader.shade(x, y), fullMask)
        over(&mut d, u32.toUsize(y) * stride + u32.toUsize(x) * 4, source)
        x = x + 1
      }
      y = y + 1
    }
    f = f + 1
  }
  let alphas = coverage.alphas()
  let strips = coverage.strips()
  let mut s: usize = 0
  while s < strips.length {
    let strip = strips[s]
    let mut column: u32 = 0
    while column < strip.width && strip.x + column < width {
      let base = u32.toUsize(strip.alphaOffset + column * BAND)
      let mut row: u32 = 0
      while row < BAND && strip.y + row < height {
        let mask = div255(u8.toU32(alphas[base + u32.toUsize(row)]) * fullMask)
        if mask != 0 {
          let x = strip.x + column
          let y = strip.y + row
          over(&mut d, u32.toUsize(y) * stride + u32.toUsize(x) * 4, masked(shader.shade(x, y), mask))
        }
        row = row + 1
      }
      column = column + 1
    }
    s = s + 1
  }
}

fn masked(color: Rgba8, mask: u32) -> Rgba8 {
  if mask == 255 { return color }
  return Rgba8 {
    r: u32.toU8(div255(u8.toU32(color.r) * mask)), g: u32.toU8(div255(u8.toU32(color.g) * mask)),
    b: u32.toU8(div255(u8.toU32(color.b) * mask)), a: u32.toU8(div255(u8.toU32(color.a) * mask)),
  }
}
