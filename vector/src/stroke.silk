//! Tolerance-controlled stroke outlines. Source derivatives, not flattened chords, determine
//! caps and joins. Fill the output with the nonzero rule. Tolerance is in target coordinates;
//! the returned outline remains in source coordinates. See docs/scene-renderer.md.
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u32
import silk.num.usize
import geometry { Point, Rect, Affine }
import path { Path, MOVE, LINE, QUAD, CUBIC, ARC, CLOSE }
import stroke_curve { Curve, norm }
import stroke_space_curve { StrokeCurve }
import stroke_arcs
import geometry_error { GeometryError, INVALID_INPUT, NUMERIC_LIMIT, ACCURACY_LIMIT }
import projective { Homography, strokeScale }
import projective

pub const JOIN_MITER: u8 = 0

pub const JOIN_MITER_CLIP: u8 = 1

pub const JOIN_ROUND: u8 = 2

pub const JOIN_BEVEL: u8 = 3

pub const JOIN_ARCS: u8 = 4

pub const CAP_BUTT: u8 = 0

pub const CAP_ROUND: u8 = 1

pub const CAP_SQUARE: u8 = 2

const MAX_POINTS: usize = 1048576

const MAX_DEPTH: u32 = 40

pub struct Stroke {
  pub width: f64,
  pub join: u8,
  pub cap: u8,
  pub miterLimit: f64,
  pub dashOffset: f64,
  dashes: List<f64>,
}

impl Stroke {
  pub fn make(width: f64) -> Stroke {
    return Stroke {
      width: width,
      join: JOIN_MITER,
      cap: CAP_BUTT,
      miterLimit: 4.0,
      dashOffset: 0.0,
      dashes: List<f64>.make(),
    }
  }

  pub fn dashArray(self: &Self) -> &[f64] {
    return self.dashes.asSlice()
  }

  /// An odd count repeats. Invalid or all-zero arrays disable dashing.
  pub effect fn setDashes(self: &mut Self, values: &[f64]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.dashes.clear()
    let mut sum: f64 = 0.0
    let mut i: usize = 0
    while i < values.length {
      if !(values[i] >= 0.0) || !f64.isFinite(values[i]) {
        return
      }
      sum = sum + values[i]
      i = i + 1
    }
    if !(sum > 0.0) || !f64.isFinite(sum) {
      return
    }
    run self.dashes.appendSlice(values)
    if values.length % 2 == 1 {
      run self.dashes.appendSlice(values)
    }
  }
}

/// Conservative target-space stroke box, with every face at most `tolerance` outside the
/// mathematical box on successful return. Empty geometry has an explicit flag, not a sentinel.
pub struct StrokeBounds {
  pub empty: bool,
  pub bounds: Rect
}

impl Copy for StrokeBounds {}

struct Subpath {
  start: usize,
  count: usize,
  closed: bool
}

impl Copy for Subpath {}

struct Vertex {
  point: Point,
  incoming: Point,
  outgoing: Point,
  curvatureIn: f64,
  curvatureOut: f64,
  corner: bool,
  curve: usize,
  parameter: f64,
}

impl Copy for Vertex {}

struct Pen {
  half: f64,
  join: u8,
  cap: u8,
  miterLimit: f64,
  tolerance: f64
}

impl Copy for Pen {}

fn add(a: Point, b: Point, scale: f64) -> Point {
  return Point.make(a.x + b.x * scale, a.y + b.y * scale)
}

fn normal(a: Point) -> Point {
  return Point.make(0.0 - a.y, a.x)
}

fn reverse(a: Point) -> Point {
  return Point.make(0.0 - a.x, 0.0 - a.y)
}

fn dot(a: Point, b: Point) -> f64 {
  return a.x * b.x + a.y * b.y
}

fn cross(a: Point, b: Point) -> f64 {
  return a.x * b.y - a.y * b.x
}

fn distance(a: Point, b: Point) -> f64 {
  return norm(a.x - b.x, a.y - b.y)
}

fn same(a: Point, b: Point) -> bool {
  return a.x == b.x && a.y == b.y
}

fn unit(a: Point) -> Point {
  let n = norm(a.x, a.y)
  return Point.make(a.x / n, a.y / n)
}

// A source boundary need not be a discontinuity of the offset/cap geometry.
// For forward unit tangents with angle <= pi/2, the miter excursion from either
// offset is h*tan(angle/2) <= h*|incoming-outgoing|. A square cap's rotation costs
// at most sqrt(2)*h*|incoming-outgoing|; bevel/round caps and joins cost less.
// Four times that tangent jump covers both the join and cap change. Dividing the
// join budget across all vertices also bounds transitions crossing several joins.
// Osculating-circle joins need more than tangent continuity when curvature jumps;
// retain their refusal unless the existing join emitter itself sees equal tangents.
fn dashSmooth(v: Vertex, pen: Pen, joinBudget: f64) -> bool {
  if !v.corner || same(v.incoming, v.outgoing) {
    return true
  }
  return pen.join != JOIN_ARCS && dot(v.incoming, v.outgoing) >= 0.0
    && 4.0 * pen.half * distance(v.incoming, v.outgoing) <= joinBudget
}

// Across a closed seam, uncertainty may move an existing cap, but must not
// create/delete a capped component or split a continuously painted join.
// Matching the state after the cut to the initial state makes the last fragment
// an extension of the first dash (or a retraction of the final dash). The three
// interval bounds exclude a second transition inside the uncertainty window.
fn dashSeamTransition(
  pattern: &[f64],
  index: usize,
  on: bool,
  initialOn: bool,
  initialRemaining: f64,
  error: f64,
) -> bool {
  return on != initialOn && initialRemaining > 2.0 * error && pattern[index] > 2.0 * error
    && pattern[(index + 1) % pattern.length] > 2.0 * error
}

fn at(vertices: &[Vertex], sub: Subpath, i: usize, backwards: bool) -> Vertex {
  let mut v = vertices[if backwards {
    sub.start + sub.count - 1 - i
  } else {
    sub.start + i
  }]
  if backwards {
    let d = v.incoming
    let k = v.curvatureIn
    v.incoming = reverse(v.outgoing)
    v.outgoing = reverse(d)
    v.curvatureIn = 0.0 - v.curvatureOut
    v.curvatureOut = 0.0 - k
  }
  return v
}

/// Normalizing first avoids both squaring overflow and cancellation in the discriminant.
fn maxScale(m: &Affine) -> f64 {
  let s = f64.max(f64.max(f64.abs(m.a), f64.abs(m.b)), f64.max(f64.abs(m.c), f64.abs(m.d)))
  if s == 0.0 {
    return 0.0
  }
  let a = m.a / s
  let b = m.b / s
  let c = m.c / s
  let d = m.d / s
  return s * ((norm(a + d, b - c) + norm(a - d, b + c)) * 0.5)
}

/// Total analytic centerline length in source coordinates, including every contour
/// and closing segment. tolerance is a positive finite absolute error budget for
/// the entire path. No stroke style, device transform, allocation or mutable state
/// is involved. Uncertifiable finite precision fails with ACCURACY_LIMIT.
pub effect fn measureLength(path: &Path, tolerance: f64) -> LengthEstimate
  ! GeometryError {
  return run measureCenterline(path, &Homography.fromAffine(&Affine.identity()), tolerance, false)
}

/// Total positive-w centerline length in an independent stroke host. Entirely
/// hidden segments contribute zero. No clipping or epsilon-w cutoff is used;
/// connected eye-plane crossings fail rather than returning a partial length.
/// INVALID_INPUT rejects nonfinite inputs or nonpositive/nonfinite tolerance;
/// NUMERIC_LIMIT rejects nonfinite arithmetic or a detected eye-plane crossing;
/// ACCURACY_LIMIT rejects unresolved visibility or unattainable error budgets.
pub effect fn measureLengthInSpace(
  path: &Path,
  sourceToStroke: &Homography,
  tolerance: f64,
) -> LengthEstimate
  ! GeometryError {
  return run measureCenterline(path, sourceToStroke, tolerance, true)
}

/// Certified absolute uncertainty, including accumulation and finite precision.
/// A zero value is only an exactly empty centerline when error is also zero.
pub struct LengthEstimate {
  pub value: f64,
  pub error: f64,
}

impl Copy for LengthEstimate {}

effect fn addLengths(a: LengthEstimate, b: LengthEstimate) -> LengthEstimate
  ! GeometryError {
  let value = a.value + b.value
  let error = (a.error + b.error + value * 8.881784197001252e-16) * 1.000000000000001
  if !f64.isFinite(value) || !f64.isFinite(error) {
    fail GeometryError { code: NUMERIC_LIMIT }
  }
  return LengthEstimate { value: value, error: error }
}

// Bound endpoint evaluation separately from geometric chord deficit. Source
// arithmetic must still be charged when a homography cancels large coordinates.
fn lengthPointError(source: &Curve) -> f64 {
  let magnitude = norm(source.p0.x, source.p0.y) + norm(source.p1.x, source.p1.y)
    + norm(source.p2.x, source.p2.y)
    + norm(source.p3.x, source.p3.y)
  let phase = if source.kind == ARC {
    (norm(source.p1.x, source.p1.y) + norm(source.p2.x, source.p2.y)) * f64.abs(source.sweep)
  } else {
    0.0
  }
  return (magnitude + phase) * 2.8421709430404007e-14
}

effect fn lengthInterval(
  curve: &StrokeCurve,
  source: &StrokeCurve,
  mapping: &Homography,
  sourceError: f64,
  mapped: bool,
  a: f64,
  b: f64,
  budget: f64,
  depth: u32,
  visits: &mut usize,
) -> LengthEstimate
  ! GeometryError {
  if visits.* >= MAX_POINTS {
    fail GeometryError { code: ACCURACY_LIMIT }
  }
  visits.* = visits.* + 1
  let weights = curve.weightRange(a, b)
  if !weights.isFinite() {
    fail GeometryError { code: NUMERIC_LIMIT }
  }
  if weights.y <= 0.0 {
    return LengthEstimate { value: 0.0, error: 0.0 }
  }
  if weights.x > 0.0 {
    let start = curve.point(a)
    let end = curve.point(b)
    let chord = distance(start, end)
    if !start.isFinite() || !end.isFinite() || !f64.isFinite(chord) {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    let mut pointError = sourceError
    if mapped {
      let w = source.functional(a, b, mapping.wx, mapping.wy, mapping.ww)
      if w.x > 0.0 {
        let x = source.functional(a, b, mapping.xx, mapping.xy, mapping.xw)
        let y = source.functional(a, b, mapping.yx, mapping.yy, mapping.yw)
        let numerator = norm(
          f64.max(f64.abs(x.x), f64.abs(x.y)),
          f64.max(f64.abs(y.x), f64.abs(y.y)),
        )
        let matrix = norm(norm(mapping.xx, mapping.xy), norm(mapping.yx, mapping.yy))
        pointError = sourceError
          * (matrix / w.x + numerator / w.x * norm(mapping.wx, mapping.wy) / w.x)
      } else {
        pointError = 1.0 / 0.0
      }
    }
    let rounding = 2.0 * (pointError + curve.anchorError() + curve.precisionError(a, b))
      + chord * 8.881784197001252e-16
    let error = (curve.lengthError(a, b) + rounding) * 1.000000000001
    if error <= budget * 0.5 {
      return LengthEstimate { value: chord, error: error }
    }

    // A smaller interval cannot repair source-space coordinate precision.
    if !mapped && rounding > budget {
      fail GeometryError { code: ACCURACY_LIMIT }
    }
  } else {
    let startWeight = curve.weightAt(a)
    let endWeight = curve.weightAt(b)
    if (startWeight > 0.0 && endWeight <= 0.0) || (endWeight > 0.0 && startWeight <= 0.0) {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
  }
  let middle = (a + b) * 0.5
  if depth >= MAX_DEPTH || middle == a || middle == b || !(budget * 0.5 > 0.0) {
    fail GeometryError { code: ACCURACY_LIMIT }
  }
  let left = run lengthInterval(
    curve,
    source,
    mapping,
    sourceError,
    mapped,
    a,
    middle,
    budget * 0.5,
    depth + 1,
    &mut visits,
  )
  let right = run lengthInterval(
    curve,
    source,
    mapping,
    sourceError,
    mapped,
    middle,
    b,
    budget * 0.5,
    depth + 1,
    &mut visits,
  )
  let result = run addLengths(left, right)
  if result.error > budget {
    fail GeometryError { code: ACCURACY_LIMIT }
  }
  return result
}

effect fn measureCenterline(
  path: &Path,
  mapping: &Homography,
  tolerance: f64,
  mapped: bool,
) -> LengthEstimate
  ! GeometryError {
  if !(tolerance > 0.0) || !f64.isFinite(tolerance) || !mapping.isFinite() {
    fail GeometryError { code: INVALID_INPUT }
  }
  let points = path.pointList()
  let verbs = path.verbList()
  let mut p: usize = 0
  while p < points.length {
    if !points[p].isFinite() {
      fail GeometryError { code: INVALID_INPUT }
    }
    p = p + 1
  }
  if verbs.length == 0 {
    return LengthEstimate { value: 0.0, error: 0.0 }
  }

  // At most one analytic segment per verb, including CLOSE. Half the total
  // budget is reserved for combining independently certified segment estimates.
  let budget = tolerance / usize.toF64(verbs.length) * 0.5
  let mut total = LengthEstimate { value: 0.0, error: 0.0 }
  let mut current = Point.make(0.0, 0.0)
  let mut start = current
  let mut open = false
  let mut visits: usize = 0
  p = 0
  let mut i: usize = 0
  while i < verbs.length {
    let verb = verbs[i]
    if verb == MOVE {
      current = points[p]
      start = current
      open = true
      p = p + 1
    } else {
      let mut curve = Curve.line(current, current)
      if verb == CLOSE {
        if open {
          curve = Curve.line(current, start)
          current = start
          open = false
        }
      } else {
        if !open {
          start = current
          open = true
        }
        if verb == LINE {
          curve = Curve.line(current, points[p])
          current = points[p]
          p = p + 1
        } else if verb == QUAD {
          curve = Curve.quad(current, points[p], points[p + 1])
          current = points[p + 1]
          p = p + 2
        } else if verb == CUBIC {
          curve = Curve.cubic(current, points[p], points[p + 1], points[p + 2])
          current = points[p + 2]
          p = p + 3
        } else if verb == ARC {
          curve = Curve.ellipse(
            points[p],
            points[p + 1],
            points[p + 2],
            points[p + 3].x,
            points[p + 3].y,
            current,
            points[p + 4],
          )
          current = points[p + 4]
          p = p + 5
        }
      }
      let source = StrokeCurve.plain(curve)

      // Source-degenerate segments remain empty even on the eye plane.
      if !(curve.anchorError() == 0.0 && (source.collapsed() || curve.firstBound() == 0.0)) {
        let measured = if mapped {
          StrokeCurve.mapped(curve, mapping)
        } else {
          source
        }
        let length = run lengthInterval(
          &measured,
          &source,
          mapping,
          lengthPointError(&curve),
          mapped,
          0.0,
          1.0,
          budget,
          0,
          &mut visits,
        )
        total = run addLengths(total, length)
        if total.error > tolerance {
          fail GeometryError { code: ACCURACY_LIMIT }
        }
      }
    }
    i = i + 1
  }
  return total
}

/// Reusable storage; neither bounds nor repeated strokes need a second stroker allocation.
pub struct Stroker {
  vertices: List<Vertex>,
  subpaths: List<Subpath>,
  curves: List<StrokeCurve>,
  dashVertices: List<Vertex>,
  dashSubpaths: List<Subpath>,
  scratch: Path,
  dashMetric: f64,
  inSpace: bool,
  sourceToStroke: Homography,
  strokeToDevice: Homography,
  deviceClip: Rect,
  deviceTolerance: f64,
  clipSpace: bool,
  spacePending: bool,
  spaceBroken: bool,
  spaceDashed: bool,
}

impl Stroker {
  pub fn make() -> Stroker {
    return Stroker {
      vertices: List<Vertex>.make(),
      subpaths: List<Subpath>.make(),
      curves: List<StrokeCurve>.make(),
      dashVertices: List<Vertex>.make(),
      dashSubpaths: List<Subpath>.make(),
      scratch: Path.make(),
      dashMetric: 1.0,
      inSpace: false,
      sourceToStroke: Homography.fromAffine(&Affine.identity()),
      strokeToDevice: Homography.fromAffine(&Affine.identity()),
      deviceClip: Rect.make(0.0, 0.0, 0.0, 0.0),
      deviceTolerance: 1.0,
      clipSpace: false,
      spacePending: false,
      spaceBroken: false,
      spaceDashed: false,
    }
  }

  /// Stroke an analytic centerline in an independent stroke host. Width, dashes,
  /// caps and joins use host coordinates. Appends a host-space outline whose
  /// projection error is <= tolerance inside deviceClip. Errors invalidate
  /// partial output. Reserve a separate tolerance for projective.fill.
  pub effect fn strokeInSpace(
    self: &mut Self,
    path: &Path,
    style: &Stroke,
    sourceToStroke: &Homography,
    strokeToDevice: &Homography,
    deviceClip: Rect,
    tolerance: f64,
    out: &mut Path,
  ) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    run self.configureSpace(sourceToStroke, strokeToDevice, deviceClip, tolerance, true)
    let scale = run spaceScale(strokeToDevice, deviceClip, tolerance)
    let pen = run prepareScaled(path, style, scale, tolerance)
    if style.width == 0.0 || deviceClip.x0 == deviceClip.x1 || deviceClip.y0 == deviceClip.y1
      || (strokeToDevice.wx == 0.0 && strokeToDevice.wy == 0.0 && strokeToDevice.ww <= 0.0) {
      return
    }
    run self.emit(path, style, pen, &mut out)
    run validateOutput(&out.*, &Affine.identity(), pen.tolerance)
  }

  /// Unclipped device-space bounds of the host-space stroke. ignoreDashes
  /// selects undashed reference-box geometry. Unbounded connected geometry fails.
  pub effect fn boundsInSpace(
    self: &mut Self,
    path: &Path,
    style: &Stroke,
    sourceToStroke: &Homography,
    strokeToDevice: &Homography,
    tolerance: f64,
    ignoreDashes: bool,
  ) -> StrokeBounds
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    run self.configureSpace(
      sourceToStroke,
      strokeToDevice,
      Rect.make(0.0, 0.0, 0.0, 0.0),
      tolerance,
      false,
    )
    if strokeToDevice.wx == 0.0 && strokeToDevice.wy == 0.0 {
      if strokeToDevice.ww <= 0.0 {
        drop run prepareScaled(path, style, 1.0, tolerance)
        return StrokeBounds { empty: true, bounds: Rect.make(0.0, 0.0, 0.0, 0.0) }
      }
      let affine = spaceAffine(strokeToDevice)
      return run self.affineBounds(path, style, &affine, tolerance, ignoreDashes)
    }
    return run self.measureSpace(path, style, strokeToDevice, tolerance, ignoreDashes)
  }

  effect fn configureSpace(
    self: &mut Self,
    source: &Homography,
    target: &Homography,
    clip: Rect,
    tolerance: f64,
    clipped: bool,
  ) -> ()
    ! GeometryError {
    if !source.isFinite() || !target.isFinite() || !(tolerance > 0.0) || !f64.isFinite(tolerance)
      || !Point.make(clip.x0, clip.y0).isFinite()
      || !Point.make(clip.x1, clip.y1).isFinite()
      || clip.x0 > clip.x1
      || clip.y0 > clip.y1 {
      fail GeometryError { code: INVALID_INPUT }
    }
    self.inSpace = true
    self.sourceToStroke = source.*
    self.strokeToDevice = target.*
    self.deviceClip = clip
    self.deviceTolerance = tolerance
    self.clipSpace = clipped
  }

  /// Appends a user-space outline, with target-space geometric error no greater than tolerance.
  /// Errors leave partially appended output unusable. Zero width is empty; negative width is invalid.
  pub effect fn stroke(
    self: &mut Self,
    path: &Path,
    style: &Stroke,
    transform: &Affine,
    tolerance: f64,
    out: &mut Path,
  ) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    self.inSpace = false
    let pen = run prepare(path, style, transform, tolerance)
    if style.width == 0.0 || maxScale(transform) == 0.0 {
      return
    }
    run self.emit(path, style, pen, &mut out)
    run validateOutput(&out.*, transform, tolerance)
  }

  /// SVG 2 §13.5: construct offsets, caps, joins and dash lengths in source space.
  /// The result is a source-space outline, NOT a stroked projected centerline.
  /// Within `clip`, projection changes this outline by at most `tolerance`.
  /// Reserve a separate budget for the subsequent projective.fill tessellation.
  /// Uncertifiable projection/source precision fails explicitly, never using epsilon-w.
  pub effect fn strokeProjective(
    self: &mut Self,
    path: &Path,
    style: &Stroke,
    transform: &Homography,
    clip: Rect,
    tolerance: f64,
    out: &mut Path,
  ) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    self.inSpace = false
    if !transform.isFinite() || !(tolerance > 0.0) || !f64.isFinite(tolerance)
      || !Point.make(clip.x0, clip.y0).isFinite()
      || !Point.make(clip.x1, clip.y1).isFinite()
      || clip.x0 > clip.x1
      || clip.y0 > clip.y1 {
      fail GeometryError { code: INVALID_INPUT }
    }
    if transform.wx == 0.0 && transform.wy == 0.0 {
      if transform.ww <= 0.0 {
        drop run prepare(path, style, &Affine.identity(), tolerance)
        return
      }
      let affine = Affine {
        a: transform.xx / transform.ww,
        b: transform.yx / transform.ww,
        c: transform.xy / transform.ww,
        d: transform.yy / transform.ww,
        e: transform.xw / transform.ww,
        f: transform.yw / transform.ww,
      }
      if !f64.isFinite(affine.a) || !f64.isFinite(affine.b) || !f64.isFinite(affine.c)
        || !f64.isFinite(affine.d)
        || !f64.isFinite(affine.e)
        || !f64.isFinite(affine.f) {
        fail GeometryError { code: NUMERIC_LIMIT }
      }
      run self.stroke(path, style, &affine, tolerance, &mut out)
      return
    }
    let scale = run strokeScale(transform, clip, tolerance)
    let pen = run prepareScaled(path, style, scale, tolerance)
    if style.width == 0.0 || clip.x0 == clip.x1 || clip.y0 == clip.y1 {
      return
    }
    run self.emit(path, style, pen, &mut out)

    // Validate source arithmetic, not a fictitious enormous affine target.
    run validateOutput(&out.*, &Affine.identity(), pen.tolerance)
  }

  /// Unclipped projective stroke-box (SVG 2 §8.10). Each successful face is
  /// conservative and at most tolerance outside the actual projected stroke.
  /// `ignoreDashes` selects the undashed stroke-box reference geometry.
  /// Independent contours behind the eye plane are ignored; a connected
  /// crossing or uncertifiable numeric case fails instead of clipping the box.
  pub effect fn boundsProjective(
    self: &mut Self,
    path: &Path,
    style: &Stroke,
    transform: &Homography,
    tolerance: f64,
    ignoreDashes: bool,
  ) -> StrokeBounds
    ! GeometryError | OutOfMemoryError
    ? &mut Allocator {
    self.inSpace = false
    if !transform.isFinite() || !(tolerance > 0.0) || !f64.isFinite(tolerance) {
      fail GeometryError { code: INVALID_INPUT }
    }
    if transform.wx == 0.0 && transform.wy == 0.0 {
      if transform.ww <= 0.0 {
        drop run prepare(path, style, &Affine.identity(), tolerance)
        return StrokeBounds { empty: true, bounds: Rect.make(0.0, 0.0, 0.0, 0.0) }
      }
      let affine = Affine {
        a: transform.xx / transform.ww,
        b: transform.yx / transform.ww,
        c: transform.xy / transform.ww,
        d: transform.yy / transform.ww,
        e: transform.xw / transform.ww,
        f: transform.yw / transform.ww,
      }
      if !f64.isFinite(affine.a) || !f64.isFinite(affine.b) || !f64.isFinite(affine.c)
        || !f64.isFinite(affine.d)
        || !f64.isFinite(affine.e)
        || !f64.isFinite(affine.f) {
        fail GeometryError { code: NUMERIC_LIMIT }
      }
      return run self.bounds(path, style, &affine, tolerance, ignoreDashes)
    }
    return run self.measureSpace(path, style, transform, tolerance, ignoreDashes)
  }

  effect fn measureSpace(
    self: &mut Self,
    path: &Path,
    style: &Stroke,
    transform: &Homography,
    tolerance: f64,
    ignoreDashes: bool,
  ) -> StrokeBounds
    ! GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let mut sourceTolerance = tolerance
    let mut iteration: u32 = 0
    while iteration < 64 {
      let pen = run prepareScaled(path, style, 1.0, sourceTolerance)
      if style.width == 0.0 {
        return StrokeBounds { empty: true, bounds: Rect.make(0.0, 0.0, 0.0, 0.0) }
      }
      run self.outlineScratch(path, style, pen, ignoreDashes)
      run validateOutput(&self.scratch, &Affine.identity(), sourceTolerance)
      let region = run projective.strokeRegion(&self.scratch, transform, sourceTolerance)
      if !region.uncertain {
        if region.empty {
          return StrokeBounds { empty: true, bounds: Rect.make(0.0, 0.0, 0.0, 0.0) }
        }
        if sourceTolerance * region.scale <= tolerance * 0.0625 {
          let measured = run projective.bounds(&self.scratch, transform, tolerance * 0.25)
          if measured.empty {
            return StrokeBounds { empty: true, bounds: measured.bounds }
          }
          let mut box = measured.bounds

          // Source approximation <= tolerance/16; f64 curve bounds <=
          // tolerance/4. This padding covers the former and face arithmetic,
          // while their combined outward error remains strictly < tolerance.
          let pad = tolerance * 0.25
          box.x0 = box.x0 - pad
          box.y0 = box.y0 - pad
          box.x1 = box.x1 + pad
          box.y1 = box.y1 + pad
          if !Point.make(box.x0, box.y0).isFinite() || !Point.make(box.x1, box.y1).isFinite() {
            fail GeometryError { code: NUMERIC_LIMIT }
          }
          return StrokeBounds { empty: false, bounds: box }
        }
        sourceTolerance = f64.min(sourceTolerance * 0.25, tolerance * 0.03125 / region.scale)
      } else {
        sourceTolerance = sourceTolerance * 0.25
      }
      if !(sourceTolerance > 0.0) {
        fail GeometryError { code: ACCURACY_LIMIT }
      }
      iteration = iteration + 1
    }
    fail GeometryError { code: ACCURACY_LIMIT }
  }

  effect fn outlineScratch(
    self: &mut Self,
    path: &Path,
    style: &Stroke,
    pen: Pen,
    ignoreDashes: bool,
  ) -> ()
    ! GeometryError | OutOfMemoryError
    ? &mut Allocator {
    self.scratch.clear()
    run self.flatten(path, pen, !ignoreDashes && style.dashes.length() > 0)
    if !ignoreDashes && style.dashes.length() > 0 {
      run self.dash(style.dashes.asSlice(), style.dashOffset, pen)
      run outlines(
        self.dashVertices.asSlice(),
        self.dashSubpaths.asSlice(),
        self.curves.asSlice(),
        pen,
        &mut self.scratch,
      )
    } else {
      run outlines(
        self.vertices.asSlice(),
        self.subpaths.asSlice(),
        self.curves.asSlice(),
        pen,
        &mut self.scratch,
      )
    }
  }

  effect fn emit(self: &mut Self, path: &Path, style: &Stroke, pen: Pen, out: &mut Path) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    run self.flatten(path, pen, style.dashes.length() > 0)
    if style.dashes.length() > 0 {
      run self.dash(style.dashes.asSlice(), style.dashOffset, pen)
      run outlines(
        self.dashVertices.asSlice(),
        self.dashSubpaths.asSlice(),
        self.curves.asSlice(),
        pen,
        &mut out,
      )
    } else {
      run outlines(
        self.vertices.asSlice(),
        self.subpaths.asSlice(),
        self.curves.asSlice(),
        pen,
        &mut out,
      )
    }
  }

  /// Bounds the actual stroke in arbitrary affine target coordinates, not a transformed source
  /// AABB. `ignoreDashes` selects the undashed shape used by stroke-box reference geometry.
  pub effect fn bounds(
    self: &mut Self,
    path: &Path,
    style: &Stroke,
    transform: &Affine,
    tolerance: f64,
    ignoreDashes: bool,
  ) -> StrokeBounds
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    self.inSpace = false
    return run self.affineBounds(path, style, transform, tolerance, ignoreDashes)
  }

  effect fn affineBounds(
    self: &mut Self,
    path: &Path,
    style: &Stroke,
    transform: &Affine,
    tolerance: f64,
    ignoreDashes: bool,
  ) -> StrokeBounds
    ! GeometryError | OutOfMemoryError
    ? &mut Allocator {
    let pen = run prepare(path, style, transform, tolerance)
    if style.width == 0.0 {
      return StrokeBounds { empty: true, bounds: Rect.make(0.0, 0.0, 0.0, 0.0) }
    }
    run self.outlineScratch(path, style, pen, ignoreDashes)
    run validateOutput(&self.scratch, transform, tolerance)
    let points = self.scratch.pointList()
    if points.length == 0 {
      return StrokeBounds { empty: true, bounds: Rect.make(0.0, 0.0, 0.0, 0.0) }
    }
    let first = transform.apply(points[0])
    let mut box = Rect { x0: first.x, y0: first.y, x1: first.x, y1: first.y }
    let mut i: usize = 1
    while i < points.length {
      let p = transform.apply(points[i])
      box.x0 = f64.min(box.x0, p.x)
      box.y0 = f64.min(box.y0, p.y)
      box.x1 = f64.max(box.x1, p.x)
      box.y1 = f64.max(box.y1, p.y)
      i = i + 1
    }

    // The geometry budget is at most tolerance/4; half a tolerance covers both approximation
    // and guarded floating arithmetic, and keeps outward faces within the advertised tolerance.
    let pad = tolerance * 0.5
    box.x0 = box.x0 - pad
    box.y0 = box.y0 - pad
    box.x1 = box.x1 + pad
    box.y1 = box.y1 + pad
    if !Point.make(box.x0, box.y0).isFinite() || !Point.make(box.x1, box.y1).isFinite() {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    return StrokeBounds { empty: false, bounds: box }
  }

  effect fn beginSource(self: &mut Self, p: Point) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    self.spaceBroken = false
    self.spacePending = false
    if !self.inSpace {
      run self.begin(p)
      return
    }
    let h = &self.sourceToStroke
    let w = h.wx * p.x + h.wy * p.y + h.ww
    if !f64.isFinite(w) {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    if w <= 0.0 {
      self.spacePending = true
      self.spaceBroken = true
      return
    }
    let q = Point.make((h.xx * p.x + h.xy * p.y + h.xw) / w, (h.yx * p.x + h.yy * p.y + h.yw) / w)
    if !q.isFinite() {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    run self.begin(q)
  }

  // Reject only intervals whose complete stroke envelope is outside a homogeneous
  // device halfspace. The envelope includes square caps and limited/clipped joins.
  fn spaceOutside(self: &Self, curve: &StrokeCurve, a: f64, b: f64, pen: Pen) -> bool {
    let h = &self.strokeToDevice
    let clip = self.deviceClip
    let extent = pen.half * (pen.miterLimit + 2.0) + pen.tolerance
    return self.spacePlane(curve, a, b, h.wx, h.wy, h.ww, extent)
      || self.spacePlane(
        curve,
        a,
        b,
        h.xx - clip.x0 * h.wx,
        h.xy - clip.x0 * h.wy,
        h.xw - clip.x0 * h.ww,
        extent,
      )
      || self.spacePlane(
        curve,
        a,
        b,
        clip.x1 * h.wx - h.xx,
        clip.x1 * h.wy - h.xy,
        clip.x1 * h.ww - h.xw,
        extent,
      )
      || self.spacePlane(
        curve,
        a,
        b,
        h.yx - clip.y0 * h.wx,
        h.yy - clip.y0 * h.wy,
        h.yw - clip.y0 * h.ww,
        extent,
      )
      || self.spacePlane(
        curve,
        a,
        b,
        clip.y1 * h.wx - h.yx,
        clip.y1 * h.wy - h.yy,
        clip.y1 * h.ww - h.yw,
        extent,
      )
  }

  fn spacePlane(
    self: &Self,
    curve: &StrokeCurve,
    a: f64,
    b: f64,
    x: f64,
    y: f64,
    z: f64,
    extent: f64,
  ) -> bool {
    let padded = z + extent * norm(x, y)
    return self.spaceRange(curve, a, b, x, y, padded).y < 0.0
  }

  fn spaceRange(self: &Self, curve: &StrokeCurve, a: f64, b: f64, x: f64, y: f64, z: f64) -> Point {
    let h = &self.sourceToStroke
    let nx = curve.functional(a, b, h.xx, h.xy, h.xw)
    let ny = curve.functional(a, b, h.yx, h.yy, h.yw)
    let w = curve.functional(a, b, h.wx, h.wy, h.ww)
    let low = f64.min(x * nx.x, x * nx.y) + f64.min(y * ny.x, y * ny.y) + f64.min(z * w.x, z * w.y)
    let high = f64.max(x * nx.x, x * nx.y) + f64.max(y * ny.x, y * ny.y) + f64.max(z * w.x, z * w.y)
    let work = f64.abs(x) * f64.max(f64.abs(nx.x), f64.abs(nx.y))
      + f64.abs(y) * f64.max(f64.abs(ny.x), f64.abs(ny.y))
      + f64.abs(z) * f64.max(f64.abs(w.x), f64.abs(w.y))
    let guard = work * 2.8421709430404007e-14
    return Point.make(low - guard, high + guard)
  }

  // A projective output can send infinite host geometry to a finite limit.
  // Certify the diameter of the whole stroke envelope, including the new cap;
  // omit a tail only when both it and that cap fit in a tolerance/8 device disk.
  fn spaceTinyTail(self: &Self, curve: &StrokeCurve, a: f64, b: f64, pen: Pen) -> bool {
    if !(curve.weightAt(a) > 0.0 && !self.spacePending) && !(b < 1.0 && curve.weightAt(b) > 0.0) {
      return false
    }
    if self.spaceDashed {
      return false
    }
    let h = &self.strokeToDevice
    let extent = pen.half * (pen.miterLimit + 2.0) + pen.tolerance
    let hostW = curve.weightRange(a, b).y
    let centerW = self.spaceRange(curve, a, b, h.wx, h.wy, h.ww)
    let padW = extent * norm(h.wx, h.wy) * hostW
    let lowW = centerW.x - padW
    let highW = centerW.y + padW
    if !(lowW > 0.0) || !f64.isFinite(highW) {
      return false
    }
    let x = self.spaceRange(curve, a, b, h.xx, h.xy, h.xw)
    let y = self.spaceRange(curve, a, b, h.yx, h.yy, h.yw)
    let padX = extent * norm(h.xx, h.xy) * hostW
    let padY = extent * norm(h.yx, h.yy) * hostW
    let rx = quotientRadius(x.x - padX, x.y + padX, lowW, highW)
    let ry = quotientRadius(y.x - padY, y.y + padY, lowW, highW)
    return 2.0 * norm(rx, ry) <= self.deviceTolerance * 0.125
  }

  effect fn appendSpace(
    self: &mut Self,
    index: usize,
    a: f64,
    b: f64,
    depth: u32,
    pen: Pen,
    lengthBudget: f64,
  ) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    let curve = self.curves.asSlice()[index]
    let w = curve.weightRange(a, b)
    if !w.isFinite() {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    if w.y <= 0.0 {
      self.spacePending = true
      self.spaceBroken = true
      return
    }
    if !(w.x > 0.0) {
      if self.clipSpace
        && (self.spaceOutside(&curve, a, b, pen) || self.spaceTinyTail(&curve, a, b, pen)) {
        self.spacePending = true
        self.spaceBroken = true
        return
      }
      let middle = (a + b) * 0.5
      if depth >= MAX_DEPTH || middle == a || middle == b {
        fail GeometryError { code: ACCURACY_LIMIT }
      }
      run self.appendSpace(index, a, middle, depth + 1, pen, lengthBudget)
      run self.appendSpace(index, middle, b, depth + 1, pen, lengthBudget)
      return
    }
    let start = curve.point(a)
    if !start.isFinite() {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    if self.spacePending {
      // A dash origin beyond an infinite host arclength has no finite phase.
      if self.spaceDashed {
        fail GeometryError { code: ACCURACY_LIMIT }
      }
      run self.begin(start)
      let last = self.vertices.length() - 1
      let mut v = self.vertices.asSlice()[last]
      v.curve = index
      v.parameter = a
      self.vertices.set(last, v)
      self.spacePending = false
    }
    if curve.collapsed() {
      if curve.precisionError(a, b) > pen.tolerance * 0.015625 {
        fail GeometryError { code: ACCURACY_LIMIT }
      }
      return
    }
    let anchorError = curve.anchorError()
    if !f64.isFinite(anchorError) {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    if anchorError > pen.tolerance * 0.015625 {
      fail GeometryError { code: ACCURACY_LIMIT }
    }
    let last = self.vertices.length() - 1
    let mut v = self.vertices.asSlice()[last]
    v.outgoing = curve.tangent(a)
    v.curvatureOut = curve.curvature(a)
    if !v.outgoing.isFinite() || !f64.isFinite(v.curvatureOut) {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    self.vertices.set(last, v)
    run self.subdivide(index, a, b, 0, pen, lengthBudget)
    let end = self.vertices.length() - 1
    let mut e = self.vertices.asSlice()[end]
    e.corner = b == 1.0
    self.vertices.set(end, e)
  }

  effect fn begin(self: &mut Self, p: Point) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.subpaths.append(Subpath { start: self.vertices.length(), count: 1, closed: false })
    run self.vertices.append(
      Vertex {
        point: p,
        incoming: Point.make(1.0, 0.0),
        outgoing: Point.make(1.0, 0.0),
        curvatureIn: 0.0,
        curvatureOut: 0.0,
        corner: true,
        curve: 0,
        parameter: 0.0,
      },
    )
  }

  effect fn appendCurve(self: &mut Self, curve: Curve, pen: Pen, lengthBudget: f64) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    if self.inSpace {
      let mapped = StrokeCurve.mapped(curve, &self.sourceToStroke)
      let index = self.curves.length()
      run self.curves.append(mapped)
      run self.appendSpace(index, 0.0, 1.0, 0, pen, lengthBudget)
      return
    }
    let index = self.curves.length()
    run self.curves.append(StrokeCurve.plain(curve))
    let a = curve.point(0.0)
    let b = curve.point(1.0)
    let anchorError = curve.anchorError()
    if !f64.isFinite(anchorError) {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    if anchorError > pen.tolerance * 0.015625 {
      fail GeometryError { code: ACCURACY_LIMIT }
    }
    if curve.kind == LINE && same(a, b) {
      return
    }
    if curve.kind == ARC && curve.sweep == 0.0 && same(a, b) {
      return
    }
    if curve.kind != ARC && same(curve.p0, curve.p1) && same(curve.p1, curve.p2)
      && same(curve.p2, curve.p3) {
      return
    }
    let last = self.vertices.length() - 1
    let mut v = self.vertices.asSlice()[last]
    v.outgoing = curve.tangent(0.0)
    v.curvatureOut = curve.curvature(0.0)
    if !v.outgoing.isFinite() || norm(v.outgoing.x, v.outgoing.y) < 0.5
      || !f64.isFinite(v.curvatureOut) {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    self.vertices.set(last, v)
    run self.subdivide(index, 0.0, 1.0, 0, pen, lengthBudget)
    let end = self.vertices.length() - 1
    let mut e = self.vertices.asSlice()[end]
    e.corner = true
    self.vertices.set(end, e)
  }

  effect fn subdivide(
    self: &mut Self,
    index: usize,
    a: f64,
    b: f64,
    depth: u32,
    pen: Pen,
    lengthBudget: f64,
  ) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    let curve = self.curves.asSlice()[index]
    let error = curve.offsetError(a, b, pen.half) + curve.anchorError() + curve.precisionError(a, b)
    let lengthError = if lengthBudget > 0.0 {
      curve.lengthError(a, b)
    } else {
      0.0
    }
    if error <= pen.tolerance * 0.0625
      && (lengthBudget == 0.0 || lengthError <= lengthBudget * (b - a)) {
      let p = curve.point(b)
      let d = curve.tangent(b)
      let k = curve.curvature(b)
      if !p.isFinite() || !d.isFinite() || norm(d.x, d.y) < 0.5 || !f64.isFinite(k) {
        fail GeometryError { code: NUMERIC_LIMIT }
      }
      if self.vertices.length() >= MAX_POINTS {
        fail GeometryError { code: ACCURACY_LIMIT }
      }
      run self.vertices.append(
        Vertex {
          point: p,
          incoming: d,
          outgoing: d,
          curvatureIn: k,
          curvatureOut: k,
          corner: false,
          curve: index,
          parameter: b,
        },
      )
      let s = self.subpaths.length() - 1
      let sub = self.subpaths.asSlice()[s]
      self.subpaths.set(s, Subpath { start: sub.start, count: sub.count + 1, closed: false })
      return
    }
    let middle = (a + b) * 0.5
    if depth >= MAX_DEPTH || middle == a || middle == b {
      fail GeometryError { code: ACCURACY_LIMIT }
    }
    run self.subdivide(index, a, middle, depth + 1, pen, lengthBudget)
    run self.subdivide(index, middle, b, depth + 1, pen, lengthBudget)
  }

  fn closeCurrent(self: &mut Self) -> () {
    let index = self.subpaths.length() - 1
    let sub = self.subpaths.asSlice()[index]
    if sub.count <= 1 {
      return
    }
    let mut first = self.vertices.asSlice()[sub.start]
    let last = self.vertices.asSlice()[sub.start + sub.count - 1]
    first.incoming = last.incoming
    first.curvatureIn = last.curvatureIn
    first.curve = last.curve
    first.parameter = last.parameter
    self.vertices.set(sub.start, first)
    self.vertices.truncate(sub.start + sub.count - 1)
    self.subpaths.set(index, Subpath { start: sub.start, count: sub.count - 1, closed: true })
  }

  effect fn flatten(self: &mut Self, path: &Path, pen: Pen, dashed: bool) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    self.spaceDashed = dashed
    run self.flattenWithBudget(path, pen, 0.0)
    if !dashed || path.verbList().length == 0 {
      return
    }
    let mut metric: f64 = 1.0
    let mut s: usize = 0
    while s < self.subpaths.length() {
      let sub = self.subpaths.asSlice()[s]
      let count = if sub.closed {
        sub.count
      } else {
        sub.count - 1
      }
      let mut i: usize = 0
      while i < count {
        let a = self.vertices.asSlice()[sub.start + i]
        let b = self.vertices.asSlice()[sub.start + (i + 1) % sub.count]
        let curve = self.curves.asSlice()[b.curve]
        let start = if a.curve == b.curve && a.parameter < b.parameter {
          a.parameter
        } else {
          0.0
        }
        metric = f64.max(metric, curve.offsetMetric(start, b.parameter, pen.half))
        i = i + 1
      }
      s = s + 1
    }
    if !f64.isFinite(metric) {
      fail GeometryError { code: ACCURACY_LIMIT }
    }
    self.dashMetric = metric
    let budget = pen.tolerance * 0.00390625 / metric / usize.toF64(path.verbList().length)
    if !(budget > 0.0) {
      fail GeometryError { code: ACCURACY_LIMIT }
    }
    run self.flattenWithBudget(path, pen, budget)
  }

  effect fn flattenWithBudget(self: &mut Self, path: &Path, pen: Pen, lengthBudget: f64) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    self.vertices.clear()
    self.subpaths.clear()
    self.curves.clear()
    let verbs = path.verbList()
    let points = path.pointList()
    let mut current = Point.make(0.0, 0.0)
    let mut start = current
    let mut open = false
    let mut p: usize = 0
    let mut i: usize = 0
    while i < verbs.length {
      let verb = verbs[i]
      if verb == MOVE {
        current = points[p]
        start = current
        run self.beginSource(current)
        open = true
        p = p + 1
      } else if verb == CLOSE {
        if open {
          if !same(current, start) {
            run self.appendCurve(Curve.line(current, start), pen, lengthBudget)
          }
          if !self.inSpace || !self.spaceBroken {
            self.closeCurrent()
          }
          open = false
          current = start
        }
      } else {
        if !open {
          run self.beginSource(current)
          start = current
          open = true
        }
        if verb == LINE {
          run self.appendCurve(Curve.line(current, points[p]), pen, lengthBudget)
          current = points[p]
          p = p + 1
        } else if verb == QUAD {
          run self.appendCurve(Curve.quad(current, points[p], points[p + 1]), pen, lengthBudget)
          current = points[p + 1]
          p = p + 2
        } else if verb == CUBIC {
          run self.appendCurve(
            Curve.cubic(current, points[p], points[p + 1], points[p + 2]),
            pen,
            lengthBudget,
          )
          current = points[p + 2]
          p = p + 3
        } else if verb == ARC {
          let c = Curve.ellipse(
            points[p],
            points[p + 1],
            points[p + 2],
            points[p + 3].x,
            points[p + 3].y,
            current,
            points[p + 4],
          )
          run self.appendCurve(c, pen, lengthBudget)
          current = points[p + 4]
          p = p + 5
        }
      }
      i = i + 1
    }
  }

  effect fn dashBegin(self: &mut Self, v: Vertex) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.dashSubpaths.append(
      Subpath { start: self.dashVertices.length(), count: 0, closed: false },
    )
    run self.dashPush(v)
  }

  effect fn dashPush(self: &mut Self, v: Vertex) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let index = self.dashSubpaths.length() - 1
    let sub = self.dashSubpaths.asSlice()[index]
    if sub.count > 0
      && same(self.dashVertices.asSlice()[sub.start + sub.count - 1].point, v.point) {
      return
    }
    run self.dashVertices.append(v)
    self.dashSubpaths.set(index, Subpath { start: sub.start, count: sub.count + 1, closed: false })
  }

  effect fn cut(self: &Self, a: Vertex, b: Vertex, fraction: f64, pen: Pen) -> Vertex
    ! GeometryError {
    if fraction <= 0.0 {
      let mut v = a
      v.incoming = a.outgoing
      v.curvatureIn = a.curvatureOut
      v.corner = false
      return v
    }
    if fraction >= 1.0 {
      let mut v = b
      v.outgoing = b.incoming
      v.curvatureOut = b.curvatureIn
      v.corner = false
      return v
    }
    let curve = self.curves.asSlice()[b.curve]
    let start = if a.curve == b.curve && a.parameter < b.parameter {
      a.parameter
    } else {
      0.0
    }
    let mut lo = start
    let mut hi = b.parameter
    let chord = Point.make(b.point.x - a.point.x, b.point.y - a.point.y)
    let length = norm(chord.x, chord.y)
    let direction = unit(chord)
    let target = length * fraction
    let metric = self.dashMetric
    let mut i: u32 = 0

    // Invert projected distance, not t proportional to chord length: Bézier speed is nonuniform.
    while i < 64 {
      let t = (lo + hi) * 0.5
      let p = curve.point(t)
      let projected = (p.x - a.point.x) * direction.x + (p.y - a.point.y) * direction.y
      if f64.abs(projected - target) * metric <= pen.tolerance * 0.00390625 {
        let d = curve.tangent(t)
        let k = curve.curvature(t)
        return Vertex {
          point: p,
          incoming: d,
          outgoing: d,
          curvatureIn: k,
          curvatureOut: k,
          corner: false,
          curve: b.curve,
          parameter: t,
        }
      }
      if projected < target {
        lo = t
      } else {
        hi = t
      }
      i = i + 1
    }
    fail GeometryError { code: ACCURACY_LIMIT }
  }

  effect fn dash(self: &mut Self, pattern: &[f64], offset: f64, pen: Pen) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    self.dashVertices.clear()
    self.dashSubpaths.clear()
    let mut total: f64 = 0.0
    let mut i: usize = 0
    while i < pattern.length {
      total = total + pattern[i]
      i = i + 1
    }
    if !f64.isFinite(total) || !(total > 0.0) {
      fail GeometryError { code: INVALID_INPUT }
    }
    let mut s: usize = 0
    while s < self.subpaths.length() {
      let sub = self.subpaths.asSlice()[s]
      let mut phase = offset - total * f64.floor(offset / total)
      if !f64.isFinite(phase) {
        fail GeometryError { code: NUMERIC_LIMIT }
      }
      let mut index: usize = 0
      while phase > 0.0 && phase >= pattern[index] {
        phase = phase - pattern[index]
        index = (index + 1) % pattern.length
      }
      let mut remaining = pattern[index] - phase
      let mut on = index % 2 == 0
      let initialOn = on
      let initialRemaining = remaining
      let joinBudget = pen.tolerance * 0.015625 / usize.toF64(sub.count)
      let firstDash = self.dashSubpaths.length()
      let first = self.vertices.asSlice()[sub.start]
      let smoothSeam = sub.closed && dashSmooth(first, pen, joinBudget)
      if on {
        run self.dashBegin(first)
      }
      let n = if sub.closed {
        sub.count
      } else {
        sub.count - 1
      }
      let mut uncertainty: f64 = 0.0
      let mut sinceCorner: f64 = 0.0
      let mut k: usize = 0
      while k < n {
        let a = self.vertices.asSlice()[sub.start + k]
        let b = self.vertices.asSlice()[sub.start + (k + 1) % sub.count]
        let curve = self.curves.asSlice()[b.curve]
        let start = if a.curve == b.curve && a.parameter < b.parameter {
          a.parameter
        } else {
          0.0
        }
        let endpointError = if start == 0.0 || b.parameter == 1.0 {
          curve.anchorError() * 2.0
        } else {
          0.0
        }
        let before = uncertainty
        uncertainty = uncertainty + curve.lengthError(start, b.parameter) + endpointError
        if !dashSmooth(a, pen, joinBudget) {
          sinceCorner = 0.0
        }
        let length = distance(a.point, b.point)
        let mut done: f64 = 0.0
        while length - done >= remaining {
          let next = done + remaining
          if remaining > 0.0 && next == done {
            fail GeometryError { code: ACCURACY_LIMIT }
          }
          done = next
          let cutError = if done == 0.0 {
            before
          } else {
            uncertainty
          }

          // Square cap corners move at most twice the offset metric.
          if 2.0 * cutError * self.dashMetric > pen.tolerance * 0.03125 {
            fail GeometryError { code: ACCURACY_LIMIT }
          }
          if cutError > 0.0 && sinceCorner + done <= cutError {
            fail GeometryError { code: ACCURACY_LIMIT }
          }
          let seamTransition = k + 1 == n && smoothSeam
            && dashSeamTransition(pattern, index, on, initialOn, initialRemaining, cutError)
          if cutError > 0.0 && (!dashSmooth(b, pen, joinBudget) || (k + 1 == n && !seamTransition))
            && length - done <= cutError {
            fail GeometryError { code: ACCURACY_LIMIT }
          }
          let cut = run self.cut(
            a,
            b,
            if length > 0.0 {
              done / length
            } else {
              0.0
            },
            pen,
          )
          if on {
            run self.dashPush(cut)
            if pattern[index] > 0.0
              && self.dashSubpaths.asSlice()[self.dashSubpaths.length() - 1].count == 1 {
              fail GeometryError { code: ACCURACY_LIMIT }
            }
          } else {
            run self.dashBegin(cut)
          }
          on = !on
          index = (index + 1) % pattern.length
          remaining = pattern[index]
          if self.dashVertices.length() >= MAX_POINTS {
            fail GeometryError { code: ACCURACY_LIMIT }
          }
        }
        remaining = remaining - (length - done)
        sinceCorner = sinceCorner + length

        // Only geometrically bounded joins may be crossed by a phase interval.
        // At a closed seam additionally certify that one existing cap merely moves.
        let seamTransition = k + 1 == n && smoothSeam
          && dashSeamTransition(pattern, index, on, initialOn, initialRemaining, uncertainty)
        if uncertainty > 0.0 && remaining <= uncertainty
          && (!dashSmooth(b, pen, joinBudget)
            || (k + 1 == n
              && (!seamTransition
                || 2.0 * uncertainty * self.dashMetric > pen.tolerance * 0.03125))) {
          fail GeometryError { code: ACCURACY_LIMIT }
        }
        if on {
          run self.dashPush(b)
        }
        k = k + 1
      }

      // A dash continuing across a closed seam is one subpath, not two capped fragments.
      if sub.closed && on && self.dashSubpaths.length() > firstDash {
        let firstSub = self.dashSubpaths.asSlice()[firstDash]
        let firstVertex = self.dashVertices.asSlice()[firstSub.start]
        if same(firstVertex.point, first.point) {
          let lastIndex = self.dashSubpaths.length() - 1
          let lastSub = self.dashSubpaths.asSlice()[lastIndex]
          if lastIndex == firstDash {
            self.dashSubpaths.set(
              lastIndex,
              Subpath { start: lastSub.start, count: lastSub.count - 1, closed: true },
            )
          } else {
            let mut j: usize = 1
            while j < firstSub.count {
              let v = self.dashVertices.asSlice()[firstSub.start + j]
              run self.dashPush(v)
              j = j + 1
            }
            self.dashSubpaths.set(
              firstDash,
              Subpath { start: firstSub.start, count: 0, closed: false },
            )
          }
        }
      }
      s = s + 1
    }
  }
}

fn quotientRadius(low: f64, high: f64, lowW: f64, highW: f64) -> f64 {
  let center = (low * 0.5 + high * 0.5) / (lowW * 0.5 + highW * 0.5)
  return ((high - low) * 0.5 + f64.abs(center) * (highW - lowW) * 0.5) / lowW
    + f64.abs(center) * 2.8421709430404007e-14
}

fn spaceAffine(h: &Homography) -> Affine {
  return Affine {
    a: h.xx / h.ww,
    b: h.yx / h.ww,
    c: h.xy / h.ww,
    d: h.yy / h.ww,
    e: h.xw / h.ww,
    f: h.yw / h.ww,
  }
}

effect fn spaceScale(h: &Homography, clip: Rect, tolerance: f64) -> f64
  ! GeometryError {
  if h.wx == 0.0 && h.wy == 0.0 {
    if h.ww <= 0.0 {
      return 1.0
    }
    let affine = spaceAffine(h)
    let scale = maxScale(&affine)
    if !f64.isFinite(scale) || !f64.isFinite(affine.e) || !f64.isFinite(affine.f) {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    return scale
  }
  return run strokeScale(h, clip, tolerance)
}

effect fn prepare(path: &Path, style: &Stroke, transform: &Affine, tolerance: f64) -> Pen
  ! GeometryError {
  if !f64.isFinite(transform.a) || !f64.isFinite(transform.b) || !f64.isFinite(transform.c)
    || !f64.isFinite(transform.d)
    || !f64.isFinite(transform.e)
    || !f64.isFinite(transform.f) {
    fail GeometryError { code: INVALID_INPUT }
  }
  let scale = maxScale(transform)
  if !f64.isFinite(scale) {
    fail GeometryError { code: NUMERIC_LIMIT }
  }
  let pen = run prepareScaled(path, style, scale, tolerance)
  if !f64.isFinite(style.width * 0.5 * scale) {
    fail GeometryError { code: NUMERIC_LIMIT }
  }
  return pen
}

effect fn prepareScaled(path: &Path, style: &Stroke, scale: f64, tolerance: f64) -> Pen
  ! GeometryError {
  if !(tolerance > 0.0) || !f64.isFinite(tolerance) || !(style.width >= 0.0)
    || !f64.isFinite(style.width)
    || !(style.miterLimit >= 1.0)
    || !f64.isFinite(style.miterLimit)
    || !f64.isFinite(style.dashOffset)
    || style.join > JOIN_ARCS
    || style.cap > CAP_SQUARE {
    fail GeometryError { code: INVALID_INPUT }
  }
  let userTolerance = if scale > 0.0 {
    tolerance / scale
  } else {
    tolerance
  }
  if !(userTolerance > 0.0) || !f64.isFinite(userTolerance) {
    fail GeometryError { code: ACCURACY_LIMIT }
  }
  let points = path.pointList()
  let mut i: usize = 0
  let mut magnitude = style.width * style.miterLimit
  if !f64.isFinite(magnitude) {
    fail GeometryError { code: NUMERIC_LIMIT }
  }
  let verbs = path.verbList()
  let mut v: usize = 0
  while v < verbs.length {
    let verb = verbs[v]
    let count: usize = if verb == MOVE || verb == LINE {
      1
    } else if verb == QUAD {
      2
    } else if verb == CUBIC {
      3
    } else if verb == ARC {
      5
    } else {
      0
    }
    let mut k: usize = 0
    while k < count {
      let p = points[i + k]
      if !p.isFinite() {
        fail GeometryError { code: INVALID_INPUT }
      }

      // An arc's phase is dimensionless and is reduced before geometric evaluation.
      if verb != ARC || k != 3 {
        magnitude = f64.max(magnitude, f64.max(f64.abs(p.x), f64.abs(p.y)))
      }
      k = k + 1
    }
    i = i + count
    v = v + 1
  }
  if magnitude * 2.8421709430404007e-14 > userTolerance * 0.015625 {
    fail GeometryError { code: ACCURACY_LIMIT }
  }
  return Pen {
    half: style.width * 0.5,
    join: style.join,
    cap: style.cap,
    miterLimit: style.miterLimit,
    tolerance: userTolerance,
  }
}

effect fn validateOutput(out: &Path, transform: &Affine, tolerance: f64) -> ()
  ! GeometryError {
  let points = out.pointList()
  let mut i: usize = 0
  while i < points.length {
    let p = points[i]
    let q = transform.apply(p)
    if !p.isFinite() || !q.isFinite() {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    let work = f64.max(
      f64.abs(transform.a * p.x) + f64.abs(transform.c * p.y) + f64.abs(transform.e),
      f64.abs(transform.b * p.x) + f64.abs(transform.d * p.y) + f64.abs(transform.f),
    )
    if !f64.isFinite(work) {
      fail GeometryError { code: NUMERIC_LIMIT }
    }
    if work * 2.8421709430404007e-14 > tolerance * 0.015625 {
      fail GeometryError { code: ACCURACY_LIMIT }
    }
    i = i + 1
  }
}

effect fn arcPart(
  out: &mut Path,
  center: Point,
  from: Point,
  to: Point,
  radius: f64,
  tolerance: f64,
) -> ()
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let sine = cross(from, to)

  // |from-to|² / (4(1+cos(theta/2))) is 1-cos(theta/2), without cancellation.
  let chord = distance(from, to)
  let cosineHalf = f64.sqrt(f64.max(0.0, 1.0 - chord * chord * 0.25))
  let sagitta = radius * (chord * chord / (4.0 * (1.0 + cosineHalf)))

  // Circular boundaries also need sufficient resolution for quantized pixel coverage: the
  // inscribed-polygon area deficit otherwise consumes the entire small-circle area budget.
  if sagitta <= tolerance * 0.0078125 {
    let end = add(center, to, radius)
    run out.lineTo(end.x, end.y)
    return
  }
  let sum = Point.make(from.x + to.x, from.y + to.y)
  let mut middle = if norm(sum.x, sum.y) > 0.0 {
    unit(sum)
  } else {
    normal(from)
  }
  if sine < 0.0 && cross(from, middle) > 0.0 {
    middle = reverse(middle)
  }
  if same(middle, from) || same(middle, to) || out.pointList().length >= MAX_POINTS {
    fail GeometryError { code: ACCURACY_LIMIT }
  }
  run arcPart(&mut out, center, from, middle, radius, tolerance)
  run arcPart(&mut out, center, middle, to, radius, tolerance)
}

effect fn arc(out: &mut Path, center: Point, from: Point, middle: Point, to: Point, pen: Pen) -> ()
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  run arcPart(&mut out, center, from, middle, pen.half, pen.tolerance)
  run arcPart(&mut out, center, middle, to, pen.half, pen.tolerance)
}

effect fn join(out: &mut Path, v: Vertex, lineIn: f64, lineOut: f64, pen: Pen) -> ()
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let a = v.incoming
  let b = v.outgoing
  let na = normal(a)
  let nb = normal(b)
  let from = add(v.point, na, pen.half)
  let to = add(v.point, nb, pen.half)
  if !v.corner || same(a, b) {
    run out.lineTo(from.x, from.y)
    run out.lineTo(to.x, to.y)
    return
  }
  if cross(a, b) > 0.0 {
    // For genuine straight source segments, trim the overlapping strips at their exact
    // intersection. Leaving overlap at fractional edge pixels overcounts signed-area coverage.
    // Do not apply tangent-line intersections to curved source segments.
    if lineIn > 0.0 && lineOut > 0.0 {
      let sum = Point.make(na.x + nb.x, na.y + nb.y)
      let magnitude = norm(sum.x, sum.y)
      if magnitude > 0.0 {
        let bisector = unit(sum)
        let halfCos = dot(na, bisector)
        let reach = pen.half * f64.sqrt(f64.max(0.0, 1.0 - halfCos * halfCos)) / halfCos
        if reach <= 0.5 * f64.min(lineIn, lineOut) {
          let intersection = add(v.point, bisector, pen.half / halfCos)
          run out.lineTo(intersection.x, intersection.y)
          return
        }
      }
    }

    // Curved or very short segments retain the union construction.
    run out.lineTo(from.x, from.y)
    run out.lineTo(v.point.x, v.point.y)
    run out.lineTo(to.x, to.y)
    return
  }
  run out.lineTo(from.x, from.y)
  if pen.join == JOIN_ARCS {
    run stroke_arcs.append(
      &mut out,
      v.point,
      a,
      b,
      v.curvatureIn,
      v.curvatureOut,
      pen.half,
      pen.miterLimit,
      pen.tolerance * 0.03125,
    )
    return
  }
  let sum = Point.make(na.x + nb.x, na.y + nb.y)
  let magnitude = norm(sum.x, sum.y)
  if pen.join == JOIN_ROUND {
    let middle = if magnitude > 0.0 {
      unit(sum)
    } else {
      a
    }
    run arc(&mut out, v.point, na, middle, nb, pen)
    return
  }
  if (pen.join == JOIN_MITER || pen.join == JOIN_MITER_CLIP) && magnitude > 0.0 {
    let u = unit(sum)
    let halfCos = dot(na, u)
    if halfCos * pen.miterLimit >= 1.0 {
      let tip = add(v.point, u, pen.half / halfCos)
      run out.lineTo(tip.x, tip.y)
    } else if pen.join == JOIN_MITER_CLIP {
      let ta = pen.half * (pen.miterLimit - halfCos) / dot(a, u)
      let tb = pen.half * (pen.miterLimit - halfCos) / (0.0 - dot(b, u))
      let pa = add(from, a, ta)
      let pb = add(to, b, 0.0 - tb)
      run out.lineTo(pa.x, pa.y)
      run out.lineTo(pb.x, pb.y)
    }
  } else if pen.join == JOIN_MITER_CLIP && magnitude == 0.0 {
    let pa = add(from, a, pen.half * pen.miterLimit)
    let pb = add(to, a, pen.half * pen.miterLimit)
    run out.lineTo(pa.x, pa.y)
    run out.lineTo(pb.x, pb.y)
  }
  run out.lineTo(to.x, to.y)
}

effect fn cap(out: &mut Path, p: Point, d: Point, pen: Pen) -> ()
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let n = normal(d)
  if pen.cap == CAP_SQUARE {
    let a = add(add(p, n, pen.half), d, pen.half)
    let b = add(add(p, n, 0.0 - pen.half), d, pen.half)
    run out.lineTo(a.x, a.y)
    run out.lineTo(b.x, b.y)
  } else if pen.cap == CAP_ROUND {
    run arc(&mut out, p, n, d, reverse(n), pen)
    return
  }
  let end = add(p, n, 0.0 - pen.half)
  run out.lineTo(end.x, end.y)
}

fn sourceLineLength(curves: &[StrokeCurve], a: Vertex, b: Vertex, backwards: bool) -> f64 {
  let index = if backwards {
    a.curve
  } else {
    b.curve
  }
  return if curves[index].kind == LINE {
    distance(a.point, b.point)
  } else {
    0.0
  }
}

effect fn side(
  vertices: &[Vertex],
  sub: Subpath,
  backwards: bool,
  curves: &[StrokeCurve],
  pen: Pen,
  out: &mut Path,
) -> ()
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let first = at(vertices, sub, 0, backwards)
  let start = add(first.point, normal(first.outgoing), pen.half)
  if sub.closed || !backwards {
    run out.moveTo(start.x, start.y)
  } else {
    run out.lineTo(start.x, start.y)
  }
  let mut i: usize = 1
  while i < sub.count {
    let v = at(vertices, sub, i, backwards)
    if i + 1 == sub.count && !sub.closed {
      let end = add(v.point, normal(v.incoming), pen.half)
      run out.lineTo(end.x, end.y)
      run cap(&mut out, v.point, v.incoming, pen)
    } else {
      let previous = at(vertices, sub, i - 1, backwards)
      let next = at(vertices, sub, (i + 1) % sub.count, backwards)
      run join(
        &mut out,
        v,
        sourceLineLength(curves, previous, v, backwards),
        sourceLineLength(curves, v, next, backwards),
        pen,
      )
    }
    i = i + 1
  }
  if sub.closed {
    let previous = at(vertices, sub, sub.count - 1, backwards)
    let next = at(vertices, sub, 1, backwards)
    run join(
      &mut out,
      first,
      sourceLineLength(curves, previous, first, backwards),
      sourceLineLength(curves, first, next, backwards),
      pen,
    )
    run out.close()
  }
}

effect fn outlines(
  vertices: &[Vertex],
  subpaths: &[Subpath],
  curves: &[StrokeCurve],
  pen: Pen,
  out: &mut Path,
) -> ()
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < subpaths.length {
    let sub = subpaths[i]
    if sub.count == 1 {
      let p = vertices[sub.start].point
      let h = pen.half
      if pen.cap == CAP_SQUARE {
        run out.moveTo(p.x - h, p.y - h)
        run out.lineTo(p.x - h, p.y + h)
        run out.lineTo(p.x + h, p.y + h)
        run out.lineTo(p.x + h, p.y - h)
        run out.close()
      } else if pen.cap == CAP_ROUND {
        run out.moveTo(p.x + h, p.y)
        run arc(
          &mut out,
          p,
          Point.make(1.0, 0.0),
          Point.make(0.0, -1.0),
          Point.make(-1.0, 0.0),
          pen,
        )
        run arc(&mut out, p, Point.make(-1.0, 0.0), Point.make(0.0, 1.0), Point.make(1.0, 0.0), pen)
        run out.close()
      }
    } else if sub.count > 1 {
      run side(vertices, sub, false, curves, pen, &mut out)
      run side(vertices, sub, true, curves, pen, &mut out)
      if !sub.closed {
        run out.close()
      }
    }
    i = i + 1
  }
}
