import silk.testing.testing { AssertionError, Testing }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.num.u8
import silk.num.i32
import silk.num.f64
import silk.num.u32
import geometry { Affine, Rect }
import path { Path }
import strips { Rasterizer, Coverage, NONZERO }
import pixmap { Pixmap, Rgba8 }
import paint {
  Gradient,
  Stop,
  Solid,
  ImagePattern,
  SPREAD_PAD,
  SPREAD_REFLECT,
  SPREAD_REPEAT,
  SAMPLE_NEAREST,
  SAMPLE_BILINEAR,
  EXTEND_CLAMP,
  EXTEND_REPEAT,
}
import paint as painting
import paint { Shader }
import pixmap { pack }
import silk.num.usize
import geometry_error { GeometryError }
import projective { Homography }

fn close(a: u8, b: u8, tolerance: i32) -> bool {
  let d = u8.toI32(a) - u8.toI32(b)
  return d <= tolerance && 0 - d <= tolerance
}

effect fn canvas(width: u32, height: u32) -> Coverage
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let mut p = Path.make()
  run p.rect(Rect.make(0.0, 0.0, u32.toF64(width), u32.toF64(height)))
  let mut raster = Rasterizer.make()
  let mut coverage = Coverage.make(width, height)
  run raster.fill(&p, &Affine.identity(), NONZERO, &mut coverage)
  return move coverage
}

effect fn blackToWhite(g: &mut Gradient) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run g.setStops(
    &[
      Stop { offset: 0.0, color: Rgba8.make(0, 0, 0, 255) },
      Stop { offset: 1.0, color: Rgba8.make(255, 255, 255, 255) },
    ],
  )
}

test effect fn linearGradientInterpolates() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let c = run canvas(64, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut g = Gradient.linear(0.0, 0.0, 64.0, 0.0, SPREAD_PAD, &Affine.identity())
  run blackToWhite(&mut g) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut target = run Pixmap.make(64, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  painting.fill(&mut target, &c, &g, 255)
  let mut ok = true
  let mut x: u32 = 0
  while x < 64 {
    let expected = f64.toU8(f64.floor((u32.toF64(x) + 0.5) / 64.0 * 255.0 + 0.5))
    if !close(target.pixel(x, 2).r, expected, 1) || target.pixel(x, 2).a != 255 {
      ok = false
    }
    x = x + 1
  }
  run Testing.expect(ok, "every column within 1 of the exact ramp")
}

test effect fn spreadModesExtendTheRamp() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let c = run canvas(40, 4) |> Effect.provideMut<Allocator>(&mut allocator)

  // The vector covers x 0..16; pixel 19 (center 19.5) is at t = 1.21875.
  let mut pad = Gradient.linear(0.0, 0.0, 16.0, 0.0, SPREAD_PAD, &Affine.identity())
  let mut reflect = Gradient.linear(0.0, 0.0, 16.0, 0.0, SPREAD_REFLECT, &Affine.identity())
  let mut repeat = Gradient.linear(0.0, 0.0, 16.0, 0.0, SPREAD_REPEAT, &Affine.identity())
  run blackToWhite(&mut pad) |> Effect.provideMut<Allocator>(&mut allocator)
  run blackToWhite(&mut reflect) |> Effect.provideMut<Allocator>(&mut allocator)
  run blackToWhite(&mut repeat) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut a = run Pixmap.make(40, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut b = run Pixmap.make(40, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut d = run Pixmap.make(40, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  painting.fill(&mut a, &c, &pad, 255)
  painting.fill(&mut b, &c, &reflect, 255)
  painting.fill(&mut d, &c, &repeat, 255)
  run Testing.expect(a.pixel(19, 0).r == 255, "pad holds the last stop")
  run Testing.expect(close(b.pixel(19, 0).r, 199, 1), "reflect runs back: t 0.78125")
  run Testing.expect(close(d.pixel(19, 0).r, 56, 1), "repeat restarts: t 0.21875")
}

test effect fn radialGradientUsesFocalCircle() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let c = run canvas(64, 64) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut centered = Gradient.radial(
    32.0,
    32.0,
    20.0,
    32.0,
    32.0,
    0.0,
    SPREAD_PAD,
    &Affine.identity(),
  )
  run blackToWhite(&mut centered) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut a = run Pixmap.make(64, 64) |> Effect.provideMut<Allocator>(&mut allocator)
  painting.fill(&mut a, &c, &centered, 255)

  // Pixel (41, 31) has its center 9.5 from (32, 32) horizontally and 0.5 vertically.
  let t = f64.sqrt(9.5 * 9.5 + 0.25) / 20.0
  run Testing.expect(
    close(a.pixel(41, 31).r, f64.toU8(f64.floor(t * 255.0 + 0.5)), 1),
    "distance / r",
  )
  run Testing.expect(a.pixel(60, 32).r == 255 && a.pixel(32, 32).r < 10, "pad outside, dark center")

  // Focal point at (22, 32): the parameter is 0 there and 1 on the end circle.
  let mut focal = Gradient.radial(32.0, 32.0, 20.0, 22.0, 32.0, 0.0, SPREAD_PAD, &Affine.identity())
  run blackToWhite(&mut focal) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut b = run Pixmap.make(64, 64) |> Effect.provideMut<Allocator>(&mut allocator)
  painting.fill(&mut b, &c, &focal, 255)
  run Testing.expect(
    b.pixel(21, 31).r < 20 && close(b.pixel(51, 31).r, 251, 6),
    "focal dark, far edge light",
  )
}

test effect fn radialConeLeavesOutsideTransparent() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let c = run canvas(64, 64) |> Effect.provideMut<Allocator>(&mut allocator)

  // A focal circle wholly outside the end circle makes a cone opening to the right.
  let mut cone = Gradient.radial(40.0, 32.0, 8.0, 8.0, 32.0, 2.0, SPREAD_PAD, &Affine.identity())
  run blackToWhite(&mut cone) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut a = run Pixmap.make(64, 64) |> Effect.provideMut<Allocator>(&mut allocator)
  painting.fill(&mut a, &c, &cone, 255)
  run Testing.expect(
    a.pixel(20, 2).a == 0 && a.pixel(20, 32).a == 255,
    "outside the cone stays transparent",
  )
}

test effect fn stopsAreFixedUpAndDegenerateVectorsUseLastStop() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let c = run canvas(32, 4) |> Effect.provideMut<Allocator>(&mut allocator)

  // The second offset 0.2 is raised to 0.5: a hard edge from red to green at x = 16.
  let stops = [
    Stop { offset: 0.5, color: Rgba8.make(255, 0, 0, 255) },
    Stop { offset: 0.2, color: Rgba8.make(0, 255, 0, 255) },
  ]
  let mut hard = Gradient.linear(0.0, 0.0, 32.0, 0.0, SPREAD_PAD, &Affine.identity())
  run hard.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut a = run Pixmap.make(32, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  painting.fill(&mut a, &c, &hard, 255)
  run Testing.expect(
    a.pixel(15, 0).r == 255 && a.pixel(16, 0).g == 255,
    "hard edge at the fixed-up offset",
  )
  let mut point = Gradient.linear(5.0, 5.0, 5.0, 5.0, SPREAD_PAD, &Affine.identity())
  run point.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut b = run Pixmap.make(32, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  painting.fill(&mut b, &c, &point, 255)
  run Testing.expect(
    b.pixel(0, 0).g == 255 && b.pixel(31, 3).g == 255,
    "zero-length vector paints the last stop",
  )
  let empty = Gradient.linear(0.0, 0.0, 1.0, 0.0, SPREAD_PAD, &Affine.identity())
  run Testing.expect(!empty.isPaintable(), "no stops paints nothing")
}

test effect fn interpolationSpaceIsSelectable() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let c = run canvas(2, 4) |> Effect.provideMut<Allocator>(&mut allocator)

  // Opaque red to transparent blue, sampled at t = 0.5 by a vector from -1 to 3.
  let stops = [
    Stop { offset: 0.0, color: Rgba8.make(255, 0, 0, 255) },
    Stop { offset: 1.0, color: Rgba8.make(0, 0, 255, 0) },
  ]
  let mut straight = Gradient.linear(-1.0, 0.0, 3.0, 0.0, SPREAD_PAD, &Affine.identity())
  run straight.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut premultiplied = Gradient.linear(-1.0, 0.0, 3.0, 0.0, SPREAD_PAD, &Affine.identity())
  premultiplied.setPremultipliedInterpolation(true)
  run premultiplied.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut a = run Pixmap.make(2, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut b = run Pixmap.make(2, 4) |> Effect.provideMut<Allocator>(&mut allocator)

  // Pixel 0's center is at t = 0.375; pixel 1's at 0.625. Average them to probe t = 0.5.
  painting.fill(&mut a, &c, &straight, 255)
  painting.fill(&mut b, &c, &premultiplied, 255)
  let sa = a.pixel(1, 0)
  let pb = b.pixel(1, 0)

  // Straight: alpha 0.375, color (95.6, 0, 159.4) premultiplied by it -> (36, 0, 60, 96).
  run Testing.expect(
    close(sa.r, 36, 1) && close(sa.b, 60, 1) && close(sa.a, 96, 1),
    "straight interpolation",
  )

  // Premultiplied: red fades out with no blue at all.
  run Testing.expect(
    close(pb.r, 96, 1) && pb.b == 0 && close(pb.a, 96, 1),
    "premultiplied interpolation",
  )
}

test effect fn imagePatternsSampleAndTile() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut bytes = List<u8>.make()

  // 2 x 1 image: black, white.
  let texels: [u8; 8] = [0, 0, 0, 255, 255, 255, 255, 255]
  run bytes.appendSlice(&texels) |> Effect.provideMut<Allocator>(&mut allocator)
  let image = Pixmap.fromBytes(2, 1, move bytes)
  let c = run canvas(8, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  let scale = Affine.scale(2.0, 4.0)
  let nearest = ImagePattern.make(&image, &scale, SAMPLE_NEAREST, EXTEND_REPEAT)
  let mut a = run Pixmap.make(8, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  painting.fill(&mut a, &c, &nearest, 255)
  run Testing.expect(
    a.pixel(1, 0).r == 0 && a.pixel(2, 0).r == 255 && a.pixel(5, 3).r == 0
      && a.pixel(7, 2).r == 255,
    "nearest tiles",
  )
  let smooth = ImagePattern.make(&image, &scale, SAMPLE_BILINEAR, EXTEND_CLAMP)
  let mut b = run Pixmap.make(8, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  painting.fill(&mut b, &c, &smooth, 255)

  // Pixel 2's center maps to image x 1.25: a quarter of the way from texel 0's center to texel 1's.
  run Testing.expect(
    b.pixel(0, 0).r == 0 && close(b.pixel(2, 0).r, 191, 1) && b.pixel(7, 0).r == 255,
    "bilinear clamps at edges",
  )
}

test effect fn opacityScalesCoverage() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let c = run canvas(4, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut a = run Pixmap.make(4, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  painting.fill(&mut a, &c, &Solid.make(Rgba8.make(255, 255, 255, 255)), 128)
  run Testing.expect(a.pixel(0, 0).r == 128 && a.pixel(3, 3).a == 128, "half opacity")
}

/// A solid color that does not report itself uniform, so `fill` shades it span by span.
struct Spanned {
  solid: Solid,
}

impl Shader for Spanned {
  fn shade(self: &Self, x: u32, y: u32) -> Rgba8 {
    return self.solid.shade(x, y)
  }

  fn shadeSpan(self: &Self, x: u32, y: u32, count: usize, out: &mut [u32]) -> () {
    self.solid.shadeSpan(x, y, count, &mut out)
  }

  fn isUniform(self: &Self) -> bool {
    return false
  }
}

test effect fn uniformFillMatchesShadedSpans() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut p = Path.make()
  run p.circle(20.3, 17.6, 13.2) |> Effect.provideMut<Allocator>(&mut allocator)
  run p.rect(Rect.make(30.5, 2.25, 9.5, 31.0)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut raster = Rasterizer.make()

  // 37 rows: the last band is cut by the canvas.
  let mut coverage = Coverage.make(48, 37)
  run raster.fill(&p, &Affine.identity(), NONZERO, &mut coverage)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let colors = [Rgba8.make(200, 40, 90, 255), Rgba8.make(10, 220, 130, 140), Rgba8.make(0, 0, 0, 0)]
  let opacities: [u8; 3] = [255, 97, 1]
  let mut ok = true
  let mut c: usize = 0
  while c < 3 {
    let mut o: usize = 0
    while o < 3 {
      let mut fast = run Pixmap.make(48, 37) |> Effect.provideMut<Allocator>(&mut allocator)
      let mut slow = run Pixmap.make(48, 37) |> Effect.provideMut<Allocator>(&mut allocator)
      fast.clear(Rgba8.make(30, 60, 90, 200))
      slow.clear(Rgba8.make(30, 60, 90, 200))
      let solid = Solid.make(colors[c])
      painting.fill(&mut fast, &coverage, &solid, opacities[o])
      painting.fill(&mut slow, &coverage, &Spanned { solid: solid }, opacities[o])
      let a = fast.data()
      let b = slow.data()
      let mut i: usize = 0
      while i < a.length {
        if a[i] != b[i] {
          ok = false
        }
        i = i + 1
      }
      o = o + 1
    }
    c = c + 1
  }
  run Testing.expect(ok, "uniform fills match span shading byte for byte")
}

test effect fn imageSpansMatchSinglePixels() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut image = run Pixmap.make(5, 3) |> Effect.provideMut<Allocator>(&mut allocator)
  let d = image.dataMut()
  let mut i: usize = 0
  while i < d.length {
    d[i] = u32.toU8(u32.wrappingMultiply(usize.toU32(i), 37) % 256)
    i = i + 1
  }
  let transforms = [
    Affine { a: 1.7, b: 0.4, c: -0.3, d: 2.1, e: -3.25, f: 1.5 },
    Affine { a: 0.31, b: -0.9, c: 0.77, d: 0.12, e: 40.0, f: -7.0 },
    Affine { a: 1.0e-14, b: 0.0, c: 0.0, d: 1.0e-14, e: 0.0, f: 0.0 },
    Affine { a: -2.5, b: 0.0, c: 0.0, d: 3.0, e: 100.0, f: 0.0 },
  ]
  let mut ok = true
  let mut t: usize = 0
  while t < 4 {
    let mut e: u8 = 0
    while e < 2 {
      let pattern = ImagePattern.make(&image, &transforms[t], SAMPLE_BILINEAR, e)
      let mut colors: [u32; 23] = [0; 23]
      let mut y: u32 = 0
      while y < 9 {
        pattern.shadeSpan(3, y, 23, &mut colors)
        let mut x: u32 = 0
        while x < 23 {
          if colors[u32.toUsize(x)] != pack(pattern.shade(3 + x, y)) {
            ok = false
          }
          x = x + 1
        }
        y = y + 1
      }
      e = e + 1
    }
    t = t + 1
  }
  run Testing.expect(ok, "four-pixel image spans match single-pixel sampling")
}

// SVG 2 https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#ColorInterpolationProperty
// CSS Color 4 https://www.w3.org/TR/css-color-4/#color-conversion-code
test effect fn linearRgbRampEncodesLightWithoutByteQuantization() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut g = Gradient.linear(0.0, 0.0, 1.0, 0.0, SPREAD_PAD, &Affine.identity())
  g.setLinearRgbInterpolation(true)
  run blackToWhite(&mut g) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    g.rampBytes()[512 * 4] == 188,
    "linear-light half white encodes to sRGB 188, not 128",
  )
  let dark = [
    Stop { offset: 0.0, color: Rgba8.make(1, 1, 1, 255) },
    Stop { offset: 1.0, color: Rgba8.make(9, 9, 9, 255) },
  ]
  run g.setStops(&dark) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    g.rampBytes()[512 * 4] == 5,
    "dark channels survive the full-precision transfer",
  )
  run Testing.expect(
    g.rampBytes()[0] == 1 && g.rampBytes()[1023 * 4] == 9,
    "encoded endpoints are unchanged",
  )
}

// SVG 2 https://www.w3.org/TR/2018/CR-SVG2-20181004/pservers.html#StopNotes
// CSS Images 3 https://www.w3.org/TR/css-images-3/#color-stop-syntax
test effect fn linearRgbRampKeepsAlphaInterpolationIndependent() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let stops = [
    Stop { offset: 0.0, color: Rgba8.make(255, 0, 0, 255) },
    Stop { offset: 1.0, color: Rgba8.make(0, 0, 255, 0) },
  ]
  let mut g = Gradient.linear(0.0, 0.0, 1.0, 0.0, SPREAD_PAD, &Affine.identity())
  g.setLinearRgbInterpolation(true)
  run g.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    g.rampBytes()[2048] == 94 && g.rampBytes()[2050] == 94 && g.rampBytes()[2051] == 127,
    "straight interpolation retains transparent stop hue, then encodes and premultiplies",
  )
  g.setPremultipliedInterpolation(true)
  run g.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    g.rampBytes()[2048] == 127 && g.rampBytes()[2050] == 0 && g.rampBytes()[2051] == 127,
    "premultiplied linear interpolation excludes transparent stop hue",
  )
  run Testing.expect(
    g.rampBytes()[4092] == 0 && g.rampBytes()[4094] == 0 && g.rampBytes()[4095] == 0,
    "zero alpha is transparent black",
  )
}

// SVG 2 https://www.w3.org/TR/2018/CR-SVG2-20181004/painting.html#ColorInterpolationProperty
test effect fn explicitSrgbRampMatchesBothLegacyAlphaModes() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let stops = [
    Stop { offset: 0.0, color: Rgba8.make(17, 99, 220, 180) },
    Stop { offset: 1.0, color: Rgba8.make(241, 5, 60, 13) },
  ]
  let mut mode: u32 = 0
  while mode < 2 {
    let mut original = Gradient.linear(0.0, 0.0, 1.0, 0.0, SPREAD_PAD, &Affine.identity())
    let mut explicit = Gradient.linear(0.0, 0.0, 1.0, 0.0, SPREAD_PAD, &Affine.identity())
    original.setPremultipliedInterpolation(mode != 0)
    explicit.setPremultipliedInterpolation(mode != 0)
    explicit.setLinearRgbInterpolation(true)
    explicit.setLinearRgbInterpolation(false)
    run original.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)
    run explicit.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)
    let mut i: usize = 0
    while i < original.rampBytes().length {
      run Testing.expect(
        original.rampBytes()[i] == explicit.rampBytes()[i],
        "disabling linearRGB preserves every legacy ramp byte",
      )
      i = i + 1
    }
    mode = mode + 1
  }
}

// Reusing a paint across SVG instances must not retain the preceding inverse or
// require rebuilding its color ramp after a singular instance.
test effect fn gradientTransformUpdatesRetainColorsAndRecoverFromSingularMaps() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut gradient = Gradient.linear(0.0, 0.0, 4.0, 0.0, SPREAD_PAD, &Affine.identity())
  run blackToWhite(&mut gradient) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shader.shade(&gradient, 0, 0).r == 32, "initial paint-space sample")
  let mut affine = Affine.identity()
  affine.e = 2.0
  gradient.setTransform(&affine)
  run Testing.expect(
    Shader.shade(&gradient, 0, 0).r == 0,
    "updated affine inverse translates the ramp",
  )
  let mut projective = Homography.fromAffine(&Affine.identity())
  projective.wx = 0.25
  run gradient.setProjective(&projective)
  run Testing.expect(
    Shader.shade(&gradient, 0, 0).r == 36,
    "updated projective inverse divides by w",
  )
  projective.xx = 0.0
  run gradient.setProjective(&projective)
  run Testing.expect(Shader.shade(&gradient, 0, 0).a == 0, "singular instance paints transparently")
  gradient.setTransform(&Affine.identity())
  run Testing.expect(
    !gradient.isProjective() && Shader.shade(&gradient, 0, 0).r == 32
      && Shader.shade(&gradient, 0, 0).a == 255,
    "affine instance recovers validity and uses the existing ramp",
  )
}

// SVG2 CR2018 pservers.html#StopNotes and #RadialGradientNotes:
// zero/one stops resolve before the two-circle distribution. Identical circles
// with multiple stops are transparent, including two zero-radius circles.
test effect fn radialDegeneracyAndStopCountPrecedence() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut radius = 0.0
  while radius <= 2.0 {
    let mut g = Gradient.radial(4.5, 4.5, radius, 4.5, 4.5, radius, SPREAD_PAD, &Affine.identity())
    run blackToWhite(&mut g) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      !g.isPaintable() && g.shade(4, 4).a == 0,
      "identical circles have no gradient distribution",
    )
    run g.setStops(&[Stop { offset: 0.7, color: Rgba8.make(255, 0, 0, 128) }])
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      g.isSingle() && g.shade(20, 20).r == 128 && g.shade(20, 20).a == 128,
      "one stop is solid before circle degeneracy",
    )
    run blackToWhite(&mut g) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(!g.isPaintable(), "resetting stops restores identical-circle transparency")
    run g.setStops(&[]) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(!g.isPaintable(), "zero stops remain none")
    radius = radius + 2.0
  }
}

test effect fn shrinkingRadialCircleCanEndAtZeroRadius() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut g = Gradient.radial(6.5, 6.5, 0.0, 6.5, 6.5, 4.0, SPREAD_PAD, &Affine.identity())
  run blackToWhite(&mut g) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    !g.isSingle() && g.shade(6, 6).r == 255 && g.shade(12, 6).r == 0,
    "zero end radius is not a solid last stop",
  )
  run Testing.expect(close(g.shade(8, 6).r, 128, 1), "shrinking circle midpoint has radius two")

  // Changing the gradient-space scale must not turn a quadratic into a tangent.
  let mut tiny = Gradient.radial(
    0.00000045,
    0.00000045,
    0.0000002,
    0.00000045,
    0.00000045,
    0.0000001,
    SPREAD_PAD,
    &Affine.scale(10000000.0, 10000000.0),
  )
  run blackToWhite(&mut tiny) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(tiny.shade(6, 4).r == 255, "small nonzero quadratic coefficient is not zero")
}

// CR2018 #RadialGradientNotes' tangent illustration and the linked
// https://www.w3.org/2011/07/29-svg-minutes.html#item05 require offset weighting.
// Reflect has the same mean as repeat: its period is one ramp and its reverse.
test effect fn tangentRadialLimitUsesWeightedPeriodMean() -> ()
  ! AssertionError<'static> | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let stops = [
    Stop { offset: -1.0, color: Rgba8.make(255, 0, 0, 255) },
    Stop { offset: 0.25, color: Rgba8.make(255, 0, 0, 255) },
    Stop { offset: 0.2, color: Rgba8.make(0, 0, 255, 255) },
    Stop { offset: 2.0, color: Rgba8.make(0, 0, 255, 255) },
  ]
  let modes = [SPREAD_PAD, SPREAD_REPEAT, SPREAD_REFLECT]
  let mut i: usize = 0
  while i < modes.length {
    let mut g = Gradient.radial(4.5, 4.5, 4.0, 8.5, 4.5, 0.0, modes[i], &Affine.identity())
    run g.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)
    let expected = if i == 0 {
      Rgba8.make(0, 0, 255, 255)
    } else {
      Rgba8.make(64, 0, 191, 255)
    }
    run Testing.expect(
      pack(g.shade(10, 3)) == pack(expected),
      "exterior tangent half-plane has a limiting color, not transparency",
    )
    let mut span: [u32; 3] = [0; 3]
    g.shadeSpan(9, 4, 3, &mut span)
    run Testing.expect(
      span[0] == pack(expected) && span[2] == pack(expected),
      "span and scalar limit agree",
    )
    run g.setProjective(&Homography.fromAffine(&Affine.identity()))
    run Testing.expect(
      pack(g.shade(10, 3)) == pack(expected),
      "projective path retains the same tangent limit",
    )
    i = i + 1
  }
  let mut shrinking = Gradient.radial(8.5, 4.5, 0.0, 4.5, 4.5, 4.0, SPREAD_PAD, &Affine.identity())
  run shrinking.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    shrinking.shade(10, 3).r == 255,
    "shrinking tangent pad extends the first stop",
  )
}

test effect fn tangentPeriodMeanIntegratesAlphaAndInterpolationSpace() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let stops = [
    Stop { offset: 0.0, color: Rgba8.make(255, 0, 0, 255) },
    Stop { offset: 1.0, color: Rgba8.make(0, 0, 255, 0) },
  ]
  let mut g = Gradient.radial(4.5, 4.5, 4.0, 8.5, 4.5, 0.0, SPREAD_REPEAT, &Affine.identity())
  run g.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)

  // Integral of ((1-t)^2, 0, t(1-t), 1-t), not an average of rounded ramp entries.
  run Testing.expect(
    pack(g.shade(10, 3)) == pack(Rgba8.make(85, 0, 43, 128)),
    "straight alpha integrates the product of color and opacity",
  )
  g.setPremultipliedInterpolation(true)
  run g.setStops(&stops) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    pack(g.shade(10, 3)) == pack(Rgba8.make(128, 0, 0, 128)),
    "premultiplied interpolation integrates linearly",
  )
  g.setLinearRgbInterpolation(true)
  run blackToWhite(&mut g) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    g.shade(10, 3).r == 188 && g.shade(10, 3).a == 255,
    "linearRGB mean is encoded after integration",
  )
}
