//! A recorded scene: coverage runs, their alphas and paints, packed in the GPU layouts that
//! `shaders/scene.wgsl` reads.
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.num.u8
import silk.num.u32
import silk.num.usize
import vector.strips { Coverage, BAND }
import vector.pixmap { Rgba8 }
import vector.paint { Gradient, ImagePattern, packInverseHomography }
import vector.geometry_error { GeometryError, NUMERIC_LIMIT }

/// Bytes per run record: x, y, width, alpha word index (or SOLID_RUN), paint word index, opacity.
pub const RUN_BYTES: usize = 24

/// Words per solid/affine paint. Projective kinds 4, 5, 6 append wx wy ww,
/// making 19 words. Runs store word offsets, not fixed-stride paint indices.
pub const PAINT_WORDS: u32 = 16

const SOLID_RUN: u32 = 0xffffffff

/// Bytes per command record: op, then three operands.
pub const COMMAND_BYTES: usize = 16

/// Draws runs `a .. b` into the current target.
pub const OP_DRAW: u32 = 0

/// Starts an isolated, transparent layer (a group) or mask content.
pub const OP_PUSH: u32 = 1

/// Composites the top layer onto its parent: a = blend mode, b = opacity, c = mask id or NO_MASK.
pub const OP_POP_LAYER: u32 = 2

/// Turns the top layer into mask `a`: b = MASK_ALPHA or MASK_LUMINANCE, c = mask id to multiply
/// by (clip intersection) or NO_MASK.
pub const OP_POP_MASK: u32 = 3

pub const NO_MASK: u32 = 0xffffffff

/// `mask-type: alpha` (also clip paths drawn opaque): the content's alpha.
pub const MASK_ALPHA: u32 = 0

/// `mask-type: luminance`, like `vector.layer.Mask.fromLuminance`.
pub const MASK_LUMINANCE: u32 = 1

pub struct Scene {
  canvasWidth: u32,
  canvasHeight: u32,
  runBytes: List<u8>,
  alphaBytes: List<u8>,
  paintBytes: List<u8>,
  rampBytes: List<u8>,
  commandBytes: List<u8>,
  /// The first run not yet covered by a draw command.
  pendingRuns: u32,
  depth: u32,
  masks: u32,
}

effect fn pushU32(bytes: &mut List<u8>, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run bytes.append(u32.toU8(value & 255))
  run bytes.append(u32.toU8(u32.shiftRight(value, 8) & 255))
  run bytes.append(u32.toU8(u32.shiftRight(value, 16) & 255))
  run bytes.append(u32.toU8(u32.shiftRight(value, 24)))
}

effect fn pushF32(bytes: &mut List<u8>, value: f64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run pushU32(&mut bytes, f32.toBits(f64.toF32(value)))
}

fn pack(c: Rgba8) -> u32 {
  return u8.toU32(c.r) | u32.shiftLeft(u8.toU32(c.g), 8) | u32.shiftLeft(u8.toU32(c.b), 16)
    | u32.shiftLeft(u8.toU32(c.a), 24)
}

impl Scene {
  pub fn make(width: u32, height: u32) -> Scene {
    return Scene {
      canvasWidth: width,
      canvasHeight: height,
      runBytes: List<u8>.make(),
      alphaBytes: List<u8>.make(),
      paintBytes: List<u8>.make(),
      rampBytes: List<u8>.make(),
      commandBytes: List<u8>.make(),
      pendingRuns: 0,
      depth: 0,
      masks: 0,
    }
  }

  pub fn width(self: &Self) -> u32 {
    return self.canvasWidth
  }

  pub fn height(self: &Self) -> u32 {
    return self.canvasHeight
  }

  pub fn runCount(self: &Self) -> u32 {
    return usize.toU32(self.runBytes.length() / RUN_BYTES)
  }

  pub fn runs(self: &Self) -> &[u8] {
    return self.runBytes.asSlice()
  }

  pub fn alphas(self: &Self) -> &[u8] {
    return self.alphaBytes.asSlice()
  }

  pub fn paints(self: &Self) -> &[u8] {
    return self.paintBytes.asSlice()
  }

  /// Gradient ramps and image texels, one premultiplied RGBA8 word each.
  pub fn ramps(self: &Self) -> &[u8] {
    return self.rampBytes.asSlice()
  }

  /// Command records ([`COMMAND_BYTES`] each). Empty when the scene has no layers or masks: then
  /// every run draws straight onto the target.
  pub fn commands(self: &Self) -> &[u8] {
    return self.commandBytes.asSlice()
  }

  /// How many masks [`popMask`] has made.
  pub fn maskCount(self: &Self) -> u32 {
    return self.masks
  }

  /// Layers and masks pushed and not yet popped.
  pub fn openLayers(self: &Self) -> u32 {
    return self.depth
  }

  pub fn clear(self: &mut Self) -> () {
    self.runBytes.clear()
    self.alphaBytes.clear()
    self.paintBytes.clear()
    self.rampBytes.clear()
    self.commandBytes.clear()
    self.pendingRuns = 0
    self.depth = 0
    self.masks = 0
  }

  /// Starts an isolated group: later draws go into a transparent layer until [`popLayer`] (or
  /// mask content until [`popMask`]). Like drawing into a fresh `Pixmap` on the CPU.
  pub effect fn pushLayer(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.command(OP_PUSH, 0, 0, 0)
    self.depth = self.depth + 1
  }

  /// Composites the top layer onto its parent with blend `mode` (a `vector.layer` BLEND_ value)
  /// and group `opacity`, through `mask` unless it is [`NO_MASK`]: like `vector.layer.composite`
  /// or `compositeMasked`. Calls must pair with [`pushLayer`].
  pub effect fn popLayer(self: &mut Self, mode: u8, opacity: u8, mask: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.command(OP_POP_LAYER, u8.toU32(mode), u8.toU32(opacity), mask)
    self.depth = self.depth - 1
  }

  /// Ends the top layer as mask content and returns its mask id: its alpha or luminance
  /// (`kind`), multiplied by mask `clip` unless that is [`NO_MASK`] (`Mask.intersect`). For a
  /// clip path, fill its coverage in opaque white and use [`MASK_ALPHA`].
  pub effect fn popMask(self: &mut Self, kind: u32, clip: u32) -> u32
    ! OutOfMemoryError
    ? &mut Allocator {
    let id = self.masks
    run self.command(OP_POP_MASK, id, kind, clip)
    self.depth = self.depth - 1
    self.masks = self.masks + 1
    return id
  }

  effect fn command(self: &mut Self, op: u32, a: u32, b: u32, c: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let runs = self.runCount()
    let pending = self.pendingRuns
    if runs > pending {
      run self.record(OP_DRAW, pending, runs, 0)
      self.pendingRuns = runs
    }
    run self.record(op, a, b, c)
  }

  effect fn record(self: &mut Self, op: u32, a: u32, b: u32, c: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run pushU32(&mut self.commandBytes, op)
    run pushU32(&mut self.commandBytes, a)
    run pushU32(&mut self.commandBytes, b)
    run pushU32(&mut self.commandBytes, c)
  }

  /// Draws `coverage` with a straight-alpha `color`, like `Pixmap.fillCoverage` or
  /// `paint.fill` with a `Solid`, scaled by `opacity`.
  pub effect fn fill(self: &mut Self, coverage: &Coverage, color: Rgba8, opacity: u8) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let paint = usize.toU32(self.paintBytes.length() / 4)
    run pushU32(&mut self.paintBytes, 0)
    run pushU32(&mut self.paintBytes, pack(color.premultiply()))
    let mut i: u32 = 2
    while i < PAINT_WORDS {
      run pushU32(&mut self.paintBytes, 0)
      i = i + 1
    }
    run self.addRuns(coverage, paint, opacity)
  }

  /// Draws `coverage` with `gradient`, like `paint.fill`. An unpaintable gradient draws nothing.
  /// Projective inverses must fit the checked f32 shader contract; unsupported
  /// precision fails before any paint/ramp/run bytes are appended.
  pub effect fn fillGradient(
    self: &mut Self,
    coverage: &Coverage,
    gradient: &Gradient,
    opacity: u8,
  ) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    if !gradient.isPaintable() {
      return
    }
    let matrix = if gradient.isProjective() {
      run packInverseHomography(&gradient.inverseHomography())
    } else {
      let m = gradient.inverseTransform()
      [
        f64.toF32(m.a),
        f64.toF32(m.b),
        f64.toF32(m.c),
        f64.toF32(m.d),
        f64.toF32(m.e),
        f64.toF32(m.f),
        0.0,
        0.0,
        1.0,
      ]
    }
    let g = gradient.geometry()
    if gradient.isProjective() {
      let mut i: usize = 0
      while i < 6 {
        let value = f64.toF32(g[i])
        if !f32.isFinite(value) || (g[i] != 0.0 && f32.abs(value) < 1.17549435e-38) {
          fail GeometryError { code: NUMERIC_LIMIT }
        }
        i = i + 1
      }
    }
    let paint = usize.toU32(self.paintBytes.length() / 4)
    let rampStart = usize.toU32(self.rampBytes.length() / 4)
    run self.rampBytes.appendSlice(gradient.rampBytes())
    let kind: u32 = if gradient.isRadial() {
      2
    } else {
      1
    }
    run pushU32(
      &mut self.paintBytes,
      if gradient.isProjective() {
        kind + 3
      } else {
        kind
      },
    )
    run pushU32(&mut self.paintBytes, rampStart)
    run pushU32(&mut self.paintBytes, u8.toU32(gradient.spreadMode()))
    run pushU32(
      &mut self.paintBytes,
      if gradient.isSingle() {
        1
      } else {
        if gradient.hasTangentLimit() {
          2
        } else {
          0
        }
      },
    )
    let mut column: usize = 0
    while column < 6 {
      run pushU32(&mut self.paintBytes, f32.toBits(matrix[column]))
      column = column + 1
    }
    let mut i: usize = 0
    while i < 6 {
      run pushF32(&mut self.paintBytes, g[i])
      i = i + 1
    }
    if gradient.isProjective() {
      run self.paintDenominator(&matrix)
    }
    run self.addRuns(coverage, paint, opacity)
  }

  /// Draws `coverage` with the image `pattern`, like `paint.fill`. An unpaintable pattern draws
  /// nothing. The image's texels are appended to [`ramps`].
  /// Projective matrix packing fails explicitly rather than encoding an affine substitute.
  pub effect fn fillImage(
    self: &mut Self,
    coverage: &Coverage,
    pattern: &ImagePattern,
    opacity: u8,
  ) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    if !pattern.isPaintable() {
      return
    }
    let matrix = if pattern.isProjective() {
      run packInverseHomography(&pattern.inverseHomography())
    } else {
      let m = pattern.inverseTransform()
      [
        f64.toF32(m.a),
        f64.toF32(m.b),
        f64.toF32(m.c),
        f64.toF32(m.d),
        f64.toF32(m.e),
        f64.toF32(m.f),
        0.0,
        0.0,
        1.0,
      ]
    }
    let paint = usize.toU32(self.paintBytes.length() / 4)
    let image = pattern.pixmap()
    let start = usize.toU32(self.rampBytes.length() / 4)
    run self.rampBytes.appendSlice(image.data())
    run pushU32(
      &mut self.paintBytes,
      if pattern.isProjective() {
        6
      } else {
        3
      },
    )
    run pushU32(&mut self.paintBytes, start)
    run pushU32(&mut self.paintBytes, image.width())
    run pushU32(&mut self.paintBytes, image.height())
    let mut column: usize = 0
    while column < 6 {
      run pushU32(&mut self.paintBytes, f32.toBits(matrix[column]))
      column = column + 1
    }
    run pushU32(&mut self.paintBytes, u8.toU32(pattern.samplingMode()))
    run pushU32(&mut self.paintBytes, u8.toU32(pattern.extendMode()))
    let mut i: u32 = 12
    while i < 16 {
      run pushU32(&mut self.paintBytes, 0)
      i = i + 1
    }
    if pattern.isProjective() {
      run self.paintDenominator(&matrix)
    }
    run self.addRuns(coverage, paint, opacity)
  }

  effect fn paintDenominator(self: &mut Self, matrix: &[f32; 9]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run pushU32(&mut self.paintBytes, f32.toBits(matrix[6]))
    run pushU32(&mut self.paintBytes, f32.toBits(matrix[7]))
    run pushU32(&mut self.paintBytes, f32.toBits(matrix[8]))
  }

  effect fn addRuns(self: &mut Self, coverage: &Coverage, paint: u32, opacity: u8) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if opacity == 0 {
      return
    }
    let fills = coverage.fills()
    let mut f: usize = 0
    while f < fills.length {
      let span = fills[f]
      run self.addRun(span.x, span.y, span.width, SOLID_RUN, paint, opacity)
      f = f + 1
    }
    let alphaBase = usize.toU32(self.alphaBytes.length() / 4)
    run self.alphaBytes.appendSlice(coverage.alphas())
    let strips = coverage.strips()
    let mut s: usize = 0
    while s < strips.length {
      let strip = strips[s]
      run self.addRun(
        strip.x,
        strip.y,
        strip.width,
        alphaBase + strip.alphaOffset / BAND,
        paint,
        opacity,
      )
      s = s + 1
    }
  }

  effect fn addRun(
    self: &mut Self,
    x: u32,
    y: u32,
    width: u32,
    alpha: u32,
    paint: u32,
    opacity: u8,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run pushU32(&mut self.runBytes, x)
    run pushU32(&mut self.runBytes, y)
    run pushU32(&mut self.runBytes, width)
    run pushU32(&mut self.runBytes, alpha)
    run pushU32(&mut self.runBytes, paint)
    run pushU32(&mut self.runBytes, u8.toU32(opacity))
  }
}
