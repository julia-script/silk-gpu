// Generated by scripts/embed-shaders from gpu_scene/shaders; do not edit.
pub fn scene() -> &'static [u8] { return b"// Sparse-strip scene renderer: one instance per strip or fill run, painted and composited\n// source-over with exact integer masking so output matches vector's CPU pixmap.\nstruct Canvas { width: u32, height: u32, runs: u32, unused: u32 }\nstruct Run { x: u32, y: u32, width: u32, alpha: u32, paint: u32, opacity: u32 }\n@group(0) @binding(0) var<uniform> canvas: Canvas;\n@group(0) @binding(1) var<storage, read> runs: array<Run>;\n@group(0) @binding(2) var<storage, read> alphas: array<u32>;\n@group(0) @binding(3) var<storage, read> paints: array<u32>;\n@group(0) @binding(4) var<storage, read> ramps: array<u32>;\n\nconst BAND: u32 = 4u;\nconst SOLID_RUN: u32 = 0xffffffffu;\nconst RAMP_LAST: f32 = 1023.0;\n\nstruct Vertex { @builtin(position) position: vec4f, @location(0) @interpolate(flat) run: u32 }\n\n@vertex fn vs(@builtin(vertex_index) corner: u32, @builtin(instance_index) index: u32) -> Vertex {\n  let r = runs[index];\n  let corners = array<vec2u, 6>(vec2u(0u, 0u), vec2u(1u, 0u), vec2u(0u, 1u), vec2u(0u, 1u), vec2u(1u, 0u), vec2u(1u, 1u));\n  let c = corners[corner];\n  let x = f32(r.x + c.x * r.width);\n  let y = f32(min(r.y + c.y * BAND, canvas.height));\n  return Vertex(vec4f(x / f32(canvas.width) * 2.0 - 1.0, 1.0 - y / f32(canvas.height) * 2.0, 0.0, 1.0), index);\n}\n\nfn div255(x: u32) -> u32 {\n  let t = x + 128u;\n  return (t + (t >> 8u)) >> 8u;\n}\n\nfn unpack(c: u32) -> vec4u {\n  return vec4u(c & 255u, (c >> 8u) & 255u, (c >> 16u) & 255u, c >> 24u);\n}\n\nfn word(p: u32, i: u32) -> f32 { return bitcast<f32>(paints[p + i]); }\n\n// Image paints (kind 3): texel start in `ramps`, width, height, the device-to-image inverse\n// a b c d e f, sampling (0 nearest, 1 bilinear), extend (0 clamp, 1 repeat).\nfn texel(p: u32, x: f32, y: f32) -> vec4u {\n  let w = f32(paints[p + 2u]);\n  let h = f32(paints[p + 3u]);\n  var tx = 0.0;\n  var ty = 0.0;\n  if paints[p + 11u] == 1u {\n    // Rounding can land exactly on w or h; keep the index inside the image.\n    tx = min(x - w * floor(x / w), w - 1.0);\n    ty = min(y - h * floor(y / h), h - 1.0);\n  } else {\n    tx = clamp(x, 0.0, w - 1.0);\n    ty = clamp(y, 0.0, h - 1.0);\n  }\n  let index = u32(ty) * paints[p + 2u] + u32(tx);\n  return unpack(ramps[paints[p + 1u] + index]);\n}\n\nfn bilerp(a: vec4u, b: vec4u, c: vec4u, d: vec4u, wx: f32, wy: f32) -> vec4u {\n  let top = vec4f(a) + (vec4f(b) - vec4f(a)) * wx;\n  let bottom = vec4f(c) + (vec4f(d) - vec4f(c)) * wx;\n  return vec4u(floor(top + (bottom - top) * wy + 0.5));\n}\n\nfn shadeImage(p: u32, pixel: vec2u) -> vec4u {\n  let fx = f32(pixel.x) + 0.5;\n  let fy = f32(pixel.y) + 0.5;\n  let x = word(p, 4u) * fx + word(p, 6u) * fy + word(p, 8u);\n  let y = word(p, 5u) * fx + word(p, 7u) * fy + word(p, 9u);\n  if abs(x) > 1.0e15 || abs(y) > 1.0e15 || x != x || y != y { return vec4u(0u); }\n  if paints[p + 10u] == 0u { return texel(p, floor(x), floor(y)); }\n  let x0 = floor(x - 0.5);\n  let y0 = floor(y - 0.5);\n  let wx = x - 0.5 - x0;\n  let wy = y - 0.5 - y0;\n  return bilerp(texel(p, x0, y0), texel(p, x0 + 1.0, y0), texel(p, x0, y0 + 1.0), texel(p, x0 + 1.0, y0 + 1.0), wx, wy);\n}\n\n// Paint records are 16 words: kind (0 solid, 1 linear, 2 radial, 3 image), color or ramp start,\n// spread, single, the device-to-gradient inverse a b c d e f, then x0 y0 r0 x1 y1 r1.\nfn shade(p: u32, pixel: vec2u) -> vec4u {\n  let kind = paints[p];\n  if kind == 0u { return unpack(paints[p + 1u]); }\n  if kind == 3u { return shadeImage(p, pixel); }\n  var index = 1023u;\n  if paints[p + 3u] == 0u {\n    let fx = f32(pixel.x) + 0.5;\n    let fy = f32(pixel.y) + 0.5;\n    let gx = word(p, 4u) * fx + word(p, 6u) * fy + word(p, 8u);\n    let gy = word(p, 5u) * fx + word(p, 7u) * fy + word(p, 9u);\n    let x0 = word(p, 10u);\n    let y0 = word(p, 11u);\n    let r0 = word(p, 12u);\n    let x1 = word(p, 13u);\n    let y1 = word(p, 14u);\n    let r1 = word(p, 15u);\n    var t = 0.0;\n    if kind == 1u {\n      let dx = x1 - x0;\n      let dy = y1 - y0;\n      t = ((gx - x0) * dx + (gy - y0) * dy) / (dx * dx + dy * dy);\n    } else {\n      let cdx = x1 - x0;\n      let cdy = y1 - y0;\n      let dr = r1 - r0;\n      let pdx = gx - x0;\n      let pdy = gy - y0;\n      let a = cdx * cdx + cdy * cdy - dr * dr;\n      let b = pdx * cdx + pdy * cdy + r0 * dr;\n      let c = pdx * pdx + pdy * pdy - r0 * r0;\n      if abs(a) < 1.0e-12 {\n        if b == 0.0 { return vec4u(0u); }\n        t = c / (2.0 * b);\n        if r0 + t * dr < 0.0 { return vec4u(0u); }\n      } else {\n        let disc = b * b - a * c;\n        if disc < 0.0 { return vec4u(0u); }\n        let root = sqrt(disc);\n        let t1 = max((b + root) / a, (b - root) / a);\n        let t2 = min((b + root) / a, (b - root) / a);\n        if r0 + t1 * dr >= 0.0 {\n          t = t1;\n        } else if r0 + t2 * dr >= 0.0 {\n          t = t2;\n        } else {\n          return vec4u(0u);\n        }\n      }\n    }\n    let spread = paints[p + 2u];\n    var s = clamp(t, 0.0, 1.0);\n    if spread == 2u {\n      s = t - floor(t);\n    } else if spread == 1u {\n      let m = t - 2.0 * floor(t * 0.5);\n      s = select(m, 2.0 - m, m > 1.0);\n    }\n    index = u32(floor(s * RAMP_LAST + 0.5));\n  }\n  return unpack(ramps[paints[p + 1u] + index]);\n}\n\n@fragment fn fs(v: Vertex) -> @location(0) vec4f {\n  let r = runs[v.run];\n  let pixel = vec2u(v.position.xy);\n  var alpha = 255u;\n  if r.alpha != SOLID_RUN {\n    alpha = (alphas[r.alpha + pixel.x - r.x] >> (8u * (pixel.y - r.y))) & 255u;\n  }\n  let mask = div255(alpha * r.opacity);\n  if mask == 0u { discard; }\n  let c = shade(r.paint, pixel);\n  let s = vec4u(div255(c.x * mask), div255(c.y * mask), div255(c.z * mask), div255(c.w * mask));\n  return vec4f(s) / 255.0;\n}\n" }
pub fn compose() -> &'static [u8] { return b"// Blend-mode math shared by compose.wgsl and filter.wgsl (scripts/embed-shaders prepends it),\n// matching vector.layer on premultiplied bytes.\n\nconst NORMAL: u32 = 0u;\nconst MULTIPLY: u32 = 1u;\nconst SCREEN: u32 = 2u;\nconst OVERLAY: u32 = 3u;\nconst DARKEN: u32 = 4u;\nconst LIGHTEN: u32 = 5u;\nconst COLOR_DODGE: u32 = 6u;\nconst COLOR_BURN: u32 = 7u;\nconst HARD_LIGHT: u32 = 8u;\nconst SOFT_LIGHT: u32 = 9u;\nconst DIFFERENCE: u32 = 10u;\nconst EXCLUSION: u32 = 11u;\nconst HUE: u32 = 12u;\nconst SATURATION: u32 = 13u;\nconst COLOR: u32 = 14u;\n\nfn div255(x: u32) -> u32 {\n  let t = x + 128u;\n  return (t + (t >> 8u)) >> 8u;\n}\n\nfn bytes(t: texture_2d<f32>, pixel: vec2u) -> vec4u {\n  return vec4u(round(textureLoad(t, pixel, 0) * 255.0));\n}\n\nfn toByte(v: f32) -> u32 { return u32(floor(clamp(v, 0.0, 1.0) * 255.0 + 0.5)); }\n\nfn hardLight(cb: f32, cs: f32) -> f32 {\n  if cs <= 0.5 { return cb * 2.0 * cs; }\n  let s = 2.0 * cs - 1.0;\n  return cb + s - cb * s;\n}\n\nfn separable(cb: f32, cs: f32, mode: u32) -> f32 {\n  switch mode {\n    case MULTIPLY: { return cb * cs; }\n    case SCREEN: { return cb + cs - cb * cs; }\n    case OVERLAY: { return hardLight(cs, cb); }\n    case DARKEN: { return min(cb, cs); }\n    case LIGHTEN: { return max(cb, cs); }\n    case COLOR_DODGE: {\n      if cb == 0.0 { return 0.0; }\n      if cs >= 1.0 { return 1.0; }\n      return min(1.0, cb / (1.0 - cs));\n    }\n    case COLOR_BURN: {\n      if cb >= 1.0 { return 1.0; }\n      if cs <= 0.0 { return 0.0; }\n      return 1.0 - min(1.0, (1.0 - cb) / cs);\n    }\n    case HARD_LIGHT: { return hardLight(cb, cs); }\n    case SOFT_LIGHT: {\n      if cs <= 0.5 { return cb - (1.0 - 2.0 * cs) * cb * (1.0 - cb); }\n      var d = sqrt(cb);\n      if cb <= 0.25 { d = ((16.0 * cb - 12.0) * cb + 4.0) * cb; }\n      return cb + (2.0 * cs - 1.0) * (d - cb);\n    }\n    case DIFFERENCE: { return abs(cb - cs); }\n    case EXCLUSION: { return cb + cs - 2.0 * cb * cs; }\n    default: { return cs; }\n  }\n}\n\nfn lum(c: vec3f) -> f32 { return 0.3 * c.x + 0.59 * c.y + 0.11 * c.z; }\n\nfn clipColor(c: vec3f) -> vec3f {\n  let l = lum(c);\n  let n = min(c.x, min(c.y, c.z));\n  let x = max(c.x, max(c.y, c.z));\n  var r = c;\n  if n < 0.0 { r = l + (r - l) * l / (l - n); }\n  if x > 1.0 { r = l + (r - l) * (1.0 - l) / (x - l); }\n  return r;\n}\n\nfn setLum(c: vec3f, l: f32) -> vec3f { return clipColor(c + (l - lum(c))); }\n\nfn sat(c: vec3f) -> f32 { return max(c.x, max(c.y, c.z)) - min(c.x, min(c.y, c.z)); }\n\nfn setSat(c: vec3f, s: f32) -> vec3f {\n  let mx = max(c.x, max(c.y, c.z));\n  let mn = min(c.x, min(c.y, c.z));\n  if mx <= mn { return vec3f(0.0); }\n  return (c - mn) * s / (mx - mn);\n}\n\n// co = cs (1 - ab) + cb (1 - as) + as ab B(Cb, Cs), ao = as + ab (1 - as), on premultiplied bytes.\nfn blend(b: vec4u, s: vec4u, mode: u32) -> vec4u {\n  if mode == NORMAL {\n    let inverse = 255u - s.w;\n    return s + vec4u(div255(b.x * inverse), div255(b.y * inverse), div255(b.z * inverse), div255(b.w * inverse));\n  }\n  let sa = f32(s.w) / 255.0;\n  let ba = f32(b.w) / 255.0;\n  if sa == 0.0 { return b; }\n  let sc = vec3f(f32(s.x) / 255.0, f32(s.y) / 255.0, f32(s.z) / 255.0);\n  let bc = vec3f(f32(b.x) / 255.0, f32(b.y) / 255.0, f32(b.z) / 255.0);\n  let cs = sc / sa;\n  var cb = vec3f(0.0);\n  if ba > 0.0 { cb = bc / ba; }\n  var r = vec3f(0.0);\n  if mode == HUE {\n    r = setLum(setSat(cs, sat(cb)), lum(cb));\n  } else if mode == SATURATION {\n    r = setLum(setSat(cb, sat(cs)), lum(cb));\n  } else if mode == COLOR {\n    r = setLum(cs, lum(cb));\n  } else if mode > COLOR {\n    r = setLum(cb, lum(cs));\n  } else {\n    r = vec3f(separable(cb.x, cs.x, mode), separable(cb.y, cs.y, mode), separable(cb.z, cs.z, mode));\n  }\n  let k = sa * ba;\n  let o = sc * (1.0 - ba) + bc * (1.0 - sa) + k * r;\n  return vec4u(toByte(o.x), toByte(o.y), toByte(o.z), toByte(sa + ba * (1.0 - sa)));\n}\n// Layer composition passes, matching vector.layer on the CPU: composite a group onto a copy of its\n// parent (blend modes, group opacity, masks), turn mask content into a mask, or copy a layer out.\n// Prepended with blend.wgsl.\nstruct Params { op: u32, mode: u32, opacity: u32, flags: u32 }\n@group(0) @binding(0) var<uniform> params: Params;\n@group(0) @binding(1) var backdrop: texture_2d<f32>;\n@group(0) @binding(2) var layer: texture_2d<f32>;\n@group(0) @binding(3) var mask: texture_2d<f32>;\n\nconst OP_COMPOSITE: u32 = 0u;\nconst OP_MASK: u32 = 1u;\nconst OP_COPY: u32 = 2u;\n// flags: bit 0 = a mask is bound, bit 1 = luminance (OP_MASK).\nconst HAS_MASK: u32 = 1u;\nconst LUMINANCE: u32 = 2u;\n\n@vertex fn vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {\n  // One triangle covering the target.\n  let p = vec2f(f32((index << 1u) & 2u), f32(index & 2u));\n  return vec4f(p * 2.0 - 1.0, 0.0, 1.0);\n}\n\nfn scale(c: vec4u, m: u32) -> vec4u {\n  if m == 255u { return c; }\n  return vec4u(div255(c.x * m), div255(c.y * m), div255(c.z * m), div255(c.w * m));\n}\n\n@fragment fn fs(@builtin(position) position: vec4f) -> @location(0) vec4f {\n  let pixel = vec2u(position.xy);\n  let content = bytes(layer, pixel);\n  if params.op == OP_COPY { return vec4f(content) / 255.0; }\n  var m = 255u;\n  if (params.flags & HAS_MASK) != 0u { m = bytes(mask, pixel).w; }\n  if params.op == OP_MASK {\n    var v = content.w;\n    if (params.flags & LUMINANCE) != 0u {\n      // Fixed point with weights summing to 65536, like Mask.fromLuminance.\n      v = (13926u * content.x + 46884u * content.y + 4726u * content.z + 32768u) >> 16u;\n    }\n    let value = f32(div255(v * m)) / 255.0;\n    return vec4f(value);\n  }\n  let b = bytes(backdrop, pixel);\n  let level = div255(m * params.opacity);\n  if level == 0u || content.w == 0u { return vec4f(b) / 255.0; }\n  return vec4f(blend(b, scale(content, level), params.mode)) / 255.0;\n}\n" }
pub fn filter() -> &'static [u8] { return b"// Blend-mode math shared by compose.wgsl and filter.wgsl (scripts/embed-shaders prepends it),\n// matching vector.layer on premultiplied bytes.\n\nconst NORMAL: u32 = 0u;\nconst MULTIPLY: u32 = 1u;\nconst SCREEN: u32 = 2u;\nconst OVERLAY: u32 = 3u;\nconst DARKEN: u32 = 4u;\nconst LIGHTEN: u32 = 5u;\nconst COLOR_DODGE: u32 = 6u;\nconst COLOR_BURN: u32 = 7u;\nconst HARD_LIGHT: u32 = 8u;\nconst SOFT_LIGHT: u32 = 9u;\nconst DIFFERENCE: u32 = 10u;\nconst EXCLUSION: u32 = 11u;\nconst HUE: u32 = 12u;\nconst SATURATION: u32 = 13u;\nconst COLOR: u32 = 14u;\n\nfn div255(x: u32) -> u32 {\n  let t = x + 128u;\n  return (t + (t >> 8u)) >> 8u;\n}\n\nfn bytes(t: texture_2d<f32>, pixel: vec2u) -> vec4u {\n  return vec4u(round(textureLoad(t, pixel, 0) * 255.0));\n}\n\nfn toByte(v: f32) -> u32 { return u32(floor(clamp(v, 0.0, 1.0) * 255.0 + 0.5)); }\n\nfn hardLight(cb: f32, cs: f32) -> f32 {\n  if cs <= 0.5 { return cb * 2.0 * cs; }\n  let s = 2.0 * cs - 1.0;\n  return cb + s - cb * s;\n}\n\nfn separable(cb: f32, cs: f32, mode: u32) -> f32 {\n  switch mode {\n    case MULTIPLY: { return cb * cs; }\n    case SCREEN: { return cb + cs - cb * cs; }\n    case OVERLAY: { return hardLight(cs, cb); }\n    case DARKEN: { return min(cb, cs); }\n    case LIGHTEN: { return max(cb, cs); }\n    case COLOR_DODGE: {\n      if cb == 0.0 { return 0.0; }\n      if cs >= 1.0 { return 1.0; }\n      return min(1.0, cb / (1.0 - cs));\n    }\n    case COLOR_BURN: {\n      if cb >= 1.0 { return 1.0; }\n      if cs <= 0.0 { return 0.0; }\n      return 1.0 - min(1.0, (1.0 - cb) / cs);\n    }\n    case HARD_LIGHT: { return hardLight(cb, cs); }\n    case SOFT_LIGHT: {\n      if cs <= 0.5 { return cb - (1.0 - 2.0 * cs) * cb * (1.0 - cb); }\n      var d = sqrt(cb);\n      if cb <= 0.25 { d = ((16.0 * cb - 12.0) * cb + 4.0) * cb; }\n      return cb + (2.0 * cs - 1.0) * (d - cb);\n    }\n    case DIFFERENCE: { return abs(cb - cs); }\n    case EXCLUSION: { return cb + cs - 2.0 * cb * cs; }\n    default: { return cs; }\n  }\n}\n\nfn lum(c: vec3f) -> f32 { return 0.3 * c.x + 0.59 * c.y + 0.11 * c.z; }\n\nfn clipColor(c: vec3f) -> vec3f {\n  let l = lum(c);\n  let n = min(c.x, min(c.y, c.z));\n  let x = max(c.x, max(c.y, c.z));\n  var r = c;\n  if n < 0.0 { r = l + (r - l) * l / (l - n); }\n  if x > 1.0 { r = l + (r - l) * (1.0 - l) / (x - l); }\n  return r;\n}\n\nfn setLum(c: vec3f, l: f32) -> vec3f { return clipColor(c + (l - lum(c))); }\n\nfn sat(c: vec3f) -> f32 { return max(c.x, max(c.y, c.z)) - min(c.x, min(c.y, c.z)); }\n\nfn setSat(c: vec3f, s: f32) -> vec3f {\n  let mx = max(c.x, max(c.y, c.z));\n  let mn = min(c.x, min(c.y, c.z));\n  if mx <= mn { return vec3f(0.0); }\n  return (c - mn) * s / (mx - mn);\n}\n\n// co = cs (1 - ab) + cb (1 - as) + as ab B(Cb, Cs), ao = as + ab (1 - as), on premultiplied bytes.\nfn blend(b: vec4u, s: vec4u, mode: u32) -> vec4u {\n  if mode == NORMAL {\n    let inverse = 255u - s.w;\n    return s + vec4u(div255(b.x * inverse), div255(b.y * inverse), div255(b.z * inverse), div255(b.w * inverse));\n  }\n  let sa = f32(s.w) / 255.0;\n  let ba = f32(b.w) / 255.0;\n  if sa == 0.0 { return b; }\n  let sc = vec3f(f32(s.x) / 255.0, f32(s.y) / 255.0, f32(s.z) / 255.0);\n  let bc = vec3f(f32(b.x) / 255.0, f32(b.y) / 255.0, f32(b.z) / 255.0);\n  let cs = sc / sa;\n  var cb = vec3f(0.0);\n  if ba > 0.0 { cb = bc / ba; }\n  var r = vec3f(0.0);\n  if mode == HUE {\n    r = setLum(setSat(cs, sat(cb)), lum(cb));\n  } else if mode == SATURATION {\n    r = setLum(setSat(cb, sat(cs)), lum(cb));\n  } else if mode == COLOR {\n    r = setLum(cs, lum(cb));\n  } else if mode > COLOR {\n    r = setLum(cb, lum(cs));\n  } else {\n    r = vec3f(separable(cb.x, cs.x, mode), separable(cb.y, cs.y, mode), separable(cb.z, cs.z, mode));\n  }\n  let k = sa * ba;\n  let o = sc * (1.0 - ba) + bc * (1.0 - sa) + k * r;\n  return vec4u(toByte(o.x), toByte(o.y), toByte(o.z), toByte(sa + ba * (1.0 - sa)));\n}\n// SVG filter primitive passes, matching vector.filter on the CPU byte for byte (the matrix and\n// arithmetic ones compute in f32 on both sides). Every pass writes the whole target: the result\n// inside the primitive subregion, transparent black outside it (feMerge keeps what is below).\n// Prepended with blend.wgsl.\nstruct Params {\n  op: u32,\n  p0: u32,\n  p1: u32,\n  p2: u32,\n  // x0, y0, x1, y1 in device pixels.\n  region: vec4u,\n  // Premultiplied flood color bytes.\n  color: vec4u,\n  // feComposite k1..k4.\n  k: vec4f,\n  // feColorMatrix rows, row-major in groups of four.\n  m: array<vec4f, 5>,\n}\n@group(0) @binding(0) var<uniform> params: Params;\n@group(0) @binding(1) var first: texture_2d<f32>;\n@group(0) @binding(2) var second: texture_2d<f32>;\n// Blur weights (fixed point, sum 65536) or a color conversion table of packed bytes.\n@group(0) @binding(3) var<storage, read> data: array<u32>;\n\nconst OP_FLOOD: u32 = 0u;\nconst OP_OFFSET: u32 = 1u;\nconst OP_MERGE: u32 = 2u;\nconst OP_COMPOSITE: u32 = 3u;\nconst OP_BLEND: u32 = 4u;\nconst OP_MATRIX: u32 = 5u;\nconst OP_BOX: u32 = 6u;\nconst OP_KERNEL: u32 = 7u;\nconst OP_CONVERT: u32 = 8u;\nconst OP_MORPHOLOGY: u32 = 9u;\nconst OP_TRANSFER: u32 = 10u;\nconst OP_TILE: u32 = 11u;\nconst OP_CONVOLVE: u32 = 12u;\nconst OP_DISPLACE: u32 = 13u;\nconst OP_TURBULENCE: u32 = 14u;\nconst OP_LIGHTING: u32 = 15u;\n\nconst EDGE_DUPLICATE: u32 = 0u;\nconst EDGE_NONE: u32 = 2u;\n\nconst COMPOSITE_IN: u32 = 1u;\nconst COMPOSITE_OUT: u32 = 2u;\nconst COMPOSITE_ATOP: u32 = 3u;\nconst COMPOSITE_XOR: u32 = 4u;\nconst COMPOSITE_LIGHTER: u32 = 5u;\nconst COMPOSITE_ARITHMETIC: u32 = 6u;\n\n@vertex fn vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {\n  // One triangle covering the target.\n  let p = vec2f(f32((index << 1u) & 2u), f32(index & 2u));\n  return vec4f(p * 2.0 - 1.0, 0.0, 1.0);\n}\n\nfn inside(pixel: vec2u) -> bool {\n  let r = params.region;\n  return pixel.x >= r.x && pixel.x < r.z && pixel.y >= r.y && pixel.y < r.w;\n}\n\nfn emit(c: vec4u) -> vec4f { return vec4f(c) / 255.0; }\n\nfn over(s: vec4u, b: vec4u) -> vec4u {\n  let inverse = 255u - s.w;\n  return s + vec4u(div255(b.x * inverse), div255(b.y * inverse), div255(b.z * inverse), div255(b.w * inverse));\n}\n\nfn arithmetic(i1: u32, i2: u32, limit: f32) -> u32 {\n  let a = f32(i1) / 255.0;\n  let b = f32(i2) / 255.0;\n  let k = params.k;\n  let v = k.x * a * b + k.y * a + k.z * b + k.w;\n  return u32(floor(min(max(v, 0.0), limit) * 255.0 + 0.5));\n}\n\nfn composite(s: vec4u, b: vec4u, kind: u32) -> vec4u {\n  if kind == COMPOSITE_ARITHMETIC {\n    let alpha = arithmetic(s.w, b.w, 1.0);\n    let limit = f32(alpha) / 255.0;\n    return vec4u(arithmetic(s.x, b.x, limit), arithmetic(s.y, b.y, limit), arithmetic(s.z, b.z, limit), alpha);\n  }\n  if kind == COMPOSITE_LIGHTER { return min(s + b, vec4u(255u)); }\n  var fs = 255u;\n  var fb = 255u - s.w;\n  if kind == COMPOSITE_IN {\n    fs = b.w;\n    fb = 0u;\n  } else if kind == COMPOSITE_OUT {\n    fs = 255u - b.w;\n    fb = 0u;\n  } else if kind == COMPOSITE_ATOP {\n    fs = b.w;\n  } else if kind == COMPOSITE_XOR {\n    fs = 255u - b.w;\n  }\n  let r = vec4u(div255(s.x * fs), div255(s.y * fs), div255(s.z * fs), div255(s.w * fs))\n    + vec4u(div255(b.x * fb), div255(b.y * fb), div255(b.z * fb), div255(b.w * fb));\n  return min(r, vec4u(255u));\n}\n\nfn clamp01(v: f32) -> f32 { return min(max(v, 0.0), 1.0); }\nfn byte(v: f32) -> u32 { return u32(floor(v * 255.0 + 0.5)); }\n\nfn matrix(c: vec4u) -> vec4u {\n  let a = f32(c.w) / 255.0;\n  var r = 0.0;\n  var g = 0.0;\n  var b = 0.0;\n  if c.w != 0u {\n    r = f32(c.x) / 255.0 / a;\n    g = f32(c.y) / 255.0 / a;\n    b = f32(c.z) / 255.0 / a;\n  }\n  let m = params.m;\n  let ro = clamp01(m[0].x * r + m[0].y * g + m[0].z * b + m[0].w * a + m[1].x);\n  let go = clamp01(m[1].y * r + m[1].z * g + m[1].w * b + m[2].x * a + m[2].y);\n  let bo = clamp01(m[2].z * r + m[2].w * g + m[3].x * b + m[3].y * a + m[3].z);\n  let ao = clamp01(m[3].w * r + m[4].x * g + m[4].y * b + m[4].z * a + m[4].w);\n  return vec4u(byte(ro * ao), byte(go * ao), byte(bo * ao), byte(ao));\n}\n\n// The pixel `j` places from the start of the region along the blur axis, transparent past it.\nfn lineSample(pixel: vec2u, j: i32) -> vec4u {\n  let r = params.region;\n  if params.p0 == 1u {\n    let n = i32(r.z - r.x);\n    if j < 0 || j >= n { return vec4u(0u); }\n    return bytes(first, vec2u(r.x + u32(j), pixel.y));\n  }\n  let n = i32(r.w - r.y);\n  if j < 0 || j >= n { return vec4u(0u); }\n  return bytes(first, vec2u(pixel.x, r.y + u32(j)));\n}\n\nfn linePosition(pixel: vec2u) -> i32 {\n  if params.p0 == 1u { return i32(pixel.x - params.region.x); }\n  return i32(pixel.y - params.region.y);\n}\n\n// Output `i` averages inputs `i - left .. i - left + size`, rounded to nearest.\nfn boxBlur(pixel: vec2u) -> vec4u {\n  let size = params.p1;\n  let start = linePosition(pixel) - i32(params.p2);\n  var sum = vec4u(0u);\n  for (var k = 0; k < i32(size); k++) { sum += lineSample(pixel, start + k); }\n  return (sum + size / 2u) / size;\n}\n\nfn kernelBlur(pixel: vec2u) -> vec4u {\n  let count = params.p1;\n  let start = linePosition(pixel) - i32(count / 2u);\n  var sum = vec4u(0u);\n  for (var k = 0u; k < count; k++) { sum += lineSample(pixel, start + i32(k)) * data[k]; }\n  return (sum + 32768u) >> vec4u(16u);\n}\n\nfn table(c: u32, a: u32) -> u32 { return dataByte(a * 256u + c); }\n\nfn dataByte(index: u32) -> u32 { return (data[index >> 2u] >> ((index & 3u) * 8u)) & 255u; }\n\nfn unpremultiplyByte(c: u32, a: u32) -> u32 {\n  if a == 0u { return 0u; }\n  return min((c * 255u + a / 2u) / a, 255u);\n}\n\n// One axis of feMorphology: min (erode) or max (dilate) over `radius` pixels each way, with\n// transparent pixels past the region.\nfn morphology(pixel: vec2u) -> vec4u {\n  let r = params.region;\n  let horizontal = params.p0 == 1u;\n  let radius = params.p1;\n  let dilate = params.p2 == 1u;\n  var p = pixel.y;\n  var lo = r.y;\n  var hi = r.w;\n  if horizontal {\n    p = pixel.x;\n    lo = r.x;\n    hi = r.z;\n  }\n  var v = vec4u(255u);\n  if dilate || (p < lo + radius || p + radius >= hi) { v = vec4u(0u); }\n  var start = lo;\n  if p >= lo + radius { start = p - radius; }\n  let end = min(p + radius + 1u, hi);\n  for (var q = start; q < end; q++) {\n    var at = vec2u(pixel.x, q);\n    if horizontal { at = vec2u(q, pixel.y); }\n    let c = bytes(first, at);\n    if dilate { v = max(v, c); } else { v = min(v, c); }\n  }\n  return v;\n}\n\n// feComponentTransfer: four 256-byte tables (r, g, b, a) on unpremultiplied bytes.\nfn transfer(c: vec4u) -> vec4u {\n  let a = dataByte(768u + c.w);\n  return vec4u(div255(dataByte(unpremultiplyByte(c.x, c.w)) * a), div255(dataByte(256u + unpremultiplyByte(c.y, c.w)) * a),\n    div255(dataByte(512u + unpremultiplyByte(c.z, c.w)) * a), a);\n}\n\n// `(p - origin) mod size`, non-negative.\nfn wrapIndex(p: u32, origin: u32, size: u32) -> u32 {\n  if p >= origin { return (p - origin) % size; }\n  let m = (origin - p) % size;\n  if m == 0u { return 0u; }\n  return size - m;\n}\n\n// feTile: `params.color` holds the source rectangle.\nfn tile(pixel: vec2u) -> vec4u {\n  let t = params.color;\n  if t.z == t.x || t.w == t.y { return vec4u(0u); }\n  return bytes(first, vec2u(t.x + wrapIndex(pixel.x, t.x, t.z - t.x), t.y + wrapIndex(pixel.y, t.y, t.w - t.y)));\n}\n\nfn edgePixel(x: i32, y: i32, edgeMode: u32) -> vec4u {\n  let r = vec4i(params.region);\n  let w = r.z - r.x;\n  let h = r.w - r.y;\n  var px = x - r.x;\n  var py = y - r.y;\n  if px < 0 || py < 0 || px >= w || py >= h {\n    if edgeMode == EDGE_NONE { return vec4u(0u); }\n    if edgeMode == EDGE_DUPLICATE {\n      px = clamp(px, 0, w - 1);\n      py = clamp(py, 0, h - 1);\n    } else {\n      px = ((px % w) + w) % w;\n      py = ((py % h) + h) % h;\n    }\n  }\n  return bytes(first, vec2u(u32(r.x + px), u32(r.y + py)));\n}\n\n// feConvolveMatrix: p0 orderX, p1 orderY, p2 edge mode | preserveAlpha << 8, color.xy the\n// target, k.x the divisor, k.y the bias, data the kernel as f32 bits.\nfn convolve(pixel: vec2u) -> vec4u {\n  let orderX = params.p0;\n  let orderY = params.p1;\n  let edgeMode = params.p2 & 255u;\n  let preserveAlpha = (params.p2 >> 8u) != 0u;\n  let divisor = params.k.x;\n  let bias = params.k.y;\n  var sr = 0.0;\n  var sg = 0.0;\n  var sb = 0.0;\n  var sa = 0.0;\n  for (var i = 0u; i < orderY; i++) {\n    for (var j = 0u; j < orderX; j++) {\n      let c = edgePixel(i32(pixel.x) - i32(params.color.x) + i32(j), i32(pixel.y) - i32(params.color.y) + i32(i), edgeMode);\n      let w = bitcast<f32>(data[(orderY - i - 1u) * orderX + (orderX - j - 1u)]);\n      if preserveAlpha {\n        sr = sr + w * f32(unpremultiplyByte(c.x, c.w)) / 255.0;\n        sg = sg + w * f32(unpremultiplyByte(c.y, c.w)) / 255.0;\n        sb = sb + w * f32(unpremultiplyByte(c.z, c.w)) / 255.0;\n      } else {\n        sr = sr + w * f32(c.x) / 255.0;\n        sg = sg + w * f32(c.y) / 255.0;\n        sb = sb + w * f32(c.z) / 255.0;\n        sa = sa + w * f32(c.w) / 255.0;\n      }\n    }\n  }\n  if preserveAlpha {\n    let a = bytes(first, pixel).w;\n    return vec4u(div255(byte(clamp01(sr / divisor + bias)) * a), div255(byte(clamp01(sg / divisor + bias)) * a),\n      div255(byte(clamp01(sb / divisor + bias)) * a), a);\n  }\n  let alpha = clamp01(sa / divisor + bias);\n  return vec4u(byte(min(clamp01(sr / divisor + bias * alpha), alpha)), byte(min(clamp01(sg / divisor + bias * alpha), alpha)),\n    byte(min(clamp01(sb / divisor + bias * alpha), alpha)), byte(alpha));\n}\n\nfn channelOf(c: vec4u, channel: u32) -> u32 {\n  if channel == 3u { return c.w; }\n  return unpremultiplyByte(c[channel], c.w);\n}\n\n// feDisplacementMap: `second` is the map, data the per-byte displacement, p0/p1 the channels.\nfn displace(pixel: vec2u) -> vec4u {\n  let m = bytes(second, pixel);\n  let source = vec2i(pixel) + vec2i(bitcast<i32>(data[channelOf(m, params.p0)]), bitcast<i32>(data[channelOf(m, params.p1)]));\n  let size = vec2i(textureDimensions(first));\n  if any(source < vec2i(0)) || any(source >= size) { return vec4u(0u); }\n  return bytes(first, vec2u(source));\n}\n\n// feTurbulence, the spec's reference noise in f32. data holds the 514-entry lattice, then the\n// gradients as f32 bits at 514 + (channel * 514 + index) * 2 + component. p0 is the octave\n// count, p1 bit 0 fractal noise and bit 1 stitching, k.xy the (stitch-adjusted) base\n// frequencies, color the stitch width, height, wrapX and wrapY, and m[0], m[1].xy the\n// device-to-user transform a..f.\nfn lattice(i: i32) -> i32 { return i32(data[i]); }\nfn gradient(channel: u32, index: i32) -> vec2f {\n  let at = 514u + (channel * 514u + u32(index)) * 2u;\n  return vec2f(bitcast<f32>(data[at]), bitcast<f32>(data[at + 1u]));\n}\n\nfn noise2(channel: u32, v: vec2f, stitching: bool, stitch: vec4i) -> f32 {\n  // floor(v) + 4096 equals the reference's (int)(v + 4096) without losing f32 bits to the sum.\n  let cell = floor(v);\n  var bx0 = i32(cell.x) + 4096;\n  var by0 = i32(cell.y) + 4096;\n  var bx1 = bx0 + 1;\n  var by1 = by0 + 1;\n  let rx0 = v.x - cell.x;\n  let ry0 = v.y - cell.y;\n  let rx1 = rx0 - 1.0;\n  let ry1 = ry0 - 1.0;\n  if stitching {\n    if bx0 >= stitch.z { bx0 -= stitch.x; }\n    if bx1 >= stitch.z { bx1 -= stitch.x; }\n    if by0 >= stitch.w { by0 -= stitch.y; }\n    if by1 >= stitch.w { by1 -= stitch.y; }\n  }\n  bx0 &= 255;\n  bx1 &= 255;\n  by0 &= 255;\n  by1 &= 255;\n  let i = lattice(bx0);\n  let j = lattice(bx1);\n  let b00 = lattice(i + by0);\n  let b10 = lattice(j + by0);\n  let b01 = lattice(i + by1);\n  let b11 = lattice(j + by1);\n  let sx = rx0 * rx0 * (3.0 - 2.0 * rx0);\n  let sy = ry0 * ry0 * (3.0 - 2.0 * ry0);\n  var q = gradient(channel, b00);\n  let u0 = rx0 * q.x + ry0 * q.y;\n  q = gradient(channel, b10);\n  let v0 = rx1 * q.x + ry0 * q.y;\n  let a = u0 + sx * (v0 - u0);\n  q = gradient(channel, b01);\n  let u1 = rx0 * q.x + ry1 * q.y;\n  q = gradient(channel, b11);\n  let v1 = rx1 * q.x + ry1 * q.y;\n  let b = u1 + sx * (v1 - u1);\n  return a + sy * (b - a);\n}\n\nfn turbulence(pixel: vec2u) -> vec4u {\n  let m = params.m;\n  let p = vec2f(pixel);\n  let user = vec2f(m[0].x * p.x + m[0].z * p.y + m[1].x, m[0].y * p.x + m[0].w * p.y + m[1].y);\n  let fractal = (params.p1 & 1u) != 0u;\n  let stitching = (params.p1 & 2u) != 0u;\n  var c = vec4f(0.0);\n  for (var channel = 0u; channel < 4u; channel++) {\n    var v = user * params.k.xy;\n    var stitch = vec4i(params.color);\n    var sum = 0.0;\n    var ratio = 1.0;\n    for (var octave = 0u; octave < params.p0; octave++) {\n      let n = noise2(channel, v, stitching, stitch);\n      if fractal { sum += n / ratio; } else { sum += abs(n) / ratio; }\n      v *= 2.0;\n      ratio *= 2.0;\n      stitch = vec4i(stitch.x * 2, stitch.y * 2, 2 * stitch.z - 4096, 2 * stitch.w - 4096);\n    }\n    if fractal { sum = (sum + 1.0) / 2.0; }\n    c[channel] = sum;\n  }\n  let a = byte(clamp01(c.w));\n  return vec4u(div255(byte(clamp01(c.x)) * a), div255(byte(clamp01(c.y)) * a), div255(byte(clamp01(c.z)) * a), a);\n}\n\n// feDiffuseLighting and feSpecularLighting: p0 bit 0 specular, bits 8.. the light kind; k the\n// surface scale, constant, exponent and cone cosine; color the lighting color; m[0] the distant\n// direction and spot exponent, m[1] the position, m[2] the spot direction.\nfn alphaAt(x: u32, y: u32) -> f32 { return f32(bytes(first, vec2u(x, y)).w) / 255.0; }\n\nfn surfaceNormal(x: u32, y: u32, surfaceScale: f32) -> vec2f {\n  let r = params.region;\n  var left = x;\n  if x > r.x { left = x - 1u; }\n  var right = x;\n  if x + 1u < r.z { right = x + 1u; }\n  var top = y;\n  if y > r.y { top = y - 1u; }\n  var bottom = y;\n  if y + 1u < r.w { bottom = y + 1u; }\n  var nx = 0.0;\n  if right > left {\n    var weight = 2.0;\n    var sum = 2.0 * (alphaAt(right, y) - alphaAt(left, y));\n    if top < y {\n      sum = sum + (alphaAt(right, top) - alphaAt(left, top));\n      weight = weight + 1.0;\n    }\n    if bottom > y {\n      sum = sum + (alphaAt(right, bottom) - alphaAt(left, bottom));\n      weight = weight + 1.0;\n    }\n    nx = 0.0 - surfaceScale * 2.0 / (f32(right - left) * weight) * sum;\n  }\n  var ny = 0.0;\n  if bottom > top {\n    var weight = 2.0;\n    var sum = 2.0 * (alphaAt(x, bottom) - alphaAt(x, top));\n    if left < x {\n      sum = sum + (alphaAt(left, bottom) - alphaAt(left, top));\n      weight = weight + 1.0;\n    }\n    if right > x {\n      sum = sum + (alphaAt(right, bottom) - alphaAt(right, top));\n      weight = weight + 1.0;\n    }\n    ny = 0.0 - surfaceScale * 2.0 / (f32(bottom - top) * weight) * sum;\n  }\n  return vec2f(nx, ny);\n}\n\nfn powUnit(base: f32, power: f32) -> f32 {\n  if power == 0.0 { return 1.0; }\n  if base <= 0.0 { return 0.0; }\n  return pow(base, power);\n}\n\nfn lighting(pixel: vec2u) -> vec4u {\n  let specular = (params.p0 & 1u) != 0u;\n  let kind = params.p0 >> 8u;\n  let surfaceScale = params.k.x;\n  let n = surfaceNormal(pixel.x, pixel.y, surfaceScale);\n  let z = surfaceScale * alphaAt(pixel.x, pixel.y);\n  let m = params.m;\n  let nLength = sqrt(n.x * n.x + n.y * n.y + 1.0);\n  var l = m[0].xyz;\n  if kind != 0u {\n    l = m[1].xyz - vec3f(f32(pixel.x), f32(pixel.y), z);\n    let length = sqrt(l.x * l.x + l.y * l.y + l.z * l.z);\n    if length > 0.0 { l = l / length; }\n  }\n  var scale = 1.0;\n  if kind == 2u {\n    let minusLDotS = 0.0 - (l.x * m[2].x + l.y * m[2].y + l.z * m[2].z);\n    if minusLDotS <= 0.0 || minusLDotS < params.k.w { scale = 0.0; } else { scale = powUnit(minusLDotS, m[0].w); }\n  }\n  var factor = 0.0;\n  if specular {\n    let h = vec3f(l.x, l.y, l.z + 1.0);\n    let hLength = sqrt(h.x * h.x + h.y * h.y + h.z * h.z);\n    if hLength > 0.0 {\n      let nDotH = (n.x * h.x + n.y * h.y + h.z) / (nLength * hLength);\n      factor = params.k.y * powUnit(min(max(nDotH, 0.0), 1.0), params.k.z);\n    }\n  } else {\n    let nDotL = (n.x * l.x + n.y * l.y + l.z) / nLength;\n    factor = params.k.y * max(nDotL, 0.0);\n  }\n  let k = factor * scale;\n  let color = params.color;\n  let r = clamp01(k * f32(color.x) / 255.0);\n  let g = clamp01(k * f32(color.y) / 255.0);\n  let b = clamp01(k * f32(color.z) / 255.0);\n  if !specular { return vec4u(byte(r), byte(g), byte(b), 255u); }\n  let a = byte(max(r, max(g, b)));\n  return vec4u(div255(byte(r) * a), div255(byte(g) * a), div255(byte(b) * a), a);\n}\n\n@fragment fn fs(@builtin(position) position: vec4f) -> @location(0) vec4f {\n  let pixel = vec2u(position.xy);\n  if params.op == OP_CONVERT {\n    let c = bytes(first, pixel);\n    if c.w == 0u { return emit(c); }\n    return emit(vec4u(table(c.x, c.w), table(c.y, c.w), table(c.z, c.w), c.w));\n  }\n  if !inside(pixel) {\n    if params.op == OP_MERGE { return emit(bytes(first, pixel)); }\n    return vec4f(0.0);\n  }\n  switch params.op {\n    case OP_FLOOD: { return emit(params.color); }\n    case OP_OFFSET: {\n      let source = vec2i(pixel) - vec2i(i32(params.p0), i32(params.p1));\n      let size = vec2i(textureDimensions(first));\n      if any(source < vec2i(0)) || any(source >= size) { return vec4f(0.0); }\n      return emit(bytes(first, vec2u(source)));\n    }\n    case OP_MERGE: { return emit(over(bytes(second, pixel), bytes(first, pixel))); }\n    case OP_COMPOSITE: { return emit(composite(bytes(first, pixel), bytes(second, pixel), params.p0)); }\n    case OP_BLEND: {\n      let s = bytes(first, pixel);\n      let b = bytes(second, pixel);\n      if s.w == 0u { return emit(b); }\n      return emit(blend(b, s, params.p0));\n    }\n    case OP_MATRIX: { return emit(matrix(bytes(first, pixel))); }\n    case OP_BOX: { return emit(boxBlur(pixel)); }\n    case OP_KERNEL: { return emit(kernelBlur(pixel)); }\n    case OP_MORPHOLOGY: { return emit(morphology(pixel)); }\n    case OP_TRANSFER: { return emit(transfer(bytes(first, pixel))); }\n    case OP_TILE: { return emit(tile(pixel)); }\n    case OP_CONVOLVE: { return emit(convolve(pixel)); }\n    case OP_DISPLACE: { return emit(displace(pixel)); }\n    case OP_TURBULENCE: { return emit(turbulence(pixel)); }\n    case OP_LIGHTING: { return emit(lighting(pixel)); }\n    default: { return vec4f(0.0); }\n  }\n}\n" }
