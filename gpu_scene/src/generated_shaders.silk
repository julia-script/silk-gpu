// Generated by scripts/embed-shaders from gpu_scene/shaders; do not edit.
pub fn scene() -> &'static [u8] { return b"// Sparse-strip scene renderer: one instance per strip or fill run, painted and composited\n// source-over with exact integer masking so output matches vector's CPU pixmap.\nstruct Canvas { width: u32, height: u32, runs: u32, unused: u32 }\nstruct Run { x: u32, y: u32, width: u32, alpha: u32, paint: u32, opacity: u32 }\n@group(0) @binding(0) var<uniform> canvas: Canvas;\n@group(0) @binding(1) var<storage, read> runs: array<Run>;\n@group(0) @binding(2) var<storage, read> alphas: array<u32>;\n@group(0) @binding(3) var<storage, read> paints: array<u32>;\n@group(0) @binding(4) var<storage, read> ramps: array<u32>;\n\nconst BAND: u32 = 4u;\nconst SOLID_RUN: u32 = 0xffffffffu;\nconst RAMP_LAST: f32 = 1023.0;\n\nstruct Vertex { @builtin(position) position: vec4f, @location(0) @interpolate(flat) run: u32 }\n\n@vertex fn vs(@builtin(vertex_index) corner: u32, @builtin(instance_index) index: u32) -> Vertex {\n  let r = runs[index];\n  let corners = array<vec2u, 6>(vec2u(0u, 0u), vec2u(1u, 0u), vec2u(0u, 1u), vec2u(0u, 1u), vec2u(1u, 0u), vec2u(1u, 1u));\n  let c = corners[corner];\n  let x = f32(r.x + c.x * r.width);\n  let y = f32(min(r.y + c.y * BAND, canvas.height));\n  return Vertex(vec4f(x / f32(canvas.width) * 2.0 - 1.0, 1.0 - y / f32(canvas.height) * 2.0, 0.0, 1.0), index);\n}\n\nfn div255(x: u32) -> u32 {\n  let t = x + 128u;\n  return (t + (t >> 8u)) >> 8u;\n}\n\nfn unpack(c: u32) -> vec4u {\n  return vec4u(c & 255u, (c >> 8u) & 255u, (c >> 16u) & 255u, c >> 24u);\n}\n\nfn word(p: u32, i: u32) -> f32 { return bitcast<f32>(paints[p + i]); }\n\n// Paint records are 16 words: kind (0 solid, 1 linear, 2 radial), color or ramp start, spread,\n// single, the device-to-gradient inverse a b c d e f, then x0 y0 r0 x1 y1 r1.\nfn shade(p: u32, pixel: vec2u) -> vec4u {\n  let kind = paints[p];\n  if kind == 0u { return unpack(paints[p + 1u]); }\n  var index = 1023u;\n  if paints[p + 3u] == 0u {\n    let fx = f32(pixel.x) + 0.5;\n    let fy = f32(pixel.y) + 0.5;\n    let gx = word(p, 4u) * fx + word(p, 6u) * fy + word(p, 8u);\n    let gy = word(p, 5u) * fx + word(p, 7u) * fy + word(p, 9u);\n    let x0 = word(p, 10u);\n    let y0 = word(p, 11u);\n    let r0 = word(p, 12u);\n    let x1 = word(p, 13u);\n    let y1 = word(p, 14u);\n    let r1 = word(p, 15u);\n    var t = 0.0;\n    if kind == 1u {\n      let dx = x1 - x0;\n      let dy = y1 - y0;\n      t = ((gx - x0) * dx + (gy - y0) * dy) / (dx * dx + dy * dy);\n    } else {\n      let cdx = x1 - x0;\n      let cdy = y1 - y0;\n      let dr = r1 - r0;\n      let pdx = gx - x0;\n      let pdy = gy - y0;\n      let a = cdx * cdx + cdy * cdy - dr * dr;\n      let b = pdx * cdx + pdy * cdy + r0 * dr;\n      let c = pdx * pdx + pdy * pdy - r0 * r0;\n      if abs(a) < 1.0e-12 {\n        if b == 0.0 { return vec4u(0u); }\n        t = c / (2.0 * b);\n        if r0 + t * dr < 0.0 { return vec4u(0u); }\n      } else {\n        let disc = b * b - a * c;\n        if disc < 0.0 { return vec4u(0u); }\n        let root = sqrt(disc);\n        let t1 = max((b + root) / a, (b - root) / a);\n        let t2 = min((b + root) / a, (b - root) / a);\n        if r0 + t1 * dr >= 0.0 {\n          t = t1;\n        } else if r0 + t2 * dr >= 0.0 {\n          t = t2;\n        } else {\n          return vec4u(0u);\n        }\n      }\n    }\n    let spread = paints[p + 2u];\n    var s = clamp(t, 0.0, 1.0);\n    if spread == 2u {\n      s = t - floor(t);\n    } else if spread == 1u {\n      let m = t - 2.0 * floor(t * 0.5);\n      s = select(m, 2.0 - m, m > 1.0);\n    }\n    index = u32(floor(s * RAMP_LAST + 0.5));\n  }\n  return unpack(ramps[paints[p + 1u] + index]);\n}\n\n@fragment fn fs(v: Vertex) -> @location(0) vec4f {\n  let r = runs[v.run];\n  let pixel = vec2u(v.position.xy);\n  var alpha = 255u;\n  if r.alpha != SOLID_RUN {\n    alpha = (alphas[r.alpha + pixel.x - r.x] >> (8u * (pixel.y - r.y))) & 255u;\n  }\n  let mask = div255(alpha * r.opacity);\n  if mask == 0u { discard; }\n  let c = shade(r.paint, pixel);\n  let s = vec4u(div255(c.x * mask), div255(c.y * mask), div255(c.z * mask), div255(c.w * mask));\n  return vec4f(s) / 255.0;\n}\n" }
pub fn compose() -> &'static [u8] { return b"// Layer composition passes, matching vector.layer on the CPU: composite a group onto a copy of its\n// parent (blend modes, group opacity, masks), turn mask content into a mask, or copy a layer out.\nstruct Params { op: u32, mode: u32, opacity: u32, flags: u32 }\n@group(0) @binding(0) var<uniform> params: Params;\n@group(0) @binding(1) var backdrop: texture_2d<f32>;\n@group(0) @binding(2) var layer: texture_2d<f32>;\n@group(0) @binding(3) var mask: texture_2d<f32>;\n\nconst OP_COMPOSITE: u32 = 0u;\nconst OP_MASK: u32 = 1u;\nconst OP_COPY: u32 = 2u;\n// flags: bit 0 = a mask is bound, bit 1 = luminance (OP_MASK).\nconst HAS_MASK: u32 = 1u;\nconst LUMINANCE: u32 = 2u;\n\nconst NORMAL: u32 = 0u;\nconst MULTIPLY: u32 = 1u;\nconst SCREEN: u32 = 2u;\nconst OVERLAY: u32 = 3u;\nconst DARKEN: u32 = 4u;\nconst LIGHTEN: u32 = 5u;\nconst COLOR_DODGE: u32 = 6u;\nconst COLOR_BURN: u32 = 7u;\nconst HARD_LIGHT: u32 = 8u;\nconst SOFT_LIGHT: u32 = 9u;\nconst DIFFERENCE: u32 = 10u;\nconst EXCLUSION: u32 = 11u;\nconst HUE: u32 = 12u;\nconst SATURATION: u32 = 13u;\nconst COLOR: u32 = 14u;\n\n@vertex fn vs(@builtin(vertex_index) index: u32) -> @builtin(position) vec4f {\n  // One triangle covering the target.\n  let p = vec2f(f32((index << 1u) & 2u), f32(index & 2u));\n  return vec4f(p * 2.0 - 1.0, 0.0, 1.0);\n}\n\nfn div255(x: u32) -> u32 {\n  let t = x + 128u;\n  return (t + (t >> 8u)) >> 8u;\n}\n\nfn bytes(t: texture_2d<f32>, pixel: vec2u) -> vec4u {\n  return vec4u(round(textureLoad(t, pixel, 0) * 255.0));\n}\n\nfn scale(c: vec4u, m: u32) -> vec4u {\n  if m == 255u { return c; }\n  return vec4u(div255(c.x * m), div255(c.y * m), div255(c.z * m), div255(c.w * m));\n}\n\nfn toByte(v: f32) -> u32 { return u32(floor(clamp(v, 0.0, 1.0) * 255.0 + 0.5)); }\n\nfn hardLight(cb: f32, cs: f32) -> f32 {\n  if cs <= 0.5 { return cb * 2.0 * cs; }\n  let s = 2.0 * cs - 1.0;\n  return cb + s - cb * s;\n}\n\nfn separable(cb: f32, cs: f32, mode: u32) -> f32 {\n  switch mode {\n    case MULTIPLY: { return cb * cs; }\n    case SCREEN: { return cb + cs - cb * cs; }\n    case OVERLAY: { return hardLight(cs, cb); }\n    case DARKEN: { return min(cb, cs); }\n    case LIGHTEN: { return max(cb, cs); }\n    case COLOR_DODGE: {\n      if cb == 0.0 { return 0.0; }\n      if cs >= 1.0 { return 1.0; }\n      return min(1.0, cb / (1.0 - cs));\n    }\n    case COLOR_BURN: {\n      if cb >= 1.0 { return 1.0; }\n      if cs <= 0.0 { return 0.0; }\n      return 1.0 - min(1.0, (1.0 - cb) / cs);\n    }\n    case HARD_LIGHT: { return hardLight(cb, cs); }\n    case SOFT_LIGHT: {\n      if cs <= 0.5 { return cb - (1.0 - 2.0 * cs) * cb * (1.0 - cb); }\n      var d = sqrt(cb);\n      if cb <= 0.25 { d = ((16.0 * cb - 12.0) * cb + 4.0) * cb; }\n      return cb + (2.0 * cs - 1.0) * (d - cb);\n    }\n    case DIFFERENCE: { return abs(cb - cs); }\n    case EXCLUSION: { return cb + cs - 2.0 * cb * cs; }\n    default: { return cs; }\n  }\n}\n\nfn lum(c: vec3f) -> f32 { return 0.3 * c.x + 0.59 * c.y + 0.11 * c.z; }\n\nfn clipColor(c: vec3f) -> vec3f {\n  let l = lum(c);\n  let n = min(c.x, min(c.y, c.z));\n  let x = max(c.x, max(c.y, c.z));\n  var r = c;\n  if n < 0.0 { r = l + (r - l) * l / (l - n); }\n  if x > 1.0 { r = l + (r - l) * (1.0 - l) / (x - l); }\n  return r;\n}\n\nfn setLum(c: vec3f, l: f32) -> vec3f { return clipColor(c + (l - lum(c))); }\n\nfn sat(c: vec3f) -> f32 { return max(c.x, max(c.y, c.z)) - min(c.x, min(c.y, c.z)); }\n\nfn setSat(c: vec3f, s: f32) -> vec3f {\n  let mx = max(c.x, max(c.y, c.z));\n  let mn = min(c.x, min(c.y, c.z));\n  if mx <= mn { return vec3f(0.0); }\n  return (c - mn) * s / (mx - mn);\n}\n\n// co = cs (1 - ab) + cb (1 - as) + as ab B(Cb, Cs), ao = as + ab (1 - as), on premultiplied bytes.\nfn blend(b: vec4u, s: vec4u, mode: u32) -> vec4u {\n  if mode == NORMAL {\n    let inverse = 255u - s.w;\n    return s + vec4u(div255(b.x * inverse), div255(b.y * inverse), div255(b.z * inverse), div255(b.w * inverse));\n  }\n  let sa = f32(s.w) / 255.0;\n  let ba = f32(b.w) / 255.0;\n  if sa == 0.0 { return b; }\n  let sc = vec3f(f32(s.x) / 255.0, f32(s.y) / 255.0, f32(s.z) / 255.0);\n  let bc = vec3f(f32(b.x) / 255.0, f32(b.y) / 255.0, f32(b.z) / 255.0);\n  let cs = sc / sa;\n  var cb = vec3f(0.0);\n  if ba > 0.0 { cb = bc / ba; }\n  var r = vec3f(0.0);\n  if mode == HUE {\n    r = setLum(setSat(cs, sat(cb)), lum(cb));\n  } else if mode == SATURATION {\n    r = setLum(setSat(cb, sat(cs)), lum(cb));\n  } else if mode == COLOR {\n    r = setLum(cs, lum(cb));\n  } else if mode > COLOR {\n    r = setLum(cb, lum(cs));\n  } else {\n    r = vec3f(separable(cb.x, cs.x, mode), separable(cb.y, cs.y, mode), separable(cb.z, cs.z, mode));\n  }\n  let k = sa * ba;\n  let o = sc * (1.0 - ba) + bc * (1.0 - sa) + k * r;\n  return vec4u(toByte(o.x), toByte(o.y), toByte(o.z), toByte(sa + ba * (1.0 - sa)));\n}\n\n@fragment fn fs(@builtin(position) position: vec4f) -> @location(0) vec4f {\n  let pixel = vec2u(position.xy);\n  let content = bytes(layer, pixel);\n  if params.op == OP_COPY { return vec4f(content) / 255.0; }\n  var m = 255u;\n  if (params.flags & HAS_MASK) != 0u { m = bytes(mask, pixel).w; }\n  if params.op == OP_MASK {\n    var v = content.w;\n    if (params.flags & LUMINANCE) != 0u {\n      // Fixed point with weights summing to 65536, like Mask.fromLuminance.\n      v = (13926u * content.x + 46884u * content.y + 4726u * content.z + 32768u) >> 16u;\n    }\n    let value = f32(div255(v * m)) / 255.0;\n    return vec4f(value);\n  }\n  let b = bytes(backdrop, pixel);\n  let level = div255(m * params.opacity);\n  if level == 0u || content.w == 0u { return vec4f(b) / 255.0; }\n  return vec4f(blend(b, scale(content, level), params.mode)) / 255.0;\n}\n" }
