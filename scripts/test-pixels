#!/usr/bin/env python3
"""Build and run all six headless samples, then compare against analytic PNGs."""
import argparse
from pathlib import Path
import subprocess
import sys

from _build import ROOT, build

sys.path.insert(0, str(ROOT / 'tests' / 'pixels'))
from harness import NAMES, check_directory

parser = argparse.ArgumentParser(description=__doc__)
mode = parser.add_mutually_exclusive_group()
mode.add_argument('--binary', type=Path, help='use an already-built native sample executable')
mode.add_argument('--actual', type=Path, help='compare existing raw artifacts, including browser output; do not run a GPU')
parser.add_argument('--output', type=Path, default=ROOT / '.cache' / 'pixels' / 'native')
parser.add_argument('--timeout', type=float, default=120, help='sample process deadline in seconds')
args = parser.parse_args()
if args.actual:
    check_directory(args.actual.resolve())
else:
    binary = args.binary.resolve() if args.binary else build(ROOT / 'examples')
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    # Remove only these runner-owned outputs so a failed sample cannot pass using
    # a previous invocation's image or computed storage values.
    for name in NAMES:
        for suffix in ('.rgba', '.png'):
            (output / (name + suffix)).unlink(missing_ok=True)
    (output / 'compute.u32').unlink(missing_ok=True)
    subprocess.run([str(binary)], cwd=output, check=True, timeout=args.timeout)
    check_directory(output)
