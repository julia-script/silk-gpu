#!/usr/bin/env python3
"""Generate Silk and ABI metadata from pinned webgpu.yml's upstream JSON form.

Naming, enum numbering, array count expansion and defaults follow gen/gen.go and
cheader.tmpl at the revision in schema-lock.json. No upstream sources are vendored.
Run --check to compare generated bytes without rewriting tracked outputs.
"""
import argparse
import difflib
import json
from schema_source import ROOT, fetch_sources


def canonical_case(name, upper_first):
    # Upstream gen/utils.go consumes one separator and uppercases the next
    # character, even when that character is another underscore. Thus double
    # underscores retain the numeric separators in Unorm10_10_10_2.
    result = []
    uppercase = upper_first
    for character in name:
        if uppercase:
            result.append(character.upper())
            uppercase = False
        elif character == "_":
            uppercase = True
        else:
            result.append(character)
    return "".join(result)


def pascal(name):
    return canonical_case(name, True)


def camel(name):
    return canonical_case(name, False)


def singular(name):
    return "entry" if name == "entries" else name.removesuffix("s")


def typename(name):
    return "WGPU" + pascal(name)


def identifier(name):
    # Silk reserves `type`; C member spelling remains unchanged in ABI metadata.
    return name + "_" if name == "type" else name


def null_pointer(typ):
    if not typ.startswith("?"):
        return "Pointer.null<u8>()"
    pointee = typ.split(" ", 1)[1]
    value = f"Pointer.null<{pointee}>()"
    source = f"?*mut {pointee}"
    if typ == source:
        return value
    return f"unsafe Intrinsic.pointerRequalify<{source}, {typ}>({value})"


PRIMITIVES = {
    "bool": "WGPUBool", "uint16": "u16", "uint32": "u32", "uint64": "u64",
    "int16": "i16", "int32": "i32", "usize": "usize", "float32": "f32",
    "nullable_float32": "f32", "float64": "f64", "float64_supertype": "f64",
    "nullable_string": "WGPUStringView", "string_with_default_empty": "WGPUStringView",
    "out_string": "WGPUStringView",
}


def silk_type(member):
    kind = member["type"]
    array = kind.startswith("array<")
    if array:
        kind = kind[6:-1]
    if kind.startswith("c_void"):
        result = "u8"
    elif kind in PRIMITIVES:
        result = PRIMITIVES[kind]
    elif "." in kind:
        category, name = kind.split(".", 1)
        result = typename(name) + ("CallbackInfo" if category == "callback" else "")
    else:
        raise ValueError(f"Unrecognized schema type: {kind}")
    pointer = member.get("pointer")
    if array and not pointer:
        raise ValueError(f"Array without pointer qualification: {member}")
    if pointer:
        result = ("?[*]" if array or kind == "c_void_data_ptr" or kind == "c_void_mapped_range_ptr" else "?*") + ("const " if pointer == "immutable" else "mut ") + result
    return result


def expand(members):
    fields = []
    for member in members:
        if member["type"].startswith("array<"):
            fields.append((camel(singular(member["name"])) + "Count", "usize", {"type": "usize"}))
        fields.append((camel(member["name"]), silk_type(member), member))
    return fields


def generate(schema, lock, policy):
    enums = {e["name"]: e for e in schema["enums"]}
    structs = {s["name"]: s for s in schema["structs"]}
    records = {}
    functions = []
    constants = {}
    lines = ["// Generated by scripts/generate. DO NOT EDIT.",
             "// Copyright 2019-2023 WebGPU-Native developers; SPDX-License-Identifier: BSD-3-Clause",
             f'// Source: webgpu-native/webgpu-headers@{lock["revision"]}/webgpu.yml',
             "// All pointer validity, ownership, callback mode and lifetime requirements are caller obligations.",
             "import silk.num.f32", "import silk.num.u32", "import silk.num.u64", "import silk.num.usize",
             "import silk.core.ownership { Copy }", "import silk.mem.pointer { Pointer }",
             "", "pub type WGPUBool = u32", "pub type WGPUFlags = u64",
             "pub const WGPU_TRUE: WGPUBool = 1", "pub const WGPU_FALSE: WGPUBool = 0", ""]
    for constant in schema["constants"]:
        kind = constant["value"]
        typ, value = {"uint32_max": ("u32", "u32.MAX"), "uint64_max": ("u64", "u64.MAX"),
                      "usize_max": ("usize", "usize.MAX"), "nan": ("f32", "f32.INFINITY - f32.INFINITY")}[kind]
        lines.append(f'pub const WGPU_{constant["name"].upper()}: {typ} = {value}')
    for obj in schema["objects"]:
        lines += ["", f'pub type {typename(obj["name"])} = ?*mut u8']
    for category in ("enums", "bitflags"):
        for enum in schema[category]:
            name = typename(enum["name"])
            lines += ["", f'pub type {name} = {"u32" if category == "enums" else "u64"}']
            values = {}
            for index, entry in enumerate(enum["entries"]):
                if entry is None:
                    continue
                if category == "enums":
                    prefix = 0x2000 if entry.get("namespace") == "compatibility_mode" else schema["enum_prefix"]
                    value = (prefix << 16) | entry.get("value", index)
                elif "value_combination" in entry:
                    value = 0
                    for part in entry["value_combination"]:
                        value |= values[part]
                else:
                    value = int(str(entry["value"]), 0) if "value" in entry else (1 << (index - 1) if index else 0)
                values[entry["name"]] = value
                cname = name + "_" + pascal(entry["name"])
                constants[cname] = value
                lines.append(f"pub const {cname}: {name} = {value}")
            if category == "enums":
                lines.append(f"pub const {name}_Force32: {name} = 2147483647")
    for typedef in schema["typedefs"]:
        lines.append(f'pub type {typename(typedef["name"])} = {silk_type(typedef)}')

    def record(name, fields, defaults, required=()):
        records[name] = [{"name": n, "type": t} for n, t in fields]
        lines.extend(["", f'pub extern "C" struct {name} {{'])
        lines.extend(f"  pub {identifier(n)}: {t}," for n, t in fields)
        lines.extend(["}", f"impl Copy for {name} {{}}", "", f"impl {name} {{"])
        arguments = ", ".join(f"{n}: {t}" for n, t in required)
        lines.extend([f"  pub fn default({arguments}) -> Self {{", "    return Self {"])
        lines.extend(f"      {identifier(n)}: {null_pointer(t) if defaults[n] == 'null' else defaults[n]}," for n, t in fields)
        lines.extend(["    }", "  }", "}"])

    record("WGPUStringView", [("data", "?[*]const u8"), ("length", "usize")], {"data": "null", "length": "WGPU_STRLEN"})
    record("WGPUChainedStruct", [("next", "?*mut WGPUChainedStruct"), ("sType", "WGPUSType")], {"next": "null", "sType": "0"})
    # LIMITATION-1: Silk native function values are nonnull. Require real callback
    # addresses rather than pretending NULL is a valid function value. No no-op
    # callbacks: result-handle ownership must never be discarded accidentally.
    for callback in schema["callbacks"]:
        name = typename(callback["name"])
        args = expand(callback.get("args", [])) + [("userdata1", "?*mut u8", {}), ("userdata2", "?*mut u8", {})]
        lines += ["", "// Wasm callbacks are host-registered tokens, independent of native function addresses.",
                  'static if Intrinsic.targetArchitecture() == "wasm32" {',
                  f"  pub type {name}Callback = u32",
                  "} else {",
                  f'  pub type {name}Callback = extern "C" fn({", ".join(t for _, t, _ in args)}) -> ()',
                  "}"]
        fields = [("nextInChain", "?*mut WGPUChainedStruct")]
        defaults = {"nextInChain": "null", "callback": "callback", "userdata1": "null", "userdata2": "null"}
        if callback["style"] == "callback_mode":
            fields.append(("mode", "WGPUCallbackMode"))
            defaults["mode"] = "WGPUCallbackMode_WaitAnyOnly"
        fields += [("callback", name + "Callback"), ("userdata1", "?*mut u8"), ("userdata2", "?*mut u8")]
        record(name + "CallbackInfo", fields, defaults, [("callback", name + "Callback")])

    def default(member, zero=False):
        kind = member["type"]
        value = member.get("default")
        typ = silk_type(member)
        if member.get("pointer") or kind.startswith("object.") or kind.startswith("array<"):
            return null_pointer(typ)
        if kind.startswith("callback."):
            return camel(member["name"])
        if kind.startswith("struct."):
            if value == "zero" or zero:
                nested = structs[kind.split(".")[1]]
                parts = []
                if nested["type"].startswith("extensible"):
                    parts.append("nextInChain: Pointer.null<WGPUChainedStruct>()")
                for n, _, m in expand(nested.get("members", [])):
                    parts.append(identifier(n) + ": " + default(m, True))
                return typ + " { " + ", ".join(parts) + " }"
            return typ + ".default()"
        if kind.endswith("string") or kind == "string_with_default_empty":
            return "WGPUStringView.default()"
        if zero:
            return "0.0" if typ in ("f32", "f64") else "0"
        if kind.startswith("enum."):
            enum = enums[kind.split(".")[1]]
            if value is None:
                value = "undefined" if any(e and e["name"] == "undefined" for e in enum["entries"]) else None
            return typ + "_" + pascal(value) if value else "0"
        if kind.startswith("bitflag."):
            return typ + "_" + pascal(value or "none")
        if isinstance(value, str) and value.startswith("constant."):
            return "WGPU_" + value.split(".")[1].upper()
        if kind == "bool":
            return "1" if value else "0"
        if value is None:
            return "0.0" if typ in ("f32", "f64") else "0"
        return str(float(value)) if typ in ("f32", "f64") else str(value)

    for struct in schema["structs"]:
        name = typename(struct["name"])
        expanded = expand(struct.get("members", []))
        fields = [(n, t) for n, t, _ in expanded]
        defaults = {n: default(m) for n, _, m in expanded}
        required = [(n, t) for n, t, m in expanded if m["type"].startswith("callback.")]
        if struct["type"].startswith("extensible"):
            fields.insert(0, ("nextInChain", "?*mut WGPUChainedStruct"))
            defaults["nextInChain"] = "null"
        elif struct["type"] == "extension":
            fields.insert(0, ("chain", "WGPUChainedStruct"))
            defaults["chain"] = f'WGPUChainedStruct {{ next: Pointer.null<WGPUChainedStruct>(), sType: WGPUSType_{pascal(struct["name"])} }}'
        record(name, fields, defaults, required)

    def function(fn, owner=None):
        name = "wgpu" + (pascal(owner) if owner else "") + pascal(fn["name"])
        args = [(camel(owner), typename(owner))] if owner else []
        args += [(n, t) for n, t, _ in expand(fn.get("args", []))]
        result = silk_type(fn["returns"]) if fn.get("returns") else "()"
        callback = fn.get("callback")
        if callback:
            args.append(("callbackInfo", typename(callback.split(".")[1]) + "CallbackInfo"))
            result = "WGPUFuture"
        functions.append({"name": name, "args": [{"name": n, "type": t} for n, t in args], "result": result, "callback": bool(callback)})

    for fn in schema["functions"]:
        function(fn)
    for obj in schema["objects"]:
        for fn in obj.get("methods", []):
            function(fn, obj["name"])
        for method in ("add_ref", "release"):
            function({"name": method}, obj["name"])
    for struct in schema["structs"]:
        if struct.get("free_members"):
            function({"name": struct["name"] + "_free_members", "args": [{"name": struct["name"], "type": "struct." + struct["name"]}]})
    # LIMITATION-1: GetProcAddress may return NULL; preserve pointer ABI without
    # constructing an invalid nonnull callable. No callable conversion is exposed.
    lines += ["", "pub type WGPUProc = ?*mut u8"]
    functions.append({"name": "wgpuGetProcAddress", "args": [{"name": "procName", "type": "WGPUStringView"}], "result": "WGPUProc", "callback": False})
    function_names = {f["name"] for f in functions}
    unknown = set(policy["pumps"]) - function_names
    if unknown:
        raise ValueError(f"Callback policy names absent from schema: {unknown}")
    lines += ["", '// Nonspontaneous registrations require same-thread pumping and stable raw userdata.',
              '// Pointer-reachable device callbacks are documented in scripts/callback-contracts.json.',
              'static if Intrinsic.targetArchitecture() == "wasm32" {']
    for wasm in (True, False):
        if not wasm:
            lines.append("} else {")
        for fn in functions:
            name = fn["name"]
            clauses = []
            if wasm:
                clauses += ['module: "webgpu"', f'name: "{name}"']
            if fn["callback"] and not wasm:
                clauses.append('deferredCallbacks: ("callbackInfo.callback",)')
            if name in policy["pumps"]:
                entry = policy["pumps"][name]
                lines += ["  // " + entry["reason"], "  // " + entry["source"]]
                if not wasm:
                    clauses.append("invokesDeferredCallbacks: true")
            args = ", ".join(f'{a["name"]}: {a["type"]}' for a in fn["args"])
            declaration = f'  pub unsafe extern "C" fn {name}({args}) -> {fn["result"]}'
            if wasm:
                declaration += f' as "{name}"'
            if clauses:
                declaration += " with Intrinsic.foreign(" + ", ".join(clauses) + ")"
            lines.append(declaration)
        lines.append("")
    lines.append("}")

    abi = ["/* Generated by scripts/generate. DO NOT EDIT. */", "#include <stddef.h>", "#include <stdio.h>", "#include <webgpu.h>",
           "static WGPUProc volatile generated_symbols[] = {"]
    abi += [f'  (WGPUProc)&{fn["name"]},' for fn in functions]
    abi += [
        "};",
        "typedef struct { const char *name; size_t bytes; size_t alignment; } SilkGpuAbiLayout;",
        "static const SilkGpuAbiLayout generated_layouts[] = {",
    ]
    abi += [f'  {{"{name}", sizeof({name}), _Alignof({name})}},' for name in records]
    abi += [
        "};",
        "int32_t silk_gpu_abi_check(size_t index, size_t bytes, size_t alignment) {",
        "  if (index >= sizeof(generated_layouts) / sizeof(generated_layouts[0])) return 1;",
        "  const SilkGpuAbiLayout *expected = &generated_layouts[index];",
        "  if (bytes == expected->bytes && alignment == expected->alignment) return 0;",
        '  fprintf(stderr, "%s ABI mismatch: Silk size=%zu align=%zu; C size=%zu align=%zu\\n",',
        "          expected->name, bytes, alignment, expected->bytes, expected->alignment);",
        "  return 1;",
        "}",
        "int32_t silk_gpu_abi_finish(size_t checked) {",
        "  size_t records = sizeof(generated_layouts) / sizeof(generated_layouts[0]);",
        "  if (checked != records) return 1;",
        "  size_t symbols = sizeof(generated_symbols) / sizeof(generated_symbols[0]);",
        "  for (size_t i = 0; i < symbols; ++i)",
        "    if (generated_symbols[i] == NULL) return 1;",
        '  printf("WebGPU ABI: %zu C/Silk record sizes and alignments match; %zu native symbols linked\\n", records, symbols);',
        "  return 0;",
        "}",
        "#ifndef SILK_GPU_ABI_LIBRARY",
        "int main(void) {",
    ]
    for name, fields in records.items():
        abi.append(f'  printf("{name} sizeof %zu alignof %zu\\n", sizeof({name}), _Alignof({name}));')
        for field in fields:
            n = field["name"]
            abi.append(f'  printf("{name}.{n} %zu\\n", offsetof({name}, {n}));')
    for name, value in constants.items():
        abi.append(f'  _Static_assert({name} == {value}ULL, "{name}");')
    # Volatile addresses keep every symbol live, including functions unused by samples.
    abi += ["  for (size_t i = 0; i < sizeof(generated_symbols) / sizeof(generated_symbols[0]); ++i)",
            "    if (generated_symbols[i] == NULL) return 1;"]
    abi += ["  return 0;", "}", "#endif"]
    silk_abi = [
        "// Generated by scripts/generate. DO NOT EDIT.",
        "// Compare actual compiled Silk layouts against actual implementation C-header layouts.",
        "import silk.mem.layout { Layout }",
        "import webgpu_sys.generated_webgpu { " + ", ".join(records) + " }",
        'unsafe extern "C" fn silk_gpu_abi_check(index: usize, bytes: usize, alignment: usize) -> i32',
        'unsafe extern "C" fn silk_gpu_abi_finish(checked: usize) -> i32',
        "",
        "pub fn main() -> i32 {",
    ]
    for index, name in enumerate(records):
        silk_abi += [
            f"  let layout{index} = Layout.of<{name}>()",
            f"  if unsafe silk_gpu_abi_check({index}, layout{index}.bytes, layout{index}.alignment) != 0 {{ return 1 }}",
        ]
    silk_abi += [f"  return unsafe silk_gpu_abi_finish({len(records)})", "}"]
    metadata = {"schema_revision": lock["revision"], "records": records, "functions": functions, "constants": constants,
                "wasm_abi": "Silk dev27 wasm32 lowers single-scalar aggregate results recursively to their scalar: WGPUFuture returns i64 (JavaScript bigint), not an sret pointer. Multiscalar by-value aggregates are passed indirectly. Callback fields are u32 host-registered tokens; native function addresses are never reinterpreted.",
                "nullable_callbacks": "Native fn fields are nonnull. Callback-info constructors require a callback; raw C NULL callback defaults are intentionally not fabricated."}
    metadata["callbacks"] = [
        {
            "kind": index,
            "name": typename(callback["name"]) + "Callback",
            "args": [{"name": n, "type": t} for n, t, _ in
                     expand(callback.get("args", [])) +
                     [("userdata1", "?*mut u8", {}), ("userdata2", "?*mut u8", {})]],
        }
        for index, callback in enumerate(schema["callbacks"])
    ]
    return {
        "webgpu_sys/src/generated_webgpu.silk": "\n".join(lines) + "\n",
        "webgpu_sys/abi/generated_layout.c": "\n".join(abi) + "\n",
        "webgpu_sys/abi/generated_main.silk": "\n".join(silk_abi) + "\n",
        "webgpu_sys/abi/generated_schema.json": json.dumps(metadata, indent=2) + "\n",
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Compare generated outputs without rewriting them")
    args = parser.parse_args()
    lock, paths = fetch_sources()
    schema = json.loads(paths["webgpu.json"].read_text())
    policy = json.loads((ROOT / "scripts/callback-contracts.json").read_text())
    outputs = generate(schema, lock, policy)
    stale = False
    for name, content in outputs.items():
        path = ROOT / name
        if args.check:
            old = path.read_text() if path.exists() else ""
            if old != content:
                stale = True
                print("".join(difflib.unified_diff(old.splitlines(True), content.splitlines(True), fromfile=name, tofile=name + " (generated)")), end="")
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content)
    if stale:
        raise SystemExit("Generated outputs are stale. Run scripts/generate.")


if __name__ == "__main__":
    main()
