#!/usr/bin/env python3
"""Verify pinned toolchain binaries and fetch checksum-verified schema inputs."""
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
for installer in ("install-silk", "install-llvm", "install-webgpu"):
    subprocess.run([sys.executable, ROOT / "scripts" / installer], cwd=ROOT, check=True)
subprocess.run([sys.executable, ROOT / "scripts/schema_source.py"], cwd=ROOT, check=True)
