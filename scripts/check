#!/usr/bin/env python3
"""Run the PR gate; --skip-native omits GPU execution, --browser adds browser tests."""
import argparse
import os
import shlex
import subprocess
import sys
from _build import ROOT, command_path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--skip-native", action="store_true", help="run freshness and workspace checks only")
parser.add_argument("--browser", action="store_true", help="also execute compiled wasm samples in existing Chromium")
args = parser.parse_args()


def run(command):
    print("+ " + shlex.join(map(str, command)), flush=True)
    subprocess.run(list(map(str, command)), cwd=ROOT, check=True)


for generator in ("generate", "generate-browser", "embed-shaders"):
    run([sys.executable, ROOT / "scripts" / generator, "--check"])
run([sys.executable, "-m", "unittest", "discover", "-s", "tests/pixels", "-p", "test_*.py"])
compiler_bin = command_path("install-silk")
os.environ["SILK_CLANG"] = str(command_path("install-llvm"))
run([compiler_bin / "silkc", "check", "--workspace", "--stdlib", compiler_bin.parent / "lib/silk/stdlib"])
if not args.skip_native:
    run([sys.executable, ROOT / "scripts/test-abi"])
    run([sys.executable, ROOT / "scripts/test-native"])
    run([sys.executable, ROOT / "scripts/test-pixels"])
if args.browser:
    run([sys.executable, ROOT / "scripts/test-browser"])
