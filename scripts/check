#!/usr/bin/env python3
"""Check generated raw bindings, the workspace, and a native instance smoke test."""
import os
import subprocess
import sys
from _build import ROOT, command_path

subprocess.run([sys.executable, ROOT / "scripts/generate", "--check"], cwd=ROOT, check=True)
compiler_bin = command_path("install-silk")
os.environ["SILK_CLANG"] = str(command_path("install-llvm"))
subprocess.run([compiler_bin / "silkc", "check", "--workspace", "--stdlib", compiler_bin.parent / "lib/silk/stdlib"], cwd=ROOT, check=True)
subprocess.run([sys.executable, ROOT / "scripts/test-native"], cwd=ROOT, check=True)
