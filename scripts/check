#!/usr/bin/env python3
"""Check raw bindings, shaders, workspace, native scenarios and all six pixel samples."""
import argparse
import os
import subprocess
import sys
from _build import ROOT, command_path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--skip-native", action="store_true", help="run freshness and workspace checks only")
args = parser.parse_args()
for generator in ("generate", "embed-shaders"):
    subprocess.run([sys.executable, ROOT / "scripts" / generator, "--check"], cwd=ROOT, check=True)
compiler_bin = command_path("install-silk")
os.environ["SILK_CLANG"] = str(command_path("install-llvm"))
subprocess.run([compiler_bin / "silkc", "check", "--workspace", "--stdlib", compiler_bin.parent / "lib/silk/stdlib"], cwd=ROOT, check=True)
if not args.skip_native:
    for script in ("test-abi", "test-native", "test-pixels"):
        subprocess.run([sys.executable, ROOT / "scripts" / script], cwd=ROOT, check=True)
