#!/usr/bin/env python3
"""Embed canonical WGSL in Silk byte literals; --check detects stale embedding."""
import argparse
import json
from pathlib import Path

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
# (shader directory, Silk module, shader names)
sets = (
    ('examples/shaders', 'examples/src/generated_shaders.silk', ('clear', 'triangle', 'textured-quad', 'instanced-rects', 'compute', 'msaa')),
    ('gpu_scene/shaders', 'gpu_scene/src/generated_shaders.silk', ('scene',)),
)
stale = []
for directory, module, names in sets:
    text = f'// Generated by scripts/embed-shaders from {directory}; do not edit.\n'
    for name in names:
        source = (root / directory / (name + '.wgsl')).read_text()
        text += f"pub fn {name.replace('-', '_')}() -> &'static [u8] {{ return b{json.dumps(source)} }}\n"
    path = root / module
    if args.check:
        if not path.exists() or path.read_text() != text:
            stale.append(module)
    else:
        path.write_text(text)
if stale:
    raise SystemExit('stale embedded WGSL in ' + ', '.join(stale) + ': run scripts/embed-shaders')
