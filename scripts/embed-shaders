#!/usr/bin/env python3
"""Embed canonical WGSL in Silk byte literals; --check detects stale embedding."""
import argparse
import json
from pathlib import Path

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--check', action='store_true')
args = parser.parse_args()
names = ('clear', 'triangle', 'textured-quad', 'instanced-rects', 'compute', 'msaa')
text = '// Generated by scripts/embed-shaders from examples/shaders; do not edit.\n'
for name in names:
    source = (root / 'examples/shaders' / (name + '.wgsl')).read_text()
    text += f"pub fn {name.replace('-', '_')}() -> &'static [u8] {{ return b{json.dumps(source)} }}\n"
path = root / 'examples/src/generated_shaders.silk'
if args.check:
    if not path.exists() or path.read_text() != text:
        raise SystemExit('stale embedded WGSL: run scripts/embed-shaders')
else:
    path.write_text(text)
