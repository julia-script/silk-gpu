pub fn clear() -> &'static [u8] { return b"// The clear sample uses a render-pass load operation, not a shader.\n" }
pub fn triangle() -> &'static [u8] { return b"@vertex fn vs(@location(0) position: vec2f) -> @builtin(position) vec4f { return vec4f(position,0,1); }\n@fragment fn fs() -> @location(0) vec4f { return vec4f(0.25,0.75,0.5,1); }\n" }
pub fn textured_quad() -> &'static [u8] { return b"@group(0) @binding(0) var image: texture_2d<f32>;\n@group(0) @binding(1) var nearest: sampler;\nstruct Vertex { @builtin(position) position: vec4f, @location(0) uv: vec2f }\n@vertex fn vs(@builtin(vertex_index) vertex: u32) -> Vertex {\n  let uv = array<vec2f,6>(vec2f(0,0),vec2f(1,0),vec2f(0,1),vec2f(0,1),vec2f(1,0),vec2f(1,1))[vertex];\n  return Vertex(vec4f(uv.x*2.0-1.0,1.0-uv.y*2.0,0,1),uv);\n}\n@fragment fn fs(v: Vertex) -> @location(0) vec4f { return textureSample(image,nearest,v.uv); }\n" }
pub fn instanced_rects() -> &'static [u8] { return b"struct Rect { bounds: vec4f, color: vec4f, rounding: vec4f }\n@group(0) @binding(0) var<storage, read> rects: array<Rect>;\nstruct Vertex { @builtin(position) position: vec4f, @location(0) local: vec2f, @location(1) @interpolate(flat) index: u32 }\n@vertex fn vs(@builtin(vertex_index) vertex: u32, @builtin(instance_index) instance: u32) -> Vertex {\n  let corners = array<vec2f, 6>(vec2f(0,0),vec2f(1,0),vec2f(0,1),vec2f(0,1),vec2f(1,0),vec2f(1,1));\n  let r = rects[instance];\n  let local = corners[vertex] * r.bounds.zw;\n  let pixel = r.bounds.xy + local;\n  return Vertex(vec4f(pixel.x / 32.0 - 1.0, 1.0 - pixel.y / 32.0, 0, 1), local, instance);\n}\n@fragment fn fs(v: Vertex) -> @location(0) vec4f {\n  let r = rects[v.index];\n  let q = abs(v.local - r.bounds.zw * 0.5) - (r.bounds.zw * 0.5 - vec2f(r.rounding.x));\n  let distance = length(max(q,vec2f(0))) + min(max(q.x,q.y),0.0) - r.rounding.x;\n  if distance > 0.0 { discard; }\n  return r.color;\n}\n" }
pub fn compute() -> &'static [u8] { return b"@group(0) @binding(0) var<storage, read_write> values: array<u32>;\n@compute @workgroup_size(64) fn compute(@builtin(global_invocation_id) id: vec3u) {\n  if id.x < 4096u { values[id.x] = id.x * 3u + 7u; }\n}\n@group(0) @binding(1) var<storage, read> pixels: array<u32>;\n@vertex fn vs(@builtin(vertex_index) vertex: u32) -> @builtin(position) vec4f {\n  let p = array<vec2f,3>(vec2f(-1,-1),vec2f(3,-1),vec2f(-1,3));\n  return vec4f(p[vertex],0,1);\n}\n@fragment fn fs(@builtin(position) position: vec4f) -> @location(0) vec4f {\n  let value = pixels[u32(position.y)*64u+u32(position.x)];\n  return vec4f(f32(value & 255u),f32((value >> 8u) & 255u),0,255)/255.0;\n}\n" }
pub fn msaa() -> &'static [u8] { return b"@vertex fn vs(@location(0) position: vec2f) -> @builtin(position) vec4f { return vec4f(position,0,1); }\n@fragment fn fs() -> @location(0) vec4f { return vec4f(0.25,0.75,0.5,1); }\n" }
