//! Renders the same scenes with vector's CPU pixmap and with gpu_scene, then compares bytes.
//! Solid paints must match exactly. Gradients evaluate their parameter in f32 on the GPU and
//! f64 on the CPU, so a pixel may land one ramp entry apart; adjacent entries differ by at most a
//! few levels, which the gradient tolerance allows (lavapipe currently matches exactly).
import webgpu.runtime { Instance, RequestAdapterOptions, Device, GpuError }
import webgpu.runtime as runtime
import webgpu.resources as gpu
import webgpu.resources { Queue, CommandEncoder }
import webgpu.descriptors {
  DeviceDescriptor,
  BufferDescriptor,
  TextureDescriptor,
  TextureViewDescriptor,
  Extent3D,
  TexelCopyTextureInfo,
  TexelCopyBufferInfo,
  TexelCopyBufferLayout,
}
import webgpu_sys.generated_webgpu as flags
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.num.i32
import silk.num.f64
import vector.geometry { Affine, Rect }
import vector.projective { Homography }
import vector.path { Path }
import vector.strips { Rasterizer, Coverage, NONZERO, EVENODD }
import vector.stroke { Stroke, Stroker, JOIN_ROUND, JOIN_MITER_CLIP, CAP_ROUND, CAP_SQUARE }
import vector.geometry_error { GeometryError }
import vector.flatten { TOLERANCE }
import vector.pixmap { Pixmap, Rgba8 }
import vector.paint {
  Gradient,
  Stop,
  Solid,
  ImagePattern,
  SPREAD_PAD,
  SPREAD_REFLECT,
  SPREAD_REPEAT,
  SAMPLE_NEAREST,
  SAMPLE_BILINEAR,
  EXTEND_CLAMP,
  EXTEND_REPEAT
}
import vector.paint as painting
import vector.layer { Mask, BLEND_NORMAL }
import vector.layer as layering
import gpu_scene.scene { Scene, NO_MASK, MASK_ALPHA, MASK_LUMINANCE }
import gpu_scene.renderer { SceneRenderer, FORMAT }
import gpu_scene.filter { FilterRenderer, FilterImage }
import vector.filter as filtering
import vector.filter {
  Region,
  BlurPlan,
  colorMatrixOf,
  MATRIX,
  SATURATE,
  HUE_ROTATE,
  LUMINANCE_TO_ALPHA,
  ComponentTransfer,
  Convolution,
  transferTable,
  transferDiscrete,
  transferLinear,
  transferGamma,
  displacementTable,
  MORPHOLOGY_ERODE,
  MORPHOLOGY_DILATE,
  EDGE_DUPLICATE,
  EDGE_WRAP,
  EDGE_NONE,
  CHANNEL_R,
  CHANNEL_G,
  CHANNEL_A,
  Turbulence,
  TurbulenceSettings,
  Light,
  Lighting,
  LIGHT_DISTANT,
  LIGHT_POINT,
  LIGHT_SPOT,
}

const WIDTH: u32 = 128

const HEIGHT: u32 = 96

struct Canvas {
  cpu: Pixmap,
  scene: Scene,
  raster: Rasterizer,
  stroker: Stroker,
  coverage: Coverage,
}

impl Canvas {
  effect fn make() -> Canvas
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut cpu = run Pixmap.make(WIDTH, HEIGHT)
    cpu.clear(background())
    return Canvas {
      cpu: move cpu,
      scene: Scene.make(WIDTH, HEIGHT),
      raster: Rasterizer.make(),
      stroker: Stroker.make(),
      coverage: Coverage.make(WIDTH, HEIGHT),
    }
  }

  effect fn fill(
    self: &mut Self,
    path: &Path,
    transform: &Affine,
    rule: u8,
    color: Rgba8,
    opacity: u8,
  ) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    run self.raster.fill(path, transform, rule, &mut self.coverage)
    painting.fill(&mut self.cpu, &self.coverage, &Solid.make(color), opacity)
    run self.scene.fill(&self.coverage, color, opacity)
  }

  effect fn stroke(
    self: &mut Self,
    path: &Path,
    style: &Stroke,
    transform: &Affine,
    color: Rgba8,
    opacity: u8,
  ) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    let mut outline = Path.make()
    run self.stroker.stroke(path, style, transform, TOLERANCE, &mut outline)
    run self.fill(&outline, transform, NONZERO, color, opacity)
  }

  effect fn fillGradient(
    self: &mut Self,
    path: &Path,
    transform: &Affine,
    gradient: &Gradient,
    opacity: u8,
  ) -> ()
    ! OutOfMemoryError | GeometryError
    ? &mut Allocator {
    run self.raster.fill(path, transform, NONZERO, &mut self.coverage)
    painting.fill(&mut self.cpu, &self.coverage, gradient, opacity)
    run self.scene.fillGradient(&self.coverage, gradient, opacity)
  }
}

fn background() -> Rgba8 {
  return Rgba8.make(250, 248, 240, 255)
}

effect fn star(cx: f64, cy: f64, outer: f64, inner: f64) -> Path
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut p = Path.make()
  let mut i: u32 = 0
  while i < 10 {
    let angle = u32.toF64(i) * 3.141592653589793 / 5.0 - 1.5707963267948966
    let r = if i % 2 == 0 {
      outer
    } else {
      inner
    }
    let x = cx + r * f64.cos(angle)
    let y = cy + r * f64.sin(angle)
    if i == 0 {
      run p.moveTo(x, y)
    } else {
      run p.lineTo(x, y)
    }
    i = i + 1
  }
  run p.close()
  return move p
}

effect fn solids() -> Canvas
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let mut c = run Canvas.make()
  let id = Affine.identity()
  let mut rect = Path.make()
  run rect.rect(Rect.make(6.25, 5.5, 50.0, 30.75))
  run c.fill(&rect, &id, NONZERO, Rgba8.make(220, 40, 30, 255), 255)
  let mut circle = Path.make()
  run circle.circle(48.0, 40.0, 26.3)
  run c.fill(&circle, &id, NONZERO, Rgba8.make(20, 90, 230, 160), 255)
  let s = run star(96.0, 46.0, 34.0, 14.0)
  run c.fill(&s, &id, EVENODD, Rgba8.make(30, 160, 80, 255), 200)
  let mut style = Stroke.make(3.5)
  style.join = JOIN_ROUND
  style.cap = CAP_ROUND
  run c.stroke(&s, &style, &id, Rgba8.make(10, 10, 10, 255), 255)
  let mut wave = Path.make()
  run wave.moveTo(4.0, 80.0)
  run wave.cubicTo(30.0, 50.0, 50.0, 110.0, 80.0, 74.0)
  run wave.quadTo(100.0, 50.0, 124.0, 86.0)
  let mut dashed = Stroke.make(5.0)
  dashed.cap = CAP_SQUARE
  dashed.join = JOIN_MITER_CLIP
  run dashed.setDashes(&[9.0, 4.0, 2.0])
  dashed.dashOffset = 3.0
  run c.stroke(&wave, &dashed, &id, Rgba8.make(200, 120, 0, 230), 255)

  // A rotated, skewed square exercises transformed coverage.
  let mut small = Path.make()
  run small.rect(Rect.make(-8.0, -8.0, 16.0, 16.0))
  let m = Affine.translate(20.0, 60.0).then(&Affine.rotate(0.6)).then(&Affine.scale(1.0, 0.6))
  run c.fill(&small, &m, NONZERO, Rgba8.make(120, 0, 160, 255), 128)
  return move c
}

effect fn gradients() -> Canvas
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let mut c = run Canvas.make()
  let id = Affine.identity()
  let stops = [
    Stop { offset: 0.0, color: Rgba8.make(255, 60, 0, 255) },
    Stop { offset: 0.45, color: Rgba8.make(255, 220, 0, 200) },
    Stop { offset: 0.45, color: Rgba8.make(0, 140, 255, 255) },
    Stop { offset: 1.0, color: Rgba8.make(40, 0, 120, 255) },
  ]
  let mut whole = Path.make()
  run whole.rect(Rect.make(0.0, 0.0, 128.0, 48.0))
  let mut linear = Gradient.linear(10.0, 0.0, 70.0, 20.0, SPREAD_REFLECT, &id)
  run linear.setStops(&stops)
  run c.fillGradient(&whole, &id, &linear, 255)
  let mut disk = Path.make()
  run disk.circle(40.0, 70.0, 24.0)
  let mut radial = Gradient.radial(40.0, 70.0, 24.0, 32.0, 62.0, 2.0, SPREAD_PAD, &id)
  run radial.setStops(&stops)
  run c.fillGradient(&disk, &id, &radial, 255)
  let mut box = Path.make()
  run box.rect(Rect.make(72.0, 50.0, 52.0, 42.0))
  let skew = Affine.translate(98.0, 71.0).then(&Affine.rotate(0.4))
  let mut repeat = Gradient.radial(0.0, 0.0, 9.0, 0.0, 0.0, 0.0, SPREAD_REPEAT, &skew)
  run repeat.setStops(&stops)
  run c.fillGradient(&box, &id, &repeat, 220)
  return move c
}

// Exact shared radial edge contract; literal expectations live in paint_tests
// and the assertions below, not merely a CPU/GPU differential oracle.
effect fn radialLimits() -> Canvas
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let mut c = run Canvas.make()
  let stops = [
    Stop { offset: 0.0, color: Rgba8.make(255, 0, 0, 255) },
    Stop { offset: 0.25, color: Rgba8.make(255, 0, 0, 255) },
    Stop { offset: 0.25, color: Rgba8.make(0, 0, 255, 255) },
    Stop { offset: 1.0, color: Rgba8.make(0, 0, 255, 255) },
  ]
  let modes = [SPREAD_PAD, SPREAD_REPEAT, SPREAD_REFLECT]
  let mut panel: usize = 0
  while panel < 3 {
    let x = usize.toF64(panel) * 42.0
    let map = Affine.translate(x, 0.0)
    let mut g = Gradient.radial(16.0, 24.0, 16.0, 32.0, 24.0, 0.0, modes[panel], &map)
    if panel == 1 {
      run g.setProjective(&Homography.fromAffine(&map))
    }
    run g.setStops(&stops)
    let mut box = Path.make()
    run box.rect(Rect.make(x + 32.0, 0.0, 10.0, 48.0))
    run c.fillGradient(&box, &Affine.identity(), &g, 255)
    panel = panel + 1
  }
  let mut box = Path.make()
  run box.rect(Rect.make(0.0, 48.0, 42.0, 48.0))
  let mut same = Gradient.radial(20.0, 72.0, 0.0, 20.0, 72.0, 0.0, SPREAD_PAD, &Affine.identity())
  run same.setStops(&stops)
  run c.fillGradient(&box, &Affine.identity(), &same, 255)
  let mut shrink = Gradient.radial(
    62.0,
    72.0,
    0.0,
    62.0,
    72.0,
    16.0,
    SPREAD_PAD,
    &Affine.identity(),
  )
  run shrink.setStops(&stops)
  let mut middle = Path.make()
  run middle.rect(Rect.make(42.0, 48.0, 42.0, 48.0))
  run c.fillGradient(&middle, &Affine.identity(), &shrink, 255)
  run same.setStops(&[Stop { offset: 0.0, color: Rgba8.make(0, 255, 0, 255) }])
  let mut last = Path.make()
  run last.rect(Rect.make(84.0, 48.0, 44.0, 48.0))
  run c.fillGradient(&last, &Affine.identity(), &same, 255)
  return move c
}

/// Fills `path` with `color` into the CPU `target` and records the same fill in the scene.
effect fn fillBoth(
  c: &mut Canvas,
  target: &mut Pixmap,
  path: &Path,
  color: Rgba8,
  opacity: u8,
) -> ()
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  run c.raster.fill(path, &Affine.identity(), NONZERO, &mut c.coverage)
  painting.fill(&mut target, &c.coverage, &Solid.make(color), opacity)
  run c.scene.fill(&c.coverage, color, opacity)
}

/// Groups in all 16 blend modes over a striped backdrop, then a group through a luminance mask
/// intersected with a clip path.
effect fn layers() -> Canvas
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let mut c = run Canvas.make()
  let id = Affine.identity()
  let mut base = run Pixmap.make(WIDTH, HEIGHT)
  base.clear(background())
  let mut stripe: u32 = 0
  while stripe < 8 {
    let mut bar = Path.make()
    run bar.rect(Rect.make(u32.toF64(stripe) * 16.0, 0.0, 16.0, 96.0))
    let color = Rgba8.make(
      u32.toU8(stripe * 30),
      u32.toU8(255 - stripe * 25),
      u32.toU8(60 + stripe * 20),
      u32.toU8(140 + stripe * 15),
    )
    run fillBoth(&mut c, &mut base, &bar, color, 255)
    stripe = stripe + 1
  }
  let mut mode: u32 = 0
  while mode < 16 {
    let cx = u32.toF64(mode % 4) * 32.0 + 16.0
    let cy = u32.toF64(mode / 4) * 18.0 + 10.0
    let mut group = run Pixmap.make(WIDTH, HEIGHT)
    run c.scene.pushLayer()
    let mut disk = Path.make()
    run disk.circle(cx, cy, 11.0)
    run fillBoth(
      &mut c,
      &mut group,
      &disk,
      Rgba8.make(u32.toU8(255 - mode * 9), u32.toU8(40 + mode * 12), 200, 210),
      255,
    )
    let mut square = Path.make()
    run square.rect(Rect.make(cx - 3.0, cy - 8.0, 13.0, 13.0))
    run fillBoth(&mut c, &mut group, &square, Rgba8.make(250, 230, 20, 255), 255)
    layering.composite(&mut base, &group, u32.toU8(mode), 200)
    run c.scene.popLayer(u32.toU8(mode), 200, NO_MASK)
    mode = mode + 1
  }

  // A clip path as an alpha mask, intersected with a luminance mask, on a normal group.
  let mut clipContent = run Pixmap.make(WIDTH, HEIGHT)
  run c.scene.pushLayer()
  let mut clipShape = Path.make()
  run clipShape.circle(64.0, 84.0, 30.0)
  run fillBoth(&mut c, &mut clipContent, &clipShape, Rgba8.make(255, 255, 255, 255), 255)
  let clip = run c.scene.popMask(MASK_ALPHA, NO_MASK)
  let mut lumContent = run Pixmap.make(WIDTH, HEIGHT)
  run c.scene.pushLayer()
  let mut lumBand = Path.make()
  run lumBand.rect(Rect.make(20.0, 66.0, 90.0, 30.0))
  let stops = [
    Stop { offset: 0.0, color: Rgba8.make(255, 255, 255, 255) },
    Stop { offset: 1.0, color: Rgba8.make(40, 0, 90, 120) },
  ]
  let mut fade = Gradient.linear(20.0, 0.0, 110.0, 0.0, SPREAD_PAD, &id)
  run fade.setStops(&stops)
  run c.raster.fill(&lumBand, &id, NONZERO, &mut c.coverage)
  painting.fill(&mut lumContent, &c.coverage, &fade, 255)
  run c.scene.fillGradient(&c.coverage, &fade, 255)
  let lum = run c.scene.popMask(MASK_LUMINANCE, clip)
  let mut group = run Pixmap.make(WIDTH, HEIGHT)
  run c.scene.pushLayer()
  let mut wide = Path.make()
  run wide.rect(Rect.make(0.0, 60.0, 128.0, 36.0))
  run fillBoth(&mut c, &mut group, &wide, Rgba8.make(200, 20, 60, 255), 255)
  let mut mask = run Mask.fromLuminance(&lumContent)
  mask.intersect(&run Mask.fromAlpha(&clipContent))
  layering.compositeMasked(&mut base, &group, BLEND_NORMAL, 230, &mask)
  run c.scene.popLayer(BLEND_NORMAL, 230, lum)
  c.cpu = move base
  return move c
}

/// A small premultiplied test image: a color ramp with a few translucent texels.
effect fn sampleImage() -> Pixmap
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut image = run Pixmap.make(7, 5)
  let d = image.dataMut()
  let mut i: u32 = 0
  while i < 35 {
    let x = i % 7
    let y = i / 7
    let color = Rgba8.make(
      u32.toU8(x * 36),
      u32.toU8(y * 60),
      u32.toU8(255 - x * 30),
      if (x + y) % 3 == 0 {
        120
      } else {
        255
      },
    ).premultiply()
    let at = u32.toUsize(i) * 4
    d[at] = color.r
    d[at + 1] = color.g
    d[at + 2] = color.b
    d[at + 3] = color.a
    i = i + 1
  }
  return move image
}

/// Image patterns: nearest and clamped, bilinear and repeated, under scale and rotation.
effect fn images() -> Canvas
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let mut c = run Canvas.make()
  let id = Affine.identity()
  let image = run sampleImage()
  let mut left = Path.make()
  run left.rect(Rect.make(4.0, 4.0, 58.0, 88.0))

  // Regression: at device x=21 the separately rounded f32 inverse maps to 1.99999988,
  // not 2. Relaxed Metal arithmetic selected texel 2 instead of texel 1 for this column.
  // Keep this fractional placement and the zero-tolerance image comparison below.
  let nearest = ImagePattern.make(
    &image,
    &Affine.translate(9.3, 11.7).then(&Affine.scale(6.1, 7.3)),
    SAMPLE_NEAREST,
    EXTEND_CLAMP,
  )
  run c.raster.fill(&left, &id, NONZERO, &mut c.coverage)
  painting.fill(&mut c.cpu, &c.coverage, &nearest, 255)
  run c.scene.fillImage(&c.coverage, &nearest, 255)
  let mut disk = Path.make()
  run disk.circle(96.0, 48.0, 30.0)
  let placed = Affine.translate(96.0, 48.0).then(&Affine.rotate(0.35)).then(&Affine.scale(5.3, 4.1))
  let bilinear = ImagePattern.make(&image, &placed, SAMPLE_BILINEAR, EXTEND_REPEAT)
  run c.raster.fill(&disk, &id, NONZERO, &mut c.coverage)
  painting.fill(&mut c.cpu, &c.coverage, &bilinear, 230)
  run c.scene.fillImage(&c.coverage, &bilinear, 230)
  return move c
}

/// Every panel has a different inverse w across both axes. All four image
/// sampling/extend combinations use the same original checkerboard pixels.
effect fn projectiveImages() -> Canvas
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let mut c = run Canvas.make()
  let mut image = run Pixmap.make(8, 8)
  let data = image.dataMut()
  let mut i: usize = 0
  while i < 64 {
    let light = (i / 8 + i % 8) % 2 == 0
    data[i * 4] = if light {
      220
    } else {
      20
    }
    data[i * 4 + 1] = if light {
      60
    } else {
      160
    }
    data[i * 4 + 2] = if light {
      20
    } else {
      210
    }
    data[i * 4 + 3] = 230
    i = i + 1
  }
  let mut panel: u32 = 0
  while panel < 4 {
    let x = u32.toF64(panel % 2) * 64.0
    let y = u32.toF64(panel / 2) * 48.0
    let h = Homography {
      xx: 4.3 + x * 0.025,
      xy: 0.7 - x * 0.012,
      xw: x + 8.3,
      yx: 0.3 + y * 0.025,
      yy: 4.8 - y * 0.012,
      yw: y + 6.7,
      wx: 0.025,
      wy: -0.012,
      ww: 1.0,
    }
    let pattern = run ImagePattern.makeProjective(
      &image,
      &h,
      if panel % 2 == 0 {
        SAMPLE_NEAREST
      } else {
        SAMPLE_BILINEAR
      },
      if panel / 2 == 0 {
        EXTEND_CLAMP
      } else {
        EXTEND_REPEAT
      },
    )

    // Keep these nonbinary coefficients and the complete zero-tolerance image
    // comparison: pixel (125,88) exposed a Metal multiply/add contraction that
    // moved the blue bilinear result across a rounding boundary. Projective
    // sampling now specifies the same nested FMAs on both CPU and GPU.
    let mut box = Path.make()
    run box.rect(Rect.make(x + 2.0, y + 2.0, 60.0, 44.0))
    run c.raster.fill(&box, &Affine.identity(), NONZERO, &mut c.coverage)
    painting.fill(&mut c.cpu, &c.coverage, &pattern, 235)
    run c.scene.fillImage(&c.coverage, &pattern, 235)

    // A solid following a 19-word record exercises mixed-stride word offsets.
    let mut mark = Path.make()
    run mark.rect(Rect.make(x + 3.0, y + 3.0, 2.0, 2.0))
    run c.fill(&mark, &Affine.identity(), NONZERO, Rgba8.make(40, 80, 120, 255), 255)
    panel = panel + 1
  }
  return move c
}

/// Linear and two-circle radial paints, each spread mode and both interpolation
/// contracts, with perspective in both coordinates. Uses the existing tolerance.
effect fn projectiveGradients() -> Canvas
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let mut c = run Canvas.make()
  let stops = [
    Stop { offset: 0.0, color: Rgba8.make(230, 40, 60, 100) },
    Stop { offset: 0.45, color: Rgba8.make(40, 190, 70, 220) },
    Stop { offset: 1.0, color: Rgba8.make(20, 60, 230, 255) },
  ]
  let mut panel: u32 = 0
  while panel < 6 {
    let x = u32.toF64(panel % 3) * 42.0
    let y = u32.toF64(panel / 3) * 48.0
    let h = Homography {
      xx: 2.7 + x * 0.018,
      xy: 0.3 + x * 0.009,
      xw: x + 3.7,
      yx: -0.2 + y * 0.018,
      yy: 3.1 + y * 0.009,
      yw: y + 5.3,
      wx: 0.018,
      wy: 0.009,
      ww: 1.0,
    }
    let mode = u32.toU8(panel % 3)
    let mut gradient = if panel < 3 {
      run Gradient.linearProjective(0.0, 0.0, 9.0, 4.0, mode, &h)
    } else {
      run Gradient.radialProjective(6.0, 5.0, 7.0, 4.0, 3.0, 1.0, mode, &h)
    }
    gradient.setPremultipliedInterpolation(panel % 2 != 0)
    run gradient.setStops(&stops)
    let mut box = Path.make()
    run box.rect(Rect.make(x + 1.0, y + 1.0, 40.0, 46.0))
    run c.fillGradient(&box, &Affine.identity(), &gradient, 240)
    panel = panel + 1
  }
  return move c
}

fn extent(width: u32, height: u32) -> Extent3D {
  let mut size = Extent3D.default()
  size.setWidth(width)
  size.setHeight(height)
  size.setDepthOrArrayLayers(1)
  return size
}

effect fn renderOnGpu(
  device: &Device,
  queue: &Queue,
  renderer: &mut SceneRenderer,
  scene: &Scene,
) -> List<u8>
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let mut descriptor = TextureDescriptor.default().withLabel(b"scene target")
  descriptor.setSize(extent(WIDTH, HEIGHT))
  descriptor.setFormat(FORMAT)
  descriptor.setDimension(flags.WGPUTextureDimension_2D)
  descriptor.setMipLevelCount(1)
  descriptor.setSampleCount(1)
  descriptor.setUsage(flags.WGPUTextureUsage_RenderAttachment | flags.WGPUTextureUsage_CopySrc)
  let texture = run gpu.createTexture(device, &descriptor)
  let view = run texture.createView(&TextureViewDescriptor.default())
  run renderer.render(device, queue, scene, &view, background())
  let size = u32.toUsize(WIDTH * HEIGHT * 4)
  let readback = run gpu.createBuffer(
    device,
    &BufferDescriptor.make(
      b"scene readback",
      usize.toU64(size),
      flags.WGPUBufferUsage_CopyDst | flags.WGPUBufferUsage_MapRead,
      false,
    ),
  )
  let mut encoder = run gpu.createCommandEncoder(device, b"scene readback")
  let source = TexelCopyTextureInfo.default().withTexture(&texture)
  let mut layout: TexelCopyBufferLayout = TexelCopyBufferLayout.default()
  layout.setBytesPerRow(WIDTH * 4)
  layout.setRowsPerImage(HEIGHT)
  let mut destination = TexelCopyBufferInfo.default().withBuffer(&readback)
  destination.setLayout(layout)
  encoder.copyTextureToBuffer(&source, &destination, &extent(WIDTH, HEIGHT))
  drop destination
  drop source
  let commands = run encoder.finish(b"scene readback")
  queue.submit(&[commands.reference()])
  run device.checkErrors()
  return run runtime.mapRead(device, &readback, 0, size)
}

/// Prints the comparison and returns whether it is within `tolerance` per channel.
fn compare(name: string<'static>, cpu: &[u8], gpu: &[u8], tolerance: i32) -> bool {
  if cpu.length != gpu.length {
    StderrWriter.print("{}: size mismatch\n", &(name,))
    return false
  }
  let mut differing: u32 = 0
  let mut worst: i32 = 0
  let mut i: usize = 0
  while i < cpu.length {
    let d = u8.toI32(cpu[i]) - u8.toI32(gpu[i])
    let a = if d < 0 {
      0 - d
    } else {
      d
    }
    if a != 0 {
      differing = differing + 1
    }
    if a > worst {
      worst = a
    }
    i = i + 1
  }
  StderrWriter.print(
    "{}: {} of {} channels differ; max channel delta {}\n",
    &(name, differing, usize.toU32(cpu.length), worst),
  )
  return worst <= tolerance
}

/// Guards against a vacuous pass: the scene must have painted many pixels.
fn painted(name: string<'static>, cpu: &[u8], minimum: u32) -> bool {
  let b = background().premultiply()
  let mut count: u32 = 0
  let mut i: usize = 0
  while i < cpu.length {
    if cpu[i] != b.r || cpu[i + 1] != b.g || cpu[i + 2] != b.b {
      count = count + 1
    }
    i = i + 4
  }
  if count < minimum {
    StderrWriter.print("{}: only {} pixels painted\n", &(name, count))
  }
  return count >= minimum
}

/// A transparent canvas with overlapping translucent shapes, the source graphic for filters.
effect fn filterSource(dx: f64, color: Rgba8) -> Pixmap
  ! OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let mut p = run Pixmap.make(WIDTH, HEIGHT)
  p.clear(Rgba8.make(0, 0, 0, 0))
  let mut raster = Rasterizer.make()
  let mut coverage = Coverage.make(WIDTH, HEIGHT)
  let id = Affine.identity()
  let s = run star(44.0 + dx, 46.0, 36.0, 15.0)
  run raster.fill(&s, &id, NONZERO, &mut coverage)
  painting.fill(&mut p, &coverage, &Solid.make(color), 220)
  let mut circle = Path.make()
  run circle.circle(80.0 - dx, 52.0, 30.0)
  run raster.fill(&circle, &id, NONZERO, &mut coverage)
  painting.fill(&mut p, &coverage, &Solid.make(Rgba8.make(30, 150, 210, 140)), 255)
  let mut rect = Path.make()
  run rect.rect(Rect.make(4.5, 70.25, 120.0, 14.0))
  run raster.fill(&rect, &id, NONZERO, &mut coverage)
  painting.fill(&mut p, &coverage, &Solid.make(Rgba8.make(250, 200, 40, 255)), 255)
  return move p
}

effect fn readImage(device: &Device, queue: &Queue, image: &FilterImage) -> List<u8>
  ! GpuError | OutOfMemoryError
  ? &mut Allocator {
  let size = u32.toUsize(WIDTH * HEIGHT * 4)
  let readback = run gpu.createBuffer(
    device,
    &BufferDescriptor.make(
      b"filter readback",
      usize.toU64(size),
      flags.WGPUBufferUsage_CopyDst | flags.WGPUBufferUsage_MapRead,
      false,
    ),
  )
  let mut encoder = run gpu.createCommandEncoder(device, b"filter readback")
  let source = TexelCopyTextureInfo.default().withTexture(&image.texture)
  let mut layout: TexelCopyBufferLayout = TexelCopyBufferLayout.default()
  layout.setBytesPerRow(WIDTH * 4)
  layout.setRowsPerImage(HEIGHT)
  let mut destination = TexelCopyBufferInfo.default().withBuffer(&readback)
  destination.setLayout(layout)
  encoder.copyTextureToBuffer(&source, &destination, &extent(WIDTH, HEIGHT))
  drop destination
  drop source
  let commands = run encoder.finish(b"filter readback")
  queue.submit(&[commands.reference()])
  run device.checkErrors()
  return run runtime.mapRead(device, &readback, 0, size)
}

effect fn submit(queue: &Queue, encoder: CommandEncoder, filters: &mut FilterRenderer) -> () ! GpuError {
  let commands = run encoder.finish(b"filter test")
  queue.submit(&[commands.reference()])
  filters.reset()
}

/// Compares every primitive of vector.filter with gpu_scene.filter on the same inputs.
effect fn filters(device: &Device, queue: &Queue) -> bool
  ! GpuError | OutOfMemoryError | GeometryError
  ? &mut Allocator {
  let mut f = run FilterRenderer.make(device, queue)
  let a = run filterSource(0.0, Rgba8.make(220, 60, 30, 255))
  let b = run filterSource(10.0, Rgba8.make(90, 20, 160, 255))
  let gpuA = run FilterImage.make(device, WIDTH, HEIGHT)
  gpuA.write(queue, &a)
  let gpuB = run FilterImage.make(device, WIDTH, HEIGHT)
  gpuB.write(queue, &b)
  let gpuOut = run FilterImage.make(device, WIDTH, HEIGHT)
  let spare = run FilterImage.make(device, WIDTH, HEIGHT)
  let scratch = run FilterImage.make(device, WIDTH, HEIGHT)
  let mut out = run Pixmap.make(WIDTH, HEIGHT)
  let region = Region.make(9, 7, 117, 90)
  let mut ok = painted("filter source", a.data(), 5000)

  filtering.flood(&mut out, Rgba8.make(30, 140, 220, 200), 180, region)
  let mut encoder = run gpu.createCommandEncoder(device, b"filter test")
  run f.flood(device, queue, &mut encoder, &gpuOut, Rgba8.make(30, 140, 220, 200), 180, region)
  run submit(queue, move encoder, &mut f)
  let flooded = run readImage(device, queue, &gpuOut)
  ok = compare("feFlood", out.data(), flooded.asSlice(), 0) && ok

  filtering.offset(&mut out, &a, 5, -3, region)
  encoder = run gpu.createCommandEncoder(device, b"filter test")
  run f.offset(device, queue, &mut encoder, &gpuOut, &gpuA, 5, -3, region)
  run submit(queue, move encoder, &mut f)
  let moved = run readImage(device, queue, &gpuOut)
  ok = compare("feOffset", out.data(), moved.asSlice(), 0) && ok

  filtering.copy(&mut out, &b, region)
  filtering.mergeOver(&mut out, &a, region)
  encoder = run gpu.createCommandEncoder(device, b"filter test")
  run f.copy(device, queue, &mut encoder, &spare, &gpuB, region)
  run f.mergeOver(device, queue, &mut encoder, &gpuOut, &spare, &gpuA, region)
  run submit(queue, move encoder, &mut f)
  let merged = run readImage(device, queue, &gpuOut)
  ok = compare("feMerge", out.data(), merged.asSlice(), 0) && ok

  let k: [f32; 4] = [0.5, 0.7, 0.3, -0.1]
  let mut operator: u8 = 0
  while operator <= filtering.COMPOSITE_ARITHMETIC {
    filtering.composite(&mut out, &a, &b, operator, k, region)
    encoder = run gpu.createCommandEncoder(device, b"filter test")
    run f.composite(device, queue, &mut encoder, &gpuOut, &gpuA, &gpuB, operator, k, region)
    run submit(queue, move encoder, &mut f)
    let composited = run readImage(device, queue, &gpuOut)

    // Arithmetic runs in f32 on both sides; allow one level.
    ok = compare(
      "feComposite",
      out.data(),
      composited.asSlice(),
      if operator == filtering.COMPOSITE_ARITHMETIC {
        1
      } else {
        0
      },
    )
      && ok
    operator = operator + 1
  }

  let mut mode: u8 = 0
  while mode < 15 {
    filtering.blend(&mut out, &a, &b, mode, region)
    encoder = run gpu.createCommandEncoder(device, b"filter test")
    run f.blend(device, queue, &mut encoder, &gpuOut, &gpuA, &gpuB, mode, region)
    run submit(queue, move encoder, &mut f)
    let blended = run readImage(device, queue, &gpuOut)
    ok = compare(
      "feBlend",
      out.data(),
      blended.asSlice(),
      if mode == 0 {
        0
      } else {
        1
      },
    )
      && ok
    mode = mode + 1
  }

  let saturate: [f32; 1] = [0.3]
  let hue: [f32; 1] = [90.0]
  let none: [f32; 0] = []
  let custom: [f32; 20] = [
    0.2,
    0.7,
    0.1,
    0.0,
    0.05,
    0.9,
    0.0,
    0.3,
    0.0,
    0.0,
    0.0,
    0.4,
    0.6,
    0.1,
    -0.05,
    0.0,
    0.0,
    0.0,
    0.8,
    0.1,
  ]
  let mut kind: u8 = 0
  while kind < 4 {
    let m = if kind == SATURATE {
      colorMatrixOf(kind, &saturate)
    } else if kind == HUE_ROTATE {
      colorMatrixOf(kind, &hue)
    } else if kind == MATRIX {
      colorMatrixOf(kind, &custom)
    } else {
      colorMatrixOf(kind, &none)
    }
    filtering.colorMatrix(&mut out, &a, m, region)
    encoder = run gpu.createCommandEncoder(device, b"filter test")
    run f.colorMatrix(device, queue, &mut encoder, &gpuOut, &gpuA, m, region)
    run submit(queue, move encoder, &mut f)
    let matrixed = run readImage(device, queue, &gpuOut)
    ok = compare("feColorMatrix", out.data(), matrixed.asSlice(), 1) && ok
    kind = kind + 1
  }

  let sigmas: [f64; 8] = [3.0, 3.0, 1.0, 1.0, 0.5, 4.5, 2.5, 0.0]
  let mut s: usize = 0
  while s < 8 {
    let horizontal = run BlurPlan.make(sigmas[s])
    let vertical = run BlurPlan.make(sigmas[s + 1])
    run filtering.gaussianBlur(&mut out, &a, &horizontal, &vertical, region)
    encoder = run gpu.createCommandEncoder(device, b"filter test")
    run f.gaussianBlur(device, queue, &mut encoder, &gpuOut, &gpuA, &scratch, &horizontal, &vertical, region)
    run submit(queue, move encoder, &mut f)
    let blurred = run readImage(device, queue, &gpuOut)
    ok = compare("feGaussianBlur", out.data(), blurred.asSlice(), 0) && ok
    s = s + 2
  }

  let radii: [u32; 6] = [1, 1, 3, 0, 2, 5]
  let mut q: usize = 0
  while q < 6 {
    let operator = if q == 2 {
      MORPHOLOGY_DILATE
    } else if q == 4 {
      MORPHOLOGY_DILATE
    } else {
      MORPHOLOGY_ERODE
    }
    run filtering.morphology(&mut out, &a, operator, radii[q], radii[q + 1], region)
    encoder = run gpu.createCommandEncoder(device, b"filter test")
    run f.morphology(device, queue, &mut encoder, &gpuOut, &gpuA, &scratch, operator, radii[q], radii[q + 1], region)
    run submit(queue, move encoder, &mut f)
    let morphed = run readImage(device, queue, &gpuOut)
    ok = compare("feMorphology", out.data(), morphed.asSlice(), 0) && ok
    q = q + 2
  }

  let mut transfer = ComponentTransfer.identity()
  let values: [f32; 4] = [0.1, 0.9, 0.3, 1.0]
  transfer.r = transferTable(&values)
  transfer.g = transferDiscrete(&values)
  transfer.b = transferGamma(1.2, 0.6, -0.05)
  transfer.a = transferLinear(0.8, 0.1)
  filtering.componentTransfer(&mut out, &a, &transfer, region)
  encoder = run gpu.createCommandEncoder(device, b"filter test")
  run f.componentTransfer(device, queue, &mut encoder, &gpuOut, &gpuA, &transfer, region)
  run submit(queue, move encoder, &mut f)
  let transferred = run readImage(device, queue, &gpuOut)
  ok = compare("feComponentTransfer", out.data(), transferred.asSlice(), 0) && ok

  filtering.tile(&mut out, &a, Region.make(30, 20, 61, 47), region)
  encoder = run gpu.createCommandEncoder(device, b"filter test")
  run f.tile(device, queue, &mut encoder, &gpuOut, &gpuA, Region.make(30, 20, 61, 47), region)
  run submit(queue, move encoder, &mut f)
  let tiled = run readImage(device, queue, &gpuOut)
  ok = compare("feTile", out.data(), tiled.asSlice(), 0) && ok

  let sharpen: [f32; 9] = [0.0, -1.0, 0.0, -1.0, 5.0, -1.0, 0.0, -1.0, 0.0]
  let emboss: [f32; 6] = [-2.0, -1.0, 0.0, -1.0, 1.0, 1.5]
  let mut e: u8 = 0
  while e < 3 {
    let first = Convolution {
      kernel: &sharpen,
      orderX: 3,
      orderY: 3,
      divisor: 1.0,
      bias: 0.0,
      targetX: 1,
      targetY: 1,
      edgeMode: e,
      preserveAlpha: false,
    }
    run filtering.convolveMatrix(&mut out, &a, &first, region)
    encoder = run gpu.createCommandEncoder(device, b"filter test")
    run f.convolveMatrix(device, queue, &mut encoder, &gpuOut, &gpuA, &first, region)
    run submit(queue, move encoder, &mut f)
    let sharpened = run readImage(device, queue, &gpuOut)
    ok = compare("feConvolveMatrix", out.data(), sharpened.asSlice(), 1) && ok
    let second = Convolution {
      kernel: &emboss,
      orderX: 3,
      orderY: 2,
      divisor: 0.7,
      bias: 0.25,
      targetX: 2,
      targetY: 0,
      edgeMode: e,
      preserveAlpha: e == EDGE_WRAP,
    }
    run filtering.convolveMatrix(&mut out, &a, &second, region)
    encoder = run gpu.createCommandEncoder(device, b"filter test")
    run f.convolveMatrix(device, queue, &mut encoder, &gpuOut, &gpuA, &second, region)
    run submit(queue, move encoder, &mut f)
    let embossed = run readImage(device, queue, &gpuOut)
    ok = compare("feConvolveMatrix", out.data(), embossed.asSlice(), 1) && ok
    e = e + 1
  }

  let displacement = displacementTable(23.5)
  filtering.displacementMap(&mut out, &a, &b, &displacement, CHANNEL_R, CHANNEL_G, region)
  encoder = run gpu.createCommandEncoder(device, b"filter test")
  run f.displacementMap(device, queue, &mut encoder, &gpuOut, &gpuA, &gpuB, &displacement, CHANNEL_R, CHANNEL_G, region)
  run submit(queue, move encoder, &mut f)
  let displaced = run readImage(device, queue, &gpuOut)
  ok = compare("feDisplacementMap", out.data(), displaced.asSlice(), 0) && ok
  filtering.displacementMap(&mut out, &b, &a, &displacement, CHANNEL_A, CHANNEL_R, region)
  encoder = run gpu.createCommandEncoder(device, b"filter test")
  run f.displacementMap(device, queue, &mut encoder, &gpuOut, &gpuB, &gpuA, &displacement, CHANNEL_A, CHANNEL_R, region)
  run submit(queue, move encoder, &mut f)
  let displacedAlpha = run readImage(device, queue, &gpuOut)
  ok = compare("feDisplacementMap", out.data(), displacedAlpha.asSlice(), 0) && ok

  let noise = run Turbulence.make(7.0)
  let toUser = Affine.scale(1.25, 1.25).then(&Affine.translate(-3.0, 2.0))
  let turbulent = TurbulenceSettings {
    baseFrequencyX: 0.04,
    baseFrequencyY: 0.06,
    octaves: 3,
    fractalNoise: false,
    stitchTiles: false,
    tileX: 0.0,
    tileY: 0.0,
    tileWidth: 0.0,
    tileHeight: 0.0,
  }
  let fractal = TurbulenceSettings {
    baseFrequencyX: 0.05,
    baseFrequencyY: 0.05,
    octaves: 4,
    fractalNoise: true,
    stitchTiles: true,
    tileX: 9.0,
    tileY: 7.0,
    tileWidth: 108.0,
    tileHeight: 83.0,
  }
  let mut t: u32 = 0
  while t < 2 {
    let settings = if t == 0 {
      turbulent
    } else {
      fractal
    }
    filtering.turbulence(&mut out, &noise, &settings, &toUser, region)
    encoder = run gpu.createCommandEncoder(device, b"filter test")
    run f.turbulence(device, queue, &mut encoder, &gpuOut, &noise, &settings, &toUser, region)
    run submit(queue, move encoder, &mut f)
    let noisy = run readImage(device, queue, &gpuOut)

    // f32 on the GPU against the spec's f64 reference.
    ok = compare("feTurbulence", out.data(), noisy.asSlice(), 1) && ok
    t = t + 1
  }

  let mut spot = Light {
    kind: LIGHT_SPOT,
    azimuth: 0.0,
    elevation: 0.0,
    x: 30.0,
    y: 10.0,
    z: 60.0,
    pointsAtX: 70.0,
    pointsAtY: 60.0,
    pointsAtZ: 0.0,
    specularExponent: 3.0,
    limitingConeAngle: 35.0,
  }
  let mut l: u32 = 0
  while l < 6 {
    if l == 0 || l == 3 {
      spot.kind = LIGHT_DISTANT
      spot.azimuth = 225.0
      spot.elevation = 40.0
    } else if l == 1 || l == 4 {
      spot.kind = LIGHT_POINT
    } else {
      spot.kind = LIGHT_SPOT
    }
    let lit = Lighting {
      specular: l >= 3,
      surfaceScale: 4.0,
      constant: if l >= 3 {
        1.3
      } else {
        0.9
      },
      exponent: 12.0,
      color: Rgba8.make(255, 230, 180, 255),
      light: spot,
    }
    filtering.lighting(&mut out, &a, &lit, region)
    encoder = run gpu.createCommandEncoder(device, b"filter test")
    run f.lighting(device, queue, &mut encoder, &gpuOut, &gpuA, &lit, region)
    run submit(queue, move encoder, &mut f)
    let shaded = run readImage(device, queue, &gpuOut)
    ok = compare(
      if l >= 3 {
        "feSpecularLighting"
      } else {
        "feDiffuseLighting"
      },
      out.data(),
      shaded.asSlice(),
      1,
    )
      && ok
    l = l + 1
  }

  filtering.copy(&mut out, &a, Region.of(&a))
  filtering.toLinear(&mut out)
  encoder = run gpu.createCommandEncoder(device, b"filter test")
  run f.toLinear(device, queue, &mut encoder, &gpuOut, &gpuA)
  run submit(queue, move encoder, &mut f)
  let linear = run readImage(device, queue, &gpuOut)
  ok = compare("toLinear", out.data(), linear.asSlice(), 0) && ok
  filtering.toSrgb(&mut out)
  encoder = run gpu.createCommandEncoder(device, b"filter test")
  run f.toSrgb(device, queue, &mut encoder, &spare, &gpuOut)
  run submit(queue, move encoder, &mut f)
  let srgb = run readImage(device, queue, &spare)
  ok = compare("toSrgb", out.data(), srgb.asSlice(), 0) && ok
  return ok
}

effect fn program() -> i32
  ! GpuError | OutOfMemoryError | GeometryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let instance = run Instance.create()
  let adapter = run instance.requestAdapter(&RequestAdapterOptions.default())
  let device = run adapter.requestDevice(
    &DeviceDescriptor.default().withRequiredFeatures(SceneRenderer.requiredFeatures(&adapter)),
  )
  let queue = run gpu.getQueue(&device)
  let mut renderer = run SceneRenderer.make(&device)
  let solid = run solids() |> Effect.provideMut<Allocator>(&mut allocator)
  let solidGpu = run renderOnGpu(&device, &queue, &mut renderer, &solid.scene)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let gradient = run gradients() |> Effect.provideMut<Allocator>(&mut allocator)
  let gradientGpu = run renderOnGpu(&device, &queue, &mut renderer, &gradient.scene)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let solidOk = compare("solids", solid.cpu.data(), solidGpu.asSlice(), 0)
  let gradientOk = compare("gradients", gradient.cpu.data(), gradientGpu.asSlice(), 2)
  let layered = run layers() |> Effect.provideMut<Allocator>(&mut allocator)
  let layeredGpu = run renderOnGpu(&device, &queue, &mut renderer, &layered.scene)
    |> Effect.provideMut<Allocator>(&mut allocator)

  // Non-separable and other non-normal modes run in f32 on both sides; allow one level.
  let layersOk = compare("layers", layered.cpu.data(), layeredGpu.asSlice(), 1)
  let imaged = run images() |> Effect.provideMut<Allocator>(&mut allocator)
  let imagedGpu = run renderOnGpu(&device, &queue, &mut renderer, &imaged.scene)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let imagesOk = compare("images", imaged.cpu.data(), imagedGpu.asSlice(), 0)
  let boundary = imaged.cpu.pixel(21, 4)
  let imageBoundaryOk = boundary.r == 36 && boundary.g == 0 && boundary.b == 225
    && boundary.a == 255
  if !imageBoundaryOk {
    StderrWriter.print("images: nearest boundary fixture changed texel\n", &())
  }
  let perspectiveImage = run projectiveImages() |> Effect.provideMut<Allocator>(&mut allocator)
  let perspectiveImageGpu = run renderOnGpu(&device, &queue, &mut renderer, &perspectiveImage.scene)
    |> Effect.provideMut<Allocator>(&mut allocator)
  // WGSL only bounds `x / y` to 2.5 ULP (Vulkan's precision too), so the perspective divide can
  // move a bilinear weight across a rounding step; allow one level, as for gradients.
  let perspectiveImagesOk = compare(
    "projective images",
    perspectiveImage.cpu.data(),
    perspectiveImageGpu.asSlice(),
    1,
  )
    && painted("projective images", perspectiveImage.cpu.data(), 9000)
  let perspectiveGradient = run projectiveGradients()
    |> Effect.provideMut<Allocator>(&mut allocator)
  let perspectiveGradientGpu = run renderOnGpu(
    &device,
    &queue,
    &mut renderer,
    &perspectiveGradient.scene,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let perspectiveGradientsOk = compare(
    "projective gradients",
    perspectiveGradient.cpu.data(),
    perspectiveGradientGpu.asSlice(),
    2,
  )
    && painted("projective gradients", perspectiveGradient.cpu.data(), 9000)
  let radial = run radialLimits() |> Effect.provideMut<Allocator>(&mut allocator)
  let radialGpu = run renderOnGpu(&device, &queue, &mut renderer, &radial.scene)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let radialOk = compare("radial limits", radial.cpu.data(), radialGpu.asSlice(), 0)
    && radial.cpu.pixel(33, 1).b == 255
    && radial.cpu.pixel(75, 1).r == 64
    && radial.cpu.pixel(75, 1).b == 191
    && radial.cpu.pixel(117, 1).r == 64
    && radial.cpu.pixel(117, 1).b == 191
    && radial.cpu.pixel(62, 72).b == 255
    && radial.cpu.pixel(43, 49).r == 255
    && radial.cpu.pixel(100, 72).g == 255
    && radial.cpu.pixel(20, 72).r == background().r

  // The renderer keeps its layer textures; a second render must not see the first one's pixels.
  let againGpu = run renderOnGpu(&device, &queue, &mut renderer, &layered.scene)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let againOk = compare("layers again", layered.cpu.data(), againGpu.asSlice(), 1)
  let drawn = painted("solids", solid.cpu.data(), 4000)
    && painted("gradients", gradient.cpu.data(), 8000)
    && painted("layers", layered.cpu.data(), 9000)
    && painted("images", imaged.cpu.data(), 6000)
  let filtersOk = run filters(&device, &queue) |> Effect.provideMut<Allocator>(&mut allocator)
  return if solidOk && gradientOk && layersOk && imagesOk && imageBoundaryOk && againOk && drawn
    && filtersOk
    && perspectiveImagesOk
    && perspectiveGradientsOk
    && radialOk {
    0
  } else {
    1
  }
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  StderrWriter.print("scene test failed with a GPU, allocation, or geometry error\n", &())
  return 2
}

effect fn gpuFailed(error: GpuError) -> i32
  ! never {
  StderrWriter.print(
    "scene test failed with GPU error {}: {:?}\n",
    &(error.code, error.message.asSlice()),
  )
  return 2
}

pub fn main() -> i32 {
  return run Effect.catchAll(Effect.catch<GpuError>(program(), gpuFailed), failed)
}
